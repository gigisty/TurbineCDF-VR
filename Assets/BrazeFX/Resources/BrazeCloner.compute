uint _BucketCount;
uint _DrawCount;
uint _SourceCount;
uint _SourceCapacity;
uint _SourceOrder;
uint _Distribution;
uint _Seed;
uint _Center;
uint _RadialBaseCount;
uint _RadialRingCount;
uint _RadialCountStep;
uint _RadialPlane;
uint _RadialCenterAxis;
uint _Alignment;
uint _AlignmentAxis;
uint _AlignmentUp;
uint _Orthographic;
uint _EffectorIndex;
uint _EffectorCount;
uint _DispatchThreadsX;
uint _PushGridSize;
uint _PushGridMask;
uint _PushUseCloneBounds;
uint _ComposedCount;
uint _ComposedChildCount;
uint _ComposedParentSource;
uint _ComposedBucketBase;
uint _ComposedCapacity;
uint _ComposedVisibleOffset;
uint _NestedSourceCount;
uint _NestedSourceOrder;
uint _NestedSeed;
float4 _NestedRootInvRotation;
float3 _NestedRootPosition;
float3 _NestedRootInvScale;
int3 _GridCount;
float3 _GridSpacing;
float3 _LinearOffset;
float3 _LinearRotation;
float3 _LinearScale;
float4x4 _MeshLocalToCloner;
float4x4 _MeshNormalToCloner;
float4 _SplineParams; // x offset, y range start, z range end, w closed flag
float3 _SplineUpLocal;
uint _SplineSampleCount;
float _RadialRadius;
float _RadialRadiusStep;
float2 _RadialArc;
float _RadialRingTwist;
float _RadialAxisStep;
float2 _RadialSpiral;
float4 _RadialWave;
float _RadialWaveAxialPhase;
float _RadialWaveRingPhase;
float3 _RadialRotationOffset;
float3 _RadialRotationStep;
float _RadialScaleStep;
float _RadialScaleWave;
float _UniformScale;
float3 _RootPosition;
float4 _RootRotation;
