#pragma kernel BuildClones
#pragma kernel ClearBuckets
#pragma kernel CullAndBucket
#pragma kernel CullAndBucketComposed
#pragma kernel WriteDrawArgs
#pragma kernel ClearPushApartRadius
#pragma kernel MeasurePushApartRadius
#pragma kernel ClearPushApartGrid
#pragma kernel BuildPushApartGrid
#pragma kernel CapturePushApartBakeInput
#pragma kernel ApplyPushApartBake
#pragma kernel PushApart
#pragma kernel StorePushApartBake
#pragma kernel MeasureCloneSpeed

#define THREADS 64
#define MAX_LODS 4
#define MAX_PUSH_CANDIDATES 512

struct CloneSource
{
    float radius;
    uint lodCount;
    float2 padding;
    float4 thresholds;
};

struct MeshSample
{
    float3 position;
    float positionPadding;
    float3 normal;
    float normalPadding;
};

struct IndirectArgs
{
    uint indexCountPerInstance;
    uint instanceCount;
    uint startIndex;
    uint baseVertexIndex;
    uint startInstance;
};

struct GpuFractureEffector
{
    float3 position;       float shape;
    float3 boxHalf;        float radius;
    float4 rotation;
    float3 positionAmount; float strength;
    float3 rotationAmount; float falloffRow;
    float3 scaleAmount;    int auxOffset;
    int functionType;      int mode;
    int seed;              int flags;
    float4 parameters;
    float4 special0;
    float4 special1;
};

RWStructuredBuffer<float4> _BasePosition;
RWStructuredBuffer<float4> _BaseRotation;
RWStructuredBuffer<float4> _BaseScale;
StructuredBuffer<float4> _BasePositionRead;
StructuredBuffer<float4> _BaseScaleRead;
StructuredBuffer<float4> _EffectorPositionRead;
StructuredBuffer<float4> _EffectorScaleRead;
StructuredBuffer<MeshSample> _MeshSamples;
RWStructuredBuffer<float4> _EffectorPositionWrite;
RWStructuredBuffer<float> _AppearanceSpeed;
RWStructuredBuffer<float4> _AppearancePreviousPosition;
RWStructuredBuffer<int> _PushGridHeads;
RWStructuredBuffer<int> _PushGridNext;
RWStructuredBuffer<int4> _PushGridCells;
RWStructuredBuffer<float> _PushRadii;
RWStructuredBuffer<uint> _PushMaxRadius;
StructuredBuffer<float4> _PushBakeRead;
RWStructuredBuffer<float4> _PushBakeWrite;
RWStructuredBuffer<float4> _PushInputPosition;

StructuredBuffer<CloneSource> _Sources;
RWStructuredBuffer<uint> _VisibleIndices;
RWStructuredBuffer<uint> _BucketCounts;
StructuredBuffer<uint> _BucketCountsRead;
StructuredBuffer<uint2> _DrawBuckets;
RWStructuredBuffer<IndirectArgs> _DrawArgs;

// Composed (nested-cloner) culling: the parent transform stream plus the child cloner's live buffers.
StructuredBuffer<float4> _BaseRotationRead;
StructuredBuffer<float4> _EffectorRotationRead;
StructuredBuffer<float4> _NestedBasePosition;
StructuredBuffer<float4> _NestedBaseScale;
StructuredBuffer<float4> _NestedEffectorPosition;
StructuredBuffer<float4> _NestedEffectorScale;
StructuredBuffer<CloneSource> _NestedSources;

StructuredBuffer<GpuFractureEffector> _Effectors;
StructuredBuffer<float> _EffectorFalloff;

