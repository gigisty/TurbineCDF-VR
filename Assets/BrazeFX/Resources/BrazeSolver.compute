SamplerState sampler_linear_clamp;
SamplerState sampler_linear_repeat;   // tiling curl-noise (Render Detail up-res perturbation)

// UAVs.
RWTexture3D<float4> _Fields;
RWTexture3D<float4> _Vel;
// Sparse retirement must clear BOTH sides of each ping-pong pair in the same dispatch. Clearing only the
// current side lets a retired 4³ brick return on the next swap as a visible cube and as stale velocity.
RWTexture3D<float4> _FieldsClearAux;
RWTexture3D<float4> _VelClearAux;
RWTexture3D<float4> _FieldsOut;
RWTexture3D<float4> _VelOut;
RWTexture3D<float4> _Curl;
RWTexture3D<float4> _FlowField;
RWTexture3D<float>  _Div;
RWTexture3D<float>  _Pressure;   // single in-place pressure buffer (Red-Black Gauss-Seidel)
RWTexture3D<float>  _Solid;      // obstacle mask: 1 = solid (blocks flow), 0 = fluid
Texture3D<float> _SolidRO;       // same texture bound read-only where a kernel only tests coverage (advection)
Texture3D<float> _CfdSignedDistance;
float _CfdCellWorldSize;
int3 _SolidDispatchMin;
int3 _SolidDispatchSize;
int _RedBlack;                   // 0 = update red cells, 1 = update black
// CFD multigrid (full-domain pressure V-cycle) — coarse grid is fine res / 2 per axis.
RWTexture3D<float> _CoarsePressure;   // coarse-level error e (solves L_c(e) = restricted residual)
RWTexture3D<float> _CoarseDiv;        // restricted fine residual
RWTexture3D<float> _CoarseSolid;      // coarse fractional coverage (8-cell average of _Solid)
Texture3D<float>  _CoarsePressureRO;  // SRV alias for the trilinear prolongation sample
int3 _CoarseRes;
int3 _CoarseDispatchMin;
int3 _CoarseDispatchSize;
int  _CfdCoarseDirichletFaces;        // per-face bitmask (same layout as _ClosedFaces): outside-face error is
                                      // pinned to 0 (open faces / pressure outlets); other faces mirror (Neumann)
// CFD surface-load reduction window — the body's voxel AABB (+margin), so the per-cadence pressure
// integration visits the body neighbourhood instead of the whole domain.
int3 _CfdLoadMin;
int3 _CfdLoadSize;
// Visualization-only smoothed pressure for the surface overlay (spatial 7-point filter + temporal EMA).
RWTexture3D<float> _PressureVis;
float _PressureVisBlend;   // per-tick EMA weight; 1 on (re)allocation for an instant seed
// Animated (rigid-motion) CFD bodies. Each body owns a mesh-LOCAL SDF baked once; per tick its coverage is
// re-stamped into _Solid through the current transform and its wall velocity is injected into covered cells.
Texture3D<float> _CfdBodySdf;        // scaled-local SDF, world-unit distances
float4x4 _CfdBodyVoxelToUvw;         // domain voxel centre → body bake uvw (all transforms folded on CPU)
float3 _CfdBodyLinVelVox;            // pivot velocity in grid voxels/sec
float3 _CfdBodyAngVelGrid;           // angular velocity about grid axes (rad/s; isotropic voxels assumed)
float3 _CfdBodyPivotVox;             // rotation pivot in voxel coordinates
int _CfdHasStaticSdf;                // 1 = a static domain SDF exists for the restore pass to re-sample

// Sparse occupancy: 1 brick = 4 base voxels. _OccD is the BINARY dilated (haloed) map the heavy
// kernels/readers consume. _Occ is the transient raw map: 1 = scalar content/emission, 0.5 =
// motion-only emitter support, 0 = empty. Keeping the distinction only here costs no extra texture;
// DilateOcc carries it in a spare packed-index bit while publishing the same binary _OccD as before.
RWTexture3D<float> _Occ;
RWTexture3D<float> _OccD;
Texture3D<float4> _RenderPrev;          // previous visual render field (history only; never feeds the sim)
RWTexture3D<float4> _RenderOut;         // smoothed/persistent visual field sampled by the raymarcher
RWTexture3D<float4> _RenderOcc;         // max visibility, max fire, mean visibility, normalized smoke/fire variation
float _RenderVisualFilter;              // 0..1 six-neighbour smoothing weight
float _RenderVisualDecay;               // history decay for sub-cull visual tails
float _RenderHistoryDt;                 // full solver tick used to transport/fade visual history
float _RenderOccDensityGain;            // raw density -> renderer smoke domain
float _RenderOccFireGain;               // raw burn -> saturating renderer fire domain
Texture3D<float2> _FineIn;           // Render Detail fine history (R density, G burn) — sampled by DetailBake
RWTexture3D<float2> _FineOut;        // Render Detail fine field (R density, G burn) — FineSeed/DetailBake write it
RWStructuredBuffer<uint> _ActiveCount;   // [0] active/dilated bricks, [1] raw occupied bricks (diagnostics), [2] retired bricks
RWStructuredBuffer<uint> _ActiveBricks;  // bit 30 = scalar-content halo; low 30 bits = compacted brick index
RWStructuredBuffer<uint> _RetiredBricks; // untagged indices of bricks active LAST step but not this step
RWStructuredBuffer<uint> _IndirectArgs;  // DispatchIndirect args: [0..2] = (activeCount,1,1), [3..5] = (retiredCount,1,1)
RWStructuredBuffer<uint> _BrickDbg;      // DEBUG visualizer: per-brick flags (bit0 = raw, bit1 = active/halo)
RWStructuredBuffer<uint> _FireMoments;   // fire-light source: [0]=Σweight, [1..3]=Σ(weight·uvw), fixed-point ×FIRE_MOMENT_SCALE
RWStructuredBuffer<uint> _CachePack;     // cache bake: flat half-packed field readback (3D-texture readback is broken on some platforms)
Texture3D<float4> _CacheVelIn;           // cache bake: velocity source (so Render Detail's flow/curl survive in the cache)
Texture3D<float4> _CacheWarpIn;          // cache bake: complete native-resolution live Render Detail texture
int _CachePackWarpBricks;       // 0 = base render field, 1 = native-resolution encoded Render Detail texture
int _CachePackBaseVelocity;     // 1 = base bricks store simulation velocity (voxels/sec) in their vector halfs
// Motion-compensated playback interpolation between two STORED frames (frame-skip smoothing).
Texture3D<float4> _CacheBlendKey;    // scattered stored frame k (the playhead's key frame)
Texture3D<float4> _CacheBlendNext;   // scattered stored frame k+1 (bind key again when unavailable, with t = 0)
Texture3D<float4> _CacheBlendVel;    // key frame's velocity (voxels/sec) — drives both warp directions
float _CacheBlendT;                  // playhead position between the two stored frames [0,1]
float _CacheBlendSeconds;            // stored-frame interval (1 / stored fps)
int _CacheVelocityBounds;       // 1 = ALSO retain velocity-only boundary bricks (complete air motion for VDB `vel`
                                // export / particle follow). 0 = lean playback bake: velocity is kept only where the
                                // scalar test already stores the brick — Render Detail reads it nowhere else.
int _CacheOutputOffset;         // combined-stream brick offset (detail bricks follow base bricks)
RWStructuredBuffer<uint> _CacheSparseCount;  // bake: one atomic active-brick count
RWStructuredBuffer<uint> _CacheSparseIdx;    // bake: compact brick indices
RWStructuredBuffer<uint> _CacheSparseBlocks; // bake: compact 3 uint/voxel blocks (six half channels)
float _CacheCull;
// Cache PLAYBACK scatter: sparse active-brick blocks (one half per uint, low 16 bits) → 3D fields on the GPU
// (avoids the per-frame full-volume CPU rebuild + upload that tanked playback FPS).
StructuredBuffer<uint> _ScatterBrickIdx;
StructuredBuffer<uint> _ScatterBase;
RWTexture3D<float4> _ScatterWarp;         // playback: native final-look detail, or a compatibility flow/legacy warp
RWTexture3D<float4> _ScatterVelocity;     // playback: authoritative BASE-brick velocity (voxels/sec)
int _ScatterBrickCount;   // bricks in THIS frame
int _ScatterBrickOffset;  // first brick of this frame in the resident (all-frames) buffers
int3 _BrickGrid;          // occupancy brick-grid dims (ceil(res/brick))
int3 _WarpBrickGrid;      // native Render Detail brick-grid dims
int3 _ScatterWarpRes;     // native Render Detail texture resolution
int _ScatterBrickSize;    // voxels per brick edge
int _ScatterWarpQuant;    // 1 = displacement is 8-bit signed + per-brick scale (WarpQuant resident layout)
int _ScatterScalarQuant;  // 1 = density/temp/burn are 8-bit quantized + per-channel per-brick scale (dequant here)
int _ScatterHasWarp;      // 0 = scalars-only resident layout; 1 = xyz vector channels are stored
int _ScatterHasVelocity;  // 1 = BASE-brick vectors are raw velocity, not render displacement
int _ScatterDiscardVelocity; // 1 = decode velocity-bearing block layout but deliberately skip the velocity UAV write
int _ScatterWarpRaw;      // 1 = DetailFlow clip: write the channels RAW into the flow anchor (neutral 0), not warp-encoded (neutral 0.5)
int _ScatterSplitWarp;    // v9 final-look layout: high-bit-tagged detail bricks live at _ScatterWarpRes
StructuredBuffer<uint> _ScatterBlockId;   // dedup: per-brick-slot index into the shared block pool (_ScatterBase)
int _ScatterDedup;        // 1 = block bytes are deduplicated; look the brick's block up via _ScatterBlockId
RWStructuredBuffer<uint> _CacheWarpActiveBricks; // previous/current tagged detail-brick list; sentinel for base bricks
RWTexture3D<float4> _ClearF4;            // init-clear target (base float4 fields/vel/curl)
#define BRICK 4
#define BRICK_U 4u
int3 _OccRes;
#define BASE_EMPTY(id) (_OccD[uint3(id) / BRICK_U] < 0.5)

// _Occ is R8 UNorm, so these values stay distinct around the thresholds. _OccD remains strictly 0/1.
// Bit 31 is already the cache format's WarpBrickBit; bit 30 is free because the largest supported
// 512^3 base grid has only 128^3 = 2^21 occupancy bricks.
#define OCC_MOTION_ONLY       0.5
#define OCC_SCALAR_CONTENT    1.0
#define OCC_ACTIVE_THRESHOLD  0.25
#define OCC_SCALAR_THRESHOLD  0.75
#define ACTIVE_SCALAR_BIT     0x40000000u
#define ACTIVE_INDEX_MASK     0x3fffffffu

// ── Grid-space lighting: single-scatter transmittance + multiple-scattering radiance ─────────────────
// Adapted from the publisher-owned three-js-volume GpuSolver light bakes. Instead of pre-baking the full smoke SHADE, we bake two
// low-res SCALAR fields once per frame over the active bricks and let the renderer do the live shading
// (HG phase, ambient, fire-glow-on-smoke, gradient sculpt) sampling them:
//   _IllumField   = single-scatter transmittance toward the key light  (Illumination kernel)
//   _ScatterField = multiple-scattering radiance: seed = illumination, then ping-pong blur (ScatterSeed/Blur)
// The renderer reads raw DENSITY straight from the volume field (no longer carried in the lit alpha).
RWTexture3D<float> _IllumField;
RWTexture3D<float> _ScatterField;    // ping-pong blur destination / final radiance
Texture3D<float>   _ScatterSrc;      // ping-pong blur source (SRV)
RWTexture3D<float> _ClearScalar;     // scalar-field init clear target
RWTexture3D<float2> _ClearScalar2;   // RG fine up-res field init clear target
RWTexture3D<float> _ClearLightScalar; // light-grid scalar clear target
// Pack the three scalar light fields into ONE RGBA volume so the renderer samples once (1 tap) instead of 3.
RWTexture3D<float>  _PackIllum;
RWTexture3D<float>  _PackScatter;
RWTexture3D<float>  _PackFireLight;
RWTexture3D<float4> _LightPacked;    // r = illumination, g = scatter, b = fire-light
float3 _LbLightDir;                  // key light direction in object/local space (normalized)
float  _LbShadowDensity;             // = shadowStrength (deeper self-shadows)
float  _LbLightStepVox;              // shadow-march step length, base voxels (reference 1.4)
int    _LbLightSteps;                // shadow-march steps (reference 28)
#define SHADOW_DENSITY_REF 5.0       // reference fixed self-shadow density (smoke density scale does NOT shadow)
#define SCATTER_ABSORB 0.25          // mild per-pass absorption so radiance penetrates a few cells
// The renderer drives opacity by saturate(density * DENSITY_REMAP) — the light bake MUST use the same
// remapped/bounded density or it over-shadows (Unity's raw core density ~10 ≫ the earlier prototype's ~0.3 range,
// which collapses transmittance + scatter to 0 → black cores). Keeps light-opacity == view-opacity.
#define LB_DENSITY_REMAP 3.0
float LbDensity(float3 uvw) { return saturate(max(_FieldsIn.SampleLevel(sampler_linear_clamp, uvw, 0).x, 0.0) * LB_DENSITY_REMAP); }

bool Oob(uint3 id) { return any(id >= (uint3)_Res); }
int3 ClampC(int3 c) { return clamp(c, int3(0, 0, 0), _Res - 1); }
bool FaceClosed(int bit) { return (_ClosedFaces & bit) != 0; }
bool OutsideRes(int3 c) { return c.x < 0 || c.y < 0 || c.z < 0 || c.x >= _Res.x || c.y >= _Res.y || c.z >= _Res.z; }
bool ClosedOutside(int3 c)
{
    return (c.x < 0       && FaceClosed(1))  || (c.x >= _Res.x && FaceClosed(2)) ||
           (c.y < 0       && FaceClosed(4))  || (c.y >= _Res.y && FaceClosed(8)) ||
           (c.z < 0       && FaceClosed(16)) || (c.z >= _Res.z && FaceClosed(32));
}
bool OpenOutside(int3 c) { return OutsideRes(c) && !ClosedOutside(c); }
int _NoSolids;   // 1 = zero obstacles (and none last step): _Solid is guaranteed all-zero — skip its load.
                 // Saves 6 texture loads per cell per RBGS iteration (+6 each in Divergence/Project) in the
                 // common obstacle-free scene; boundary (closed-face) behaviour is unaffected.
bool SolidAt(int3 c)
{
    bool solid = false;
    if (OutsideRes(c))
    {
        solid = ClosedOutside(c);
    }
    else if (_NoSolids == 0)
    {
        solid = _Solid[c] > 0.5;
    }
    return solid;
}
float PressureAt(int3 c, float centerPressure)
{
    float pressure = 0.0;
    if (!OpenOutside(c))
        pressure = SolidAt(c) ? centerPressure : _Pressure[ClampC(c)];
    return pressure;
}
#define IS_SOLID(c) SolidAt(c)

// ── Fractional CFD boundary helpers ─────────────────────────────────────────────────────────────────────────
// The CFD kernels (and, when _CfdFractionalSolids is set, the shared transport/decay/emission kernels) use the
// FRACTIONAL coverage convention; the legacy Fire kernels continue to use the binary SolidAt path above.
float3 CfdFaceOutward(int face)
{
    float3 result = float3(0.0, 0.0, 1.0);
    if (face == 0) result = float3(-1.0, 0.0, 0.0);
    else if (face == 1) result = float3(1.0, 0.0, 0.0);
    else if (face == 2) result = float3(0.0, -1.0, 0.0);
    else if (face == 3) result = float3(0.0, 1.0, 0.0);
    else if (face == 4) result = float3(0.0, 0.0, -1.0);
    return result;
}

bool CfdBoundaryContainsCell(CfdBoundary boundary, int3 c)
{
    int face = (int)round(boundary.face);
    bool onFace = (face == 0 && c.x == 0) || (face == 1 && c.x == _Res.x - 1) ||
                  (face == 2 && c.y == 0) || (face == 3 && c.y == _Res.y - 1) ||
                  (face == 4 && c.z == 0) || (face == 5 && c.z == _Res.z - 1);
    float2 patchPoint = float2(0.0, 0.0);
    float2 center = float2(0.0, 0.0);
    if (face <= 1)
    {
        patchPoint = float2(c.y, c.z) + 0.5;
        center = boundary.centerVox.yz;
    }
    else if (face <= 3)
    {
        patchPoint = float2(c.x, c.z) + 0.5;
        center = boundary.centerVox.xz;
    }
    else
    {
        patchPoint = float2(c.x, c.y) + 0.5;
        center = boundary.centerVox.xy;
    }
    // Rotate into patch-local space (the cross-section may be spun on its face), then run every shape test
    // in that frame: 0 rectangle, 1 ellipse (Circle = equal axes), 2 ring (hub cutout), 3 slot (stadium).
    float sinR = sin(boundary.rotation);
    float cosR = cos(boundary.rotation);
    float2 delta = patchPoint - center;
    float2 local = float2(cosR * delta.x + sinR * delta.y, cosR * delta.y - sinR * delta.x);
    bool inside = onFace && all(abs(local) <= boundary.halfSizeVox);
    if (inside && boundary.shape >= 0.5)
    {
        int patchShape = (int)round(boundary.shape);
        if (patchShape <= 2)
        {
            float2 normalized = local / max(boundary.halfSizeVox, 0.5);
            float radiusSq = dot(normalized, normalized);
            inside = radiusSq <= 1.0 &&
                     (patchShape < 2 || radiusSq >= boundary.ringInner * boundary.ringInner);
        }
        else
        {
            float2 h = max(boundary.halfSizeVox, 0.5);
            float capRadius = min(h.x, h.y);
            float2 axisExtent = h.x >= h.y ? float2(max(h.x - capRadius, 0.0), 0.0)
                                           : float2(0.0, max(h.y - capRadius, 0.0));
            float2 toCap = local - clamp(local, -axisExtent, axisExtent);
            inside = dot(toCap, toCap) <= capRadius * capRadius;
        }
    }
    return inside;
}

float2 CfdBoundaryNormalizedPatchCoord(CfdBoundary boundary, int3 c)
{
    int face = (int)round(boundary.face);
    float2 patchPoint = face <= 1 ? float2(c.y, c.z) + 0.5
                      : face <= 3 ? float2(c.x, c.z) + 0.5
                                  : float2(c.x, c.y) + 0.5;
    float2 center = face <= 1 ? boundary.centerVox.yz
                  : face <= 3 ? boundary.centerVox.xz
                              : boundary.centerVox.xy;
    // Patch-local (rotated) frame, matching CfdBoundaryContainsCell — dye patterns and inlet turbulence spin
    // with the cross-section.
    float sinR = sin(boundary.rotation);
    float cosR = cos(boundary.rotation);
    float2 delta = patchPoint - center;
    float2 local = float2(cosR * delta.x + sinR * delta.y, cosR * delta.y - sinR * delta.x);
    return local / max(boundary.halfSizeVox, 0.5);
}

void CfdBoundaryTangentAxes(int face, out float3 axisU, out float3 axisV)
{
    if (face <= 1) { axisU = float3(0.0, 1.0, 0.0); axisV = float3(0.0, 0.0, 1.0); }
    else if (face <= 3) { axisU = float3(1.0, 0.0, 0.0); axisV = float3(0.0, 0.0, 1.0); }
    else { axisU = float3(1.0, 0.0, 0.0); axisV = float3(0.0, 1.0, 0.0); }
}

// A time-evolving streamfunction on the inlet plane. Taking its perpendicular gradient produces tangential
// velocity fluctuations with zero 2D divergence and zero mean normal-flow change. This is a synthetic turbulent
// inlet condition, not the smoke-gated artistic CurlNoise force used by Fire.
float3 CfdInletFluctuation(CfdBoundary boundary, int3 c, out float dyeVariation)
{
    float2 uv01 = CfdBoundaryNormalizedPatchCoord(boundary, c) * 0.5 + 0.5;
    float2 cycles = clamp(round((boundary.halfSizeVox * 2.0) /
                                      max(_CfdTurbulenceLengthVox, 1.0)), 1.0, 12.0);
    float phase = _Time * _CfdTurbulenceFrequency * 6.2831853;
    float2 angle = uv01 * cycles * 6.2831853 + float2(phase, -phase * 0.73);
    float cycleNorm = max(max(cycles.x, cycles.y), 1.0);
    float2 fluctuation = float2(cycles.y * sin(angle.x) * cos(angle.y),
                                -cycles.x * cos(angle.x) * sin(angle.y)) / cycleNorm;

    float2 cycles2 = min(cycles * 2.0, 18.0);
    float2 angle2 = uv01 * cycles2 * 6.2831853 + float2(-phase * 1.31 + 1.7,
                                                        phase * 0.91 + 4.2);
    float cycleNorm2 = max(max(cycles2.x, cycles2.y), 1.0);
    fluctuation += float2(cycles2.y * sin(angle2.x) * cos(angle2.y),
                          -cycles2.x * cos(angle2.x) * sin(angle2.y)) / cycleNorm2 * 0.32;
    fluctuation = clamp(fluctuation * 0.72, -1.0, 1.0);

    // Never collapse the volume into isolated ribbons: this is a continuously filled dye field with evolving
    // concentration structure for the turbulent velocity to fold into visible eddies.
    float scalarNoise = sin(angle.x + angle.y * 0.61) * 0.65 +
                        sin(angle2.x * 0.73 - angle2.y) * 0.35;
    dyeVariation = lerp(0.28, 1.0, saturate(scalarNoise * 0.5 + 0.5));

    float3 axisU, axisV;
    CfdBoundaryTangentAxes((int)round(boundary.face), axisU, axisV);
    return axisU * fluctuation.x + axisV * fluctuation.y;
}

float CfdSmokePatternMask(CfdBoundary boundary, int3 c, float dyeVariation)
{
    float mask = 1.0;
    if (boundary.inletSmokePattern >= 0.5)
    {
        float2 uv = CfdBoundaryNormalizedPatchCoord(boundary, c);
        if (boundary.inletSmokePattern < 1.5)
        {
            // A softly reconstructed sheet remains continuous at modest grid resolutions instead of becoming a
            // one-voxel hard band that breaks into cards under advection.
            mask = 1.0 - smoothstep(0.04, 0.14, abs(uv.y));
        }
        else if (boundary.inletSmokePattern < 2.5)
        {
            // Fifteen round, soft-edged rake tubes are easier to read than the previous 35 hard square threads.
            // Their 2–4 voxel footprint survives trilinear advection without turning into detached beads.
            float2 lattice = float2(5.0, 3.0);
            float2 threadUv = frac((uv * 0.5 + 0.5) * lattice) - 0.5;
            mask = 1.0 - smoothstep(0.14, 0.27, length(threadUv));
        }
        else if (boundary.inletSmokePattern < 3.5) mask = dyeVariation;
        // Body Contact (4): the inlet admits CLEAR air — the writing below then flushes transported dye at the
        // face — and CfdSeedContactDye releases dye at the body surface instead.
        else mask = 0.0;
    }
    return mask;
}

int CfdBoundaryIndexForOutside(int3 outsideCell)
{
    int face = -1;
    if (outsideCell.x < 0) face = 0;
    else if (outsideCell.x >= _Res.x) face = 1;
    else if (outsideCell.y < 0) face = 2;
    else if (outsideCell.y >= _Res.y) face = 3;
    else if (outsideCell.z < 0) face = 4;
    else if (outsideCell.z >= _Res.z) face = 5;
    int3 boundaryCell = ClampC(outsideCell);
    int result = -1;
    [loop] for (int i = 0; i < _CfdBoundaryCount; i++)
    {
        CfdBoundary boundary = _CfdBoundaries[i];
        if (result < 0 && face >= 0 && (int)round(boundary.face) == face &&
            CfdBoundaryContainsCell(boundary, boundaryCell)) result = i;
    }
    return result;
}

float CfdSolidCoverageAt(int3 c)
{
    // Single initialized return avoids Metal's conservative false-positive on helper return temporaries.
    float result = 0.0;
    if (OutsideRes(c))
        result = CfdBoundaryIndexForOutside(c) >= 0 ? 0.0 : (ClosedOutside(c) ? 1.0 : 0.0);
    else if (_NoSolids == 0) result = saturate(_Solid[c]);
    return result;
}

float CfdFluidFractionAt(int3 c) { return 1.0 - CfdSolidCoverageAt(c); }

// Interior-only coverage for kernels that never inspect out-of-range cells (Emit, Decay). Skipping the
// boundary-patch logic avoids a static _CfdBoundaries reference — that buffer is never bound on Fire solvers.
float CfdInteriorCoverage(int3 c) { return _NoSolids == 0 ? saturate(_Solid[c]) : 0.0; }

float CfdPressureAt(int3 c, float centerPressure, float neighbourFluid)
{
    float result = centerPressure;
    if (OutsideRes(c))
    {
        int boundaryIndex = CfdBoundaryIndexForOutside(c);
        if (boundaryIndex >= 0)
        {
            CfdBoundary boundary = _CfdBoundaries[boundaryIndex];
            result = boundary.mode > 0.5 ? boundary.gaugePressure : centerPressure;
        }
        else result = OpenOutside(c) ? 0.0 : centerPressure;
    }
    else if (neighbourFluid > 1e-3) result = _Pressure[c];
    return result;
}

uint ActiveBrickIndex(uint packed) { return packed & ACTIVE_INDEX_MASK; }
bool ActiveBrickHasScalar(uint packed) { return (packed & ACTIVE_SCALAR_BIT) != 0u; }

bool BaseVoxelFromIndex(uint packed, uint3 gtid, out uint3 id)
{
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    id = brick * BRICK_U + gtid;
    return !Oob(id);
}

// Indirect base dispatch: map a thread group (one per active brick) to its base voxel. Mirrors RBGS.
// Returns false if the voxel is out of bounds (boundary bricks may extend past _Res).
bool BaseVoxel(uint3 gid, uint3 gtid, out uint3 id)
{
    return BaseVoxelFromIndex(ActiveBrickIndex(_ActiveBricks[gid.x]), gtid, id);
}

// Unity caps each dispatch axis at 65,535 groups. Cache payloads can contain more than that when native-resolution
// Render Detail bricks share the stream with base bricks, so the cache-only kernels flatten a bounded X/Y dispatch.
static const uint BRAZE_MAX_DISPATCH_GROUPS_X = 65535u;
uint CacheLinearGroup(uint3 gid) { return gid.x + gid.y * BRAZE_MAX_DISPATCH_GROUPS_X; }
uint CacheLinearThread64(uint3 tid) { return tid.x + tid.y * (BRAZE_MAX_DISPATCH_GROUPS_X * 64u); }

// Decay also gets the scalar-support tag from the SAME active-list read. The ordinary overload above does not
// evaluate the tag, keeping every other sparse kernel at a single added index-mask operation.
bool BaseVoxel(uint3 gid, uint3 gtid, out uint3 id, out bool hasScalarSupport)
{
    uint tagged = _ActiveBricks[gid.x];
    hasScalarSupport = ActiveBrickHasScalar(tagged);
    return BaseVoxelFromIndex(ActiveBrickIndex(tagged), gtid, id);
}

float3 SafeNorm(float3 v)
{
    float lenSq = dot(v, v);
    return (lenSq > 1e-8) ? v * rsqrt(lenSq) : float3(0.0, 0.0, 0.0);
}

// Largest representable float16 strictly below x (x >= 0). The fields load from half textures, so
// f32tof16(x) is exact and decrementing the bit pattern yields the true predecessor (0 at/below the
// smallest denormal). Used by Decay's stall guard: guarantees a decaying value always makes storage
// progress even when the mathematical decrement is below half an ulp.
float HalfBelow(float x)
{
    uint h = f32tof16(x);
    return h == 0u ? 0.0 : f16tof32(h - 1u);
}

float EmitterContribution(Emitter e, float3 vp, float scale)
{
    // Rotate the voxel into the emitter's local frame (conjugate quaternion) so non-sphere shapes follow the
    // emitter's Transform rotation, matching the gizmo. Sphere uses length(p) so it's rotation-invariant anyway.
    float3 p = QuatRot(float4(-e.rot.xyz, e.rot.w), vp - e.posVox * scale);
    float r = max(e.radiusVox * scale, 1e-4);
    float3 halfExt = max(e.halfExtentVox * scale, float3(1e-4, 1e-4, 1e-4));
    float shape = e.shape;
    float result = 0.0;

    if (shape < 0.5) // Sphere: preserve the original soft radial source.
    {
        result = saturate(1.0 - length(p) / r);
    }
    else if (shape < 1.5) // Box — confined to the box volume with a soft INNER edge, so it never bleeds past the faces
    {
        float3 d = abs(p) - halfExt;
        // Signed distance to the box surface: < 0 inside, 0 on the face, > 0 outside.
        float sd = length(max(d, 0.0)) + min(max(d.x, max(d.y, d.z)), 0.0);
        // Soft edge band sits INSIDE the box (~1 voxel), capped at half the thinnest dimension so a flat slab
        // still fills to full strength at its core. Falloff measured inward, so contribution is exactly 0 at the
        // faces — emission stays within the authored box instead of skirting above/below it like a sphere.
        float band = max(min(1.0, 0.5 * min(halfExt.x, min(halfExt.y, halfExt.z))), 1e-4);
        result = saturate(-sd / band);
    }
    else if (shape < 2.5) // Cylinder, Y axis
    {
        float2 d = float2(length(p.xz) - r, abs(p.y) - halfExt.y);
        float outside = length(max(d, 0.0));
        result = saturate(1.0 - outside / max(r * 0.35, 1e-4));
    }
    else if (shape < 3.5) // Cone, base at -Y, tip at +Y
    {
        float halfH = max(halfExt.y, 1e-4);
        float y01 = saturate((p.y + halfH) / (halfH * 2.0));
        float coneR = r * (1.0 - y01);
        float2 d = float2(length(p.xz) - coneR, abs(p.y) - halfH);
        float outside = length(max(d, 0.0));
        result = saturate(1.0 - outside / max(r * 0.35, 1e-4));
    }
    else if (shape < 4.5) // Capsule, Y axis. halfExt.y is total half-height.
    {
        float segHalf = max(0.0, halfExt.y - r);
        float3 q = p;
        q.y -= clamp(p.y, -segHalf, segHalf);
        float outside = max(length(q) - r, 0.0);
        result = saturate(1.0 - outside / max(r * 0.35, 1e-4));
    }
    else
    {
        // Torus, Y axis. radiusVox is major radius, halfExtentVox.y is tube radius.
        float minor = max(halfExt.y, 1e-4);
        float2 tq = float2(length(p.xz) - r, p.y);
        float torusOutside = max(length(tq) - minor, 0.0);
        result = saturate(1.0 - torusOutside / max(minor * 0.35, 1e-4));
    }
    return result;
}

// A symmetric filled scalar cannot reveal rotation: it looks identical after any angle. Rotor Streaks emits
// narrow angular bands in the source's local XY plane (flow is local +Z), giving the passive scalar material
// lines that can wind into a visible helical wake. This changes density presentation only, never velocity.
float SourceDyeMask(Emitter e, float3 vp)
{
    // Metal warns about the implicit function-result temporary when control flow exits early. Keep one explicitly
    // initialized result and one return; this is mathematically identical and makes every backend see the default.
    float result = 1.0;
    if (e.sourceDyePattern >= 0.5)
    {
        float3 p = QuatRot(float4(-e.rot.xyz, e.rot.w), vp - e.posVox);
        float radius = e.shape < 1.5 && e.shape >= 0.5
            ? max(e.halfExtentVox.x, e.halfExtentVox.y)
            : e.radiusVox;
        float radial = length(p.xy) / max(radius, 1e-4);
        float cycles = atan2(p.y, p.x) * (max(e.sourceDyeStreakCount, 1.0) / 6.28318530718);
        float phase = frac(cycles);
        float angularDistance = min(phase, 1.0 - phase);
        float halfWidth = saturate(e.sourceDyeStreakWidth) * 0.5;
        float band = 1.0 - smoothstep(halfWidth, min(0.5, halfWidth + 0.08), angularDistance);
        result = band * smoothstep(0.04, 0.14, radial);
    }
    return result;
}

float3 SourceSwirlVelocity(Emitter e, float3 vp)
{
    float3 result = float3(0.0, 0.0, 0.0);
    if (abs(e.sourceSwirlSpeed) > 1e-5)
    {
        float3 axis = SafeNorm(e.sourceSwirlAxis);
        if (dot(axis, axis) > 1e-6)
        {
            float3 offset = vp - e.posVox;
            float3 radial = offset - axis * dot(offset, axis);
            float radialLength = length(radial);
            if (radialLength > 1e-4)
            {
                float radius = e.shape < 1.5 && e.shape >= 0.5
                    ? max(e.halfExtentVox.x, e.halfExtentVox.y)
                    : e.radiusVox;
                float rimFraction = saturate(radialLength / max(radius, 1e-4));
                result = SafeNorm(cross(axis, radial)) * (e.sourceSwirlSpeed * rimFraction);
            }
        }
    }
    return result;
}

// Per-emitter motion: Source Velocity / Jet are birth velocities (Emit), Buoyancy is a temperature body force
// (Force), Push is post-projection (Project), and Radial is a divergence source (Divergence). Swirl / Turbulence /
// Billows are GLOBAL on the container now (Confinement + CurlNoise kernels).

float EmitterGasSource(Emitter e, float3 vp, float4 fld)
{
    float contrib = EmitterContribution(e, vp, 1.0);
    float result = 0.0;
    if (contrib > 1e-5)
    {
        float combustion = saturate(GasCombustionSource(fld)) * contrib;
        float hotSmoke = saturate(max(fld.x, 0.0) + max(fld.y, 0.0) * 0.45) * contrib;
        float source = lerp(combustion, hotSmoke, saturate(e.gasSourceSpread));
        result = pow(saturate(source), max(e.gasSourceSharpness, 0.01));
    }
    return result;
}

// Brick-indirect over the active set: MarkEmitterOcc AABB-marks every driving emitter's full falloff support
// (including pure air-movers — jet/source-velocity/turbulence with zero channels) BEFORE DilateOcc, so every
// voxel any emitter can touch is guaranteed inside _ActiveBricks. Output is identical to the old dense pass,
// without launching (or SDF-testing) the empty majority of the grid every step.
[numthreads(4, 4, 4)]
void Emit(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    float3 vp = float3(id) + 0.5;
    float3 add = 0;
    float buoyWeighted = 0.0, buoyW = 0.0;   // per-emitter buoyancy, mass-weighted by the gas each emitter adds here
    float3 sourceWeighted = 0.0; float sourceW = 0.0; float sourceBlendWeighted = 0.0; // birth velocity, contrib-weighted
    for (int i = 0; i < _EmitterCount; i++)
    {
        Emitter e = _Emitters[i];
        float contrib = EmitterContribution(e, vp, 1.0);
        // Outside the falloff every term below multiplies by contrib — skip before the expensive curl-noise
        // potential. (Tail values ≤1e-6 are far below half-precision field quantization.)
        if (contrib <= 1e-6) continue;
        float3 emittedChannels = e.channels;
        emittedChannels.x *= SourceDyeMask(e, vp);
        add += emittedChannels * contrib;
        float w = contrib * max(emittedChannels.x + emittedChannels.y, 0.0); // gas added (density + heat)
        buoyWeighted += e.motionBuoyancy * w;
        buoyW += w;
        // BrazePotential is the dominant ALU in this kernel — only evaluate it when source turbulence is on
        // (jitter is multiplied by sourceTurbulence, so it is exactly 0 below the same 1e-5 hasJetOrJitter gate).
        float3 jitter = e.sourceTurbulence > 1e-5
            ? BrazePotential(vp * (0.125 / max(_ResolutionScale, 1e-4)) + float3(13.7, 7.1, 19.3), _Time * 1.7) * e.sourceTurbulence
            : (float3)0;
        float3 birthVelocity = e.motionJet + e.sourceVelocity + SourceSwirlVelocity(e, vp) + jitter;
        float hasJetOrJitter = (dot(e.motionJet, e.motionJet) > 1e-8 || e.sourceTurbulence > 1e-5) ? 1.0 : 0.0;
        float sourceBlend = max(e.sourceVelocityBlend, hasJetOrJitter * 8.0);
        if (dot(birthVelocity, birthVelocity) > 1e-8 && sourceBlend > 1e-5)
        {
            sourceWeighted += birthVelocity * contrib;
            sourceBlendWeighted += sourceBlend * contrib;
            sourceW += contrib;
        }
    }
    // Nothing landed on this voxel (the common case — most of the grid is outside every falloff): skip the
    // field RMW entirely. The original code wrote _Fields back unchanged here, so skipping is bit-identical;
    // the velocity write below was already gated on exactly these buoyW/sourceW thresholds.
    if (all(add == 0.0) && buoyW <= 1e-6 && sourceW <= 1e-4) return;
    // CFD fractional walls: a source overlapping baked geometry must not deposit heat/dye inside it. Cut cells
    // receive their fluid share; interior cells receive nothing (Decay's binary >0.5 test used to leave sub-0.5
    // coverage cells accumulating heat inside walls forever).
    if (_CfdFractionalSolids != 0)
    {
        float fluidFraction = 1.0 - CfdInteriorCoverage(int3(id));
        if (fluidFraction <= 1e-3) return;
        add *= fluidFraction;
    }
    float4 f = _Fields[id];
    float oldDens = max(f.x, 0.0);          // existing gas mass (before this frame's add) for the buoyancy blend
    f.xyz += add * _Dt;     // density, temperature, fuel (burn untouched). Motion is injected by Force/Project/Divergence.
    _Fields[id] = f;

    // Per-emitter buoyancy (vv.w, mass-weighted) + source birth velocity (vv.xyz). The velocity blend uses the same
    // exact exponential form, so it is stable when the sim rate changes.
    if (buoyW > 1e-6 || sourceW > 1e-4)
    {
        float4 vv = _Vel[id];
        if (buoyW > 1e-6)
        {
            float emittedBuoy = buoyWeighted / buoyW;
            float newGas = buoyW * _Dt;
            vv.w = (oldDens * vv.w + newGas * emittedBuoy) / max(oldDens + newGas, 1e-6);
        }
        if (sourceW > 1e-4)
        {
            float blendRate = sourceBlendWeighted / max(sourceW, 1e-6);
            float blend = 1.0 - exp(-max(blendRate, 0.0) * sourceW * _Dt);
            vv.xyz = lerp(vv.xyz, sourceWeighted / sourceW, saturate(blend));
        }
        _Vel[id] = vv;
    }
}

// Point-set emission: one thread per (deduped) covered cell → additive inject. Runs right after Emit.
[numthreads(64, 1, 1)]
void EmitPoints(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= (uint)_PointCount) return;
    PointSource p = _PointSources[tid.x];
    int3 c = int3(floor(p.posVox));
    if (any(c < 0) || any(c >= _Res)) return;
    uint3 uc = (uint3)c;
    float4 f = _Fields[uc];
    float oldDens = max(f.x, 0.0);          // existing gas mass before this add (for the buoyancy blend, mirrors Emit)
    f.xyz += p.channels * _Dt;
    _Fields[uc] = f;

    // One thread per deduped cell, so these _Vel writes are race-free. Two optional effects on the same cell:
    //   • velBlend  → pull the cell velocity toward the moving source (motion inheritance).
    //   • buoyBlend → set the per-source buoyancy in .w, mass-weighted by the gas just added (mirrors the Emit
    //                 kernel). Static masks / disintegrator clumps pass buoyBlend = 0, so .w stays untouched.
    bool touch = (p.velBlend > 1e-4) || (p.buoyBlend > 1e-4);
    if (touch)
    {
        float4 vv = _Vel[uc];
        if (p.velBlend > 1e-4)
            vv.xyz = lerp(vv.xyz, p.vel, saturate(p.velBlend));
        if (p.buoyBlend > 1e-4)
        {
            float newGas = max(p.channels.x + p.channels.y, 0.0) * _Dt * saturate(p.buoyBlend);
            if (newGas > 1e-6)
                vv.w = (oldDens * vv.w + newGas * p.buoyancy) / max(oldDens + newGas, 1e-6);
        }
        _Vel[uc] = vv;
    }
}

// Fused semi-Lagrangian advect: fields phi_hat AND velocity self-advection back-trace from the SAME voxel
// along the SAME carrier velocity sample, so one kernel does both — one dispatch and one carrier fetch
// instead of two. Writes are independent targets: _FieldsOut is the hat MacCormack corrects next, _VelOut is
// the next-step velocity (MacCormack still reads the PRE-swap _VelIn, so ordering is unchanged).
// CFD boundary guard for the semi-Lagrangian backtrace: coverage > 0.5 at a sample point means the trace ended
// inside baked geometry. Point-loading the resident coverage mask is enough — the test is binary at cell scale.
bool CfdTraceBlocked(float3 samplePosVox)
{
    return _SolidRO[(uint3)ClampC(int3(floor(samplePosVox)))] > 0.5;
}

[numthreads(BRICK, BRICK, BRICK)]
void AdvectFields(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;   // INDIRECT: only active bricks dispatched
    float3 invN = 1.0 / float3(_Res);
    float3 p = float3(id) + 0.5;
    float3 vel = _VelIn.SampleLevel(sampler_linear_clamp, p * invN, 0).xyz;
    float3 samplePos = p - vel * _Dt;
    // CFD fractional walls: an unguarded backtrace pulls samples straight THROUGH baked geometry — dye and heat
    // teleport across thin walls and wakes seed from interior zeros. When the trace ends inside the body, bisect
    // back toward this (fluid) cell and sample the deepest fluid point along the ray instead. Fire keeps the
    // original unguarded trace (analytic obstacles never relied on through-wall protection).
    if (_CfdFractionalSolids != 0 && _NoSolids == 0 && CfdTraceBlocked(samplePos))
    {
        float3 lo = p;
        float3 hi = samplePos;
        [unroll] for (int i = 0; i < 3; i++)
        {
            float3 mid = (lo + hi) * 0.5;
            if (CfdTraceBlocked(mid)) hi = mid; else lo = mid;
        }
        samplePos = lo;
    }
    float3 buvw = samplePos * invN;
    _FieldsOut[id] = max(_FieldsIn.SampleLevel(sampler_linear_clamp, buvw, 0), 0.0);
    float4 s = _VelIn.SampleLevel(sampler_linear_clamp, buvw, 0);
    // .xyz = velocity (dissipated). .w = per-emitter buoyancy coefficient, carried WITH the flow (no dissipation),
    // so each emitter's buoyancy advects along with its gas.
    _VelOut[id] = float4(s.xyz * _VelDissipation, s.w);
}

// MacCormack correction (BFECC-style): adds back the advection error, clamped to the
// local neighbourhood of phi^n to suppress overshoot. Sharpens smoke/fire vs plain SL.
[numthreads(BRICK, BRICK, BRICK)]
void MacCormackFields(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    float3 invN = 1.0 / float3(_Res);
    float3 p = float3(id) + 0.5;
    float3 vel = _VelIn.SampleLevel(sampler_linear_clamp, p * invN, 0).xyz;

    float4 phiHat = _FieldsHat.Load(int4(int3(id), 0));
    // CFD fractional walls: near baked geometry the forward re-advection and the clamp window read interior
    // cells holding zeros, so the "correction" manufactures error instead of measuring it. Fall back to the
    // first-order semi-Lagrangian result there — the guarded AdvectFields sample is already wall-safe.
    if (_CfdFractionalSolids != 0 && _NoSolids == 0 &&
        (CfdTraceBlocked(p + vel * _Dt) || CfdTraceBlocked(p - vel * _Dt)))
    {
        _FieldsOut[id] = phiHat;
        return;
    }

    float4 phiBar = _FieldsHat.SampleLevel(sampler_linear_clamp, (p + vel * _Dt) * invN, 0);
    float4 phiN = _FieldsN.Load(int4(int3(id), 0));
    float4 corrected = phiHat + 0.5 * (phiN - phiBar);

    // Limiter: clamp to min/max of phi^n over the 8 cells around the backtrace.
    int3 b = int3(floor(p - vel * _Dt - 0.5));
    float4 lo = 1e9, hi = -1e9;
    [unroll] for (int dz = 0; dz < 2; dz++)
    [unroll] for (int dy = 0; dy < 2; dy++)
    [unroll] for (int dx = 0; dx < 2; dx++)
    {
        float4 s = _FieldsN.Load(int4(ClampC(b + int3(dx, dy, dz)), 0));
        lo = min(lo, s);
        hi = max(hi, s);
    }
    _FieldsOut[id] = max(clamp(corrected, lo, hi), 0.0);
}

[numthreads(4, 4, 4)]
void Curl(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    float3 vpx = _Vel[ClampC(c + int3(1, 0, 0))].xyz, vmx = _Vel[ClampC(c - int3(1, 0, 0))].xyz;
    float3 vpy = _Vel[ClampC(c + int3(0, 1, 0))].xyz, vmy = _Vel[ClampC(c - int3(0, 1, 0))].xyz;
    float3 vpz = _Vel[ClampC(c + int3(0, 0, 1))].xyz, vmz = _Vel[ClampC(c - int3(0, 0, 1))].xyz;
    // CFD fractional walls: a central difference spanning fast fluid and the zeroed body interior reads as
    // enormous vorticity glued to the surface — pure discretization artifact, which Confinement then amplifies.
    // Substitute the centre velocity for solid-side samples (one-sided difference → zero gradient across the wall).
    if (_CfdFractionalSolids != 0 && _NoSolids == 0)
    {
        float3 vc = _Vel[id].xyz;
        if (_Solid[ClampC(c + int3(1, 0, 0))] > 0.5) vpx = vc;
        if (_Solid[ClampC(c - int3(1, 0, 0))] > 0.5) vmx = vc;
        if (_Solid[ClampC(c + int3(0, 1, 0))] > 0.5) vpy = vc;
        if (_Solid[ClampC(c - int3(0, 1, 0))] > 0.5) vmy = vc;
        if (_Solid[ClampC(c + int3(0, 0, 1))] > 0.5) vpz = vc;
        if (_Solid[ClampC(c - int3(0, 0, 1))] > 0.5) vmz = vc;
    }
    float3 w;
    w.x = (vpy.z - vmy.z) - (vpz.y - vmz.y);
    w.y = (vpz.x - vmz.x) - (vpx.z - vmx.z);
    w.z = (vpx.y - vmx.y) - (vpy.x - vmy.x);
    _Curl[id] = float4(w, 0);
}

// Vorticity confinement (the container "Swirl" knob) — pushes velocity back toward the local vortex cores so the
// fluid's own swirls/rolls are AMPLIFIED instead of being smeared out by numerical diffusion. This is what makes
// the smoke read as turbulent, and it's the vorticity that feeds Render Detail. Global over the active plume.
[numthreads(4, 4, 4)]
void Confinement(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    float ml = length(_Curl[ClampC(c - int3(1, 0, 0))].xyz), mr = length(_Curl[ClampC(c + int3(1, 0, 0))].xyz);
    float md = length(_Curl[ClampC(c - int3(0, 1, 0))].xyz), mu = length(_Curl[ClampC(c + int3(0, 1, 0))].xyz);
    float mb = length(_Curl[ClampC(c - int3(0, 0, 1))].xyz), mf = length(_Curl[ClampC(c + int3(0, 0, 1))].xyz);
    float3 grad = float3(mr - ml, mu - md, mf - mb);
    float3 N = grad / (length(grad) + 1e-5);
    float3 force = cross(N, _Curl[id].xyz) * _ConfineScale;
    // CFD fractional walls: never let confinement act on the wall shell. Even with the one-sided Curl above,
    // the curl-magnitude gradient still spikes at the surface; injecting force there rebuilds the flickering
    // vortex sheets every tick and pushes flow into the body between projections.
    if (_CfdFractionalSolids != 0 && _NoSolids == 0)
    {
        int3 cc = int3(id);
        float wallMask = 1.0 - saturate(_Solid[id]);
        wallMask *= 1.0 - saturate(max(max(max(_Solid[ClampC(cc + int3(1, 0, 0))], _Solid[ClampC(cc - int3(1, 0, 0))]),
                                           max(_Solid[ClampC(cc + int3(0, 1, 0))], _Solid[ClampC(cc - int3(0, 1, 0))])),
                                       max(_Solid[ClampC(cc + int3(0, 0, 1))], _Solid[ClampC(cc - int3(0, 0, 1))])));
        force *= wallMask;
    }
    float4 v = _Vel[id];
    v.xyz += force * _Dt;
    _Vel[id] = v;
}

float ActivityAt(int3 c) { float4 f = _Fields[ClampC(c)]; return clamp(f.x + f.y * 0.45, 0.0, 2.0); }

// Drift-free curl-noise force. A naive `gate · curlNoise` has a NON-zero spatial average over a finite plume, so it
// imparts net momentum and slowly translates the whole plume like an unwanted wind — direction should come only from
// wind / push / buoyancy, never from churn. Building the force as the curl of a COMPACTLY-SUPPORTED potential
// (gate · ψ, with gate → 0 outside the plume) guarantees ∫F dV = 0 (zero net force): the plume swirls IN PLACE.
// Identity: curl(g·ψ)/s = g·curl(ψ) + (∇g × ψ)/s. The first term is the usual body churn; the ∇g term rides the
// smoke/air boundary, so it also curdles the leading edge into cauliflower — for free, and without any drift.
float3 DriftFreeNoise(float3 q, float ph, float gate, float3 gateGradVox, float scale)
{
    return gate * BrazeCurlNoise(q, 0.3, ph) + cross(gateGradVox / max(scale, 1e-4), BrazePotential(q, ph));
}

// Final Spline Vortex guide. This intentionally runs AFTER the container's confinement/curl/turbulence in
// CurlNoise: conformation is the primary velocity field, and chaotic motion is merely a small bounded target detail.
// The guide is component-wise and monotonic (x/(1+x) response), so no pair of sliders has to balance on a tipping
// point. It consumes the same force/sample buffers as Force and adds no dispatch or allocation.
void ApplySplineVortexGuide(ForceField fo, float3 vp, float4 fluid, inout float3 velocity)
{
    float3 toBounds = vp - fo.posVox;
    if (any(abs(toBounds) > fo.dir)) return;

    int sampleStart = max((int)round(fo.layers), 0);
    int sampleCount = max((int)round(fo.layerSpacing), 0);
    if (sampleCount < 2 || sampleStart + sampleCount > _SplineVortexSampleCount) return;

    float bestD2 = 3.402823466e+38;
    float3 bestPoint = 0.0;
    float bestRadius = 0.0;
    int bestSegment = 0;
    float bestSegmentT = 0.0;
    [loop]
    for (int j = 0; j < sampleCount - 1; j++)
    {
        float4 sa = _SplineVortexSamples[sampleStart + j];
        float4 sb = _SplineVortexSamples[sampleStart + j + 1];
        float3 segment = sb.xyz - sa.xyz;
        float segmentD2 = max(dot(segment, segment), 1e-8);
        float h = saturate(dot(vp - sa.xyz, segment) / segmentD2);
        float3 q = sa.xyz + segment * h;
        float d2 = dot(vp - q, vp - q);
        if (d2 < bestD2)
        {
            bestD2 = d2;
            bestPoint = q;
            bestRadius = lerp(sa.w, sb.w, h);
            bestSegment = j;
            bestSegmentT = h;
        }
    }

    int sampleEnd = sampleStart + sampleCount - 1;
    int centreA = sampleStart + bestSegment;
    int centreB = centreA + 1;
    float3 pPrev = _SplineVortexSamples[max(centreA - 1, sampleStart)].xyz;
    float3 pA = _SplineVortexSamples[centreA].xyz;
    float3 pB = _SplineVortexSamples[centreB].xyz;
    float3 pNext = _SplineVortexSamples[min(centreB + 1, sampleEnd)].xyz;
    float3 tangentA = SafeNorm(pB - pPrev);
    float3 tangentB = SafeNorm(pNext - pA);
    float3 axis = SafeNorm(lerp(tangentA, tangentB, bestSegmentT));
    if (dot(axis, axis) < 1e-5) axis = SafeNorm(pB - pA);
    if (dot(axis, axis) < 1e-5) axis = float3(0.0, 1.0, 0.0);

    float pathU = (bestSegment + bestSegmentT) / max((float)(sampleCount - 1), 1.0);
    float segmentArc = max(length(pB - pA), 0.25);
    float3 curvatureVector = (tangentB - tangentA) / segmentArc;
    curvatureVector -= axis * dot(curvatureVector, axis);
    if (fo.taper > 0.5)
    {
        axis = -axis;
        pathU = 1.0 - pathU;
    }

    // Orthonormal stream-tube frame. Projecting onto the smooth normal plane prevents axial motion from being
    // misclassified as radial motion at sample joints — the original source of Flow/Conform oscillation.
    float3 rawOffset = vp - bestPoint;
    float3 radialOffset = rawOffset - axis * dot(rawOffset, axis);
    float radialDistance = length(radialOffset);
    float3 frameU = cross(axis, float3(0.0, 1.0, 0.0));
    if (dot(frameU, frameU) < 1e-4) frameU = cross(axis, float3(1.0, 0.0, 0.0));
    frameU = SafeNorm(frameU);
    float3 outward = (radialDistance > 1e-4) ? radialOffset / radialDistance : frameU;
    float3 tangent = SafeNorm(cross(axis, outward));

    float profileRadius = max(bestRadius, 1e-3);
    float capture = max(fo.thickness, 0.25);
    int conformMode = (int)round(fo.falloffInner);
    float influence;
    if (conformMode == 1)
    {
        // Capture the entire interior so smoke at the axis can actually reach a broad eye wall; fade only outside.
        float halfWall = max(fo.fieldHeight * 0.5, 0.25);
        influence = 1.0 - smoothstep(profileRadius + halfWall,
                                      profileRadius + halfWall + capture, radialDistance);
    }
    else influence = 1.0 - smoothstep(profileRadius, profileRadius + capture, radialDistance);

    float presence = saturate(max(max(fluid.x * 4.0, fluid.y * 0.5), max(fluid.z * 0.5, fluid.w * 0.5)));
    float active = influence * presence;
    if (active <= 1e-5) return;

    float conform = saturate(fo.scale);
    float containment = saturate(fo.hold);
    float axialVelocity = dot(velocity, axis);
    float tangentialVelocity = dot(velocity, tangent);
    float radialVelocity = dot(velocity, outward);

    // CURVATURE-SAFE FLOW. Requested speed is preserved on straight sections and automatically limited only where
    // speed²·curvature would exceed what this profile/conform authority can turn without leaving the tube.
    float requestedFlow = clamp(fo.swirl, -_MaxSpeed, _MaxSpeed);
    float curvatureMagnitude = length(curvatureVector);
    float curveAccelBudget = lerp(2.0, 20.0, max(conform, containment)) * max(profileRadius * 0.35, 1.0);
    float curveSpeedLimit = sqrt(curveAccelBudget / max(curvatureMagnitude, 1e-5));
    float guidedFlow = sign(requestedFlow) * min(abs(requestedFlow), min(curveSpeedLimit, _MaxSpeed));

    // Monotonic response factors. They approach but can never cross their targets for any positive dt.
    float calmX = conform * 48.0 * active * _Dt;
    float calmStep = calmX / (1.0 + calmX);
    float flowX = saturate(fo.power) * 14.0 * active * _Dt;
    float flowStep = flowX / (1.0 + flowX);
    float spinX = saturate(fo.flatten) * 14.0 * active * _Dt;
    float spinStep = spinX / (1.0 + spinX);
    float residualCalm = calmStep * 0.65;   // erase global chaos even when Flow/Spin response is deliberately low

    // The eye is a terminal diffuser, not a nozzle. Smoothly reduce the axial target across the already-authored
    // Eye Length; Eye Flow (fo.shape) chooses how much body speed remains at the endpoint. A monotonic response
    // below performs the braking, so low Flow Response cannot leave a fast parcel coasting through the eye.
    float eyeLength = max(saturate(fo._forcePad.y), 0.01);
    float eyeMask = smoothstep(1.0 - eyeLength, 1.0, pathU);
    float eyeFlowRetention = saturate(fo.shape);
    float eyeFlowScale = lerp(1.0, eyeFlowRetention, eyeMask);
    float axialTarget = (fo.power > 1e-4) ? guidedFlow * eyeFlowScale : 0.0;
    float spinTarget = (fo.flatten > 1e-4)
        ? clamp(fo.strength * radialDistance, -_MaxSpeed, _MaxSpeed) : 0.0;

    // POSITION CONFORMATION owns the radial component. Volume mode calmly freezes radial drift throughout the
    // interior and restores predicted escape; Wall mode is a soft critically-damped spring toward the lathed shell.
    float turnRate = abs(guidedFlow) * curvatureMagnitude;
    float predictionTime = lerp(_Dt, 0.15, saturate(turnRate * 0.25));
    float predictedRadius = radialDistance + max(radialVelocity, 0.0) * predictionTime;
    float radialTarget = 0.0;
    if (conformMode == 1)
        radialTarget = clamp((profileRadius - radialDistance) * 3.0, -_MaxSpeed, _MaxSpeed);
    else if (predictedRadius > profileRadius)
        radialTarget = -min((predictedRadius - profileRadius) * 4.0, _MaxSpeed);

    float openingRadius = profileRadius * saturate(fo._forcePad.x) * eyeMask;
    if (radialDistance < openingRadius)
    {
        // Eye Outflow is a literal target-speed ceiling. The previous position spring added radius error * 3 on
        // top of Eye Outflow, which made large eyes explode sideways even at modest authored values.
        float openingDepth = saturate((openingRadius - radialDistance) / max(openingRadius, 1e-3));
        float eyeOutflowTarget = min(max(fo.dome, 0.0), _MaxSpeed) * eyeMask * openingDepth;
        radialTarget = max(radialTarget, eyeOutflowTarget);
    }
    float tailLength = max(saturate(fo.hole), 0.01);
    float tailMask = 1.0 - smoothstep(0.0, tailLength, pathU);
    radialTarget = max(radialTarget - fo.seal * tailMask, -_MaxSpeed);

    // Component detail is a bounded TARGET velocity, never an accumulating force. At high Conform its radial share
    // is almost removed, but a small tangential/axial shimmer survives so the calm funnel does not look frozen.
    float detailLimit = min(_MaxSpeed * 0.06, max(profileRadius * 0.08, 0.15 * _ResolutionScale));
    float radialDetailFreedom = lerp(0.3, 0.05, conform);
    float3 detailVelocity = 0.0;
    if (fo.distort > 1e-4)
    {
        detailVelocity = BrazeCurlNoise(vp * max(fo.roll, 1e-4) + 73.1, 0.3, _Time * 0.5)
                       * (fo.distort * detailLimit);
        float detailRadial = dot(detailVelocity, outward);
        detailVelocity += outward * (detailRadial * (radialDetailFreedom - 1.0));
    }
    float arms = round(fo.billowLines);
    if (arms > 0.5 && fo.falloffPower > 1e-4 && radialDistance > 1e-4)
    {
        float3 frameV = cross(axis, frameU);
        float theta = atan2(dot(radialOffset, frameV), dot(radialOffset, frameU));
        float phase = arms * (theta - fo.strength * _Time - pathU * fo.billowMode * 6.28318530718);
        float armSin, armCos;
        sincos(phase, armSin, armCos);
        radialTarget += armCos * fo.falloffPower * detailLimit * radialDetailFreedom;
    }

    axialTarget += dot(detailVelocity, axis);
    spinTarget += dot(detailVelocity, tangent);
    radialTarget += dot(detailVelocity, outward);

    // Clamp every source of positive radial target (wall correction, arms and turbulence included) toward the
    // authored Eye Outflow ceiling. The blend is continuous at the eye boundary and leaves inward conformation free.
    float eyeOutflowCap = min(max(fo.dome, 0.0), _MaxSpeed);
    radialTarget = lerp(radialTarget, min(radialTarget, eyeOutflowCap), eyeMask);

    float eyeBrakeX = (1.0 - eyeFlowRetention) * eyeMask * 32.0 * active * _Dt;
    float eyeBrakeStep = eyeBrakeX / (1.0 + eyeBrakeX);
    float newAxial = lerp(axialVelocity, axialTarget, max(max(flowStep, residualCalm), eyeBrakeStep));
    float newTangential = lerp(tangentialVelocity, spinTarget, max(spinStep, residualCalm));
    float newRadial = lerp(radialVelocity, radialTarget, max(calmStep, eyeBrakeStep));
    velocity = axis * newAxial + tangent * newTangential + outward * newRadial;

    // Feed-forward the centreline turn after the calm projection. It is bounded by the same acceleration budget that
    // produced the safe curve speed and cannot accumulate beyond one frame's required centripetal correction.
    float turningSpeed = min(abs(newAxial), abs(guidedFlow));
    float3 curveDelta = curvatureVector * (turningSpeed * turningSpeed * _Dt);
    float curveDeltaLength = length(curveDelta);
    float maxCurveDelta = max(profileRadius * 0.05, 0.25);
    if (curveDeltaLength > maxCurveDelta) curveDelta *= maxCurveDelta / curveDeltaLength;
    velocity += curveDelta;

    // Final one-way rail, evaluated on predicted radius, catches the remaining outward component without touching
    // axial flow or spin. This is the last Spline Vortex operation of the global-dynamics pass.
    radialVelocity = dot(velocity, outward);
    if (containment > 1e-4 && radialVelocity > 0.0)
    {
        float edge = smoothstep(0.55, 1.0, predictedRadius / profileRadius)
                   * (1.0 - smoothstep(profileRadius + capture * 0.5,
                                       profileRadius + capture, predictedRadius));
        float containX = containment * 48.0 * edge * active * _Dt;
        float containStep = containX / (1.0 + containX);
        velocity -= outward * (radialVelocity * containStep);
    }

    // Pressure and inherited motion can reintroduce outward velocity after the target calculation. Apply a final
    // one-way terminal limiter: it fades in across Eye Length, is exact at the endpoint, and never blocks inward
    // conformation. This makes Eye Outflow an observable ceiling rather than merely a preferred target.
    radialVelocity = dot(velocity, outward);
    if (eyeMask > 1e-4 && radialVelocity > eyeOutflowCap)
        velocity -= outward * ((radialVelocity - eyeOutflowCap) * eyeMask);

    float speed = length(velocity);
    if (speed > _MaxSpeed) velocity *= _MaxSpeed / speed;
}

// Global curl-noise turbulence + billows — applied EVERYWHERE there's smoke (gated by local activity, not by an
// emitter footprint), so the whole plume body breaks up into wisps and big rolls. Fine octave = Turbulence,
// large slow octave = Billows. This is the container's global churn, separate from per-emitter source-local turb.
[numthreads(4, 4, 4)]
void CurlNoise(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    float3 vp = float3(id) + 0.5;
    float4 f = _Fields[id];
    float activity = clamp(f.x + f.y * 0.45, 0.0, 2.0);   // gate by local smoke/heat → churn lives in the plume
    float3 force = BrazeCurlNoise(vp * _TurbScale, 0.3, _Time * 0.5) * _Turbulence;
    force += BrazeCurlNoise(vp * _BillowScale + 31.7, 0.3, _Time * 0.25) * _BillowStrength;
    force *= activity;   // gate global churn proportionally to where smoke is (never stirs empty space)

    // Anti-stasis: a MID-scale (0.12 — coarser than fine Turbulence, so it shears the field into wisps without
    // grain), SLOW curl drift that keeps settled smoke alive so it never freezes into the static "wool" pattern.
    // Its OWN near-binary gate (not the proportional one above) so even FAINT cooled smoke — exactly where wool
    // forms — still drifts at full strength.
    if (_AmbientLife > 0.0)
        force += BrazeCurlNoise(vp * (0.12 / max(_ResolutionScale, 1e-4)) + 7.3, 0.3, _Time * 0.15)
               * (_AmbientLife * saturate(activity * 3.0));

    // Interface turbulence (cauliflower): a finer, faster octave built as a DRIFT-FREE curl (see DriftFreeNoise).
    // Its ∇activity term concentrates churn on the smoke/air boundary → florets on the leading edge, and because the
    // field is compactly supported the net force is zero, so it adds NO directional drift to the plume.
    if (_InterfaceTurb > 0.0)
    {
        int3 c = int3(id);
        float3 gradA = 0.5 * float3(
            ActivityAt(c + int3(1,0,0)) - ActivityAt(c - int3(1,0,0)),
            ActivityAt(c + int3(0,1,0)) - ActivityAt(c - int3(0,1,0)),
            ActivityAt(c + int3(0,0,1)) - ActivityAt(c - int3(0,0,1)));
        float3 q = vp * _InterfaceTurbScale + 53.2;
        force += DriftFreeNoise(q, _Time * 0.9, activity, gradA, _InterfaceTurbScale) * _InterfaceTurb;
    }

    float4 v = _Vel[id];
    v.xyz += force * _Dt;
    // Spline Vortex is the LAST velocity guide: global curls/billows above are input texture, never the authority.
    for (int s = 0; s < _SplineVortexForceCount; s++)
    {
        int forceIndex = _SplineVortexForceStart + s;
        if (forceIndex < 0 || forceIndex >= _ForceCount) break;
        ForceField splineVortex = _Forces[forceIndex];
        if ((int)splineVortex.type != 11) continue;
        ApplySplineVortexGuide(splineVortex, vp, f, v.xyz);
    }
    _Vel[id] = v;
}

[numthreads(4, 4, 4)]
void Force(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    float3 vp = float3(id) + 0.5;
    float4 v = _Vel[id];

    for (int i = 0; i < _ForceCount; i++)
    {
        ForceField fo = _Forces[i];
        float3 toV = vp - fo.posVox;
        int t = (int)fo.type;
        // Spline Vortex is deliberately deferred to the end of CurlNoise, after every chaotic/global dynamic.
        if (t == 11) continue;
        float dist = length(toV);
        int fshape = (int)(fo.shape + 0.5);     // 0 sphere, 1 cylinder, 2 torus (generic field forces)

        // Shape-aware FORCE-FIELD falloff — purely an AREA mask (0..1) that scopes how strongly the force acts; it
        // adds no push of its own. 'fS' is 0 at the core, 1 at the shape surface; strength fades from a full-strength
        // core (falloffInner) to 0 at fS=1 along falloffPower. A central HOLE (Sphere→shell, Cylinder→tube) lets the
        // force hit only the OUTER region (a plume's edges, leaving the middle free); the Torus is inherently holed.
        float Rfield = fo.radiusVox;
        float fall = 1.0;
        if (Rfield > 0.0)
        {
            float3 fAxis = SafeNorm(fo.dir);
            float fAxial = dot(toV, fAxis);
            float fPlanar = length(toV - fAxial * fAxis);
            float Hh = max(fo.fieldHeight, 1e-3);
            float hole = saturate(fo.hole);
            float fS, holeT;
            if (fshape == 1)        // cylinder: radial × axial extent; the hole carves the central column → a tube
            {
                fS = max(fPlanar / Rfield, abs(fAxial) / Hh);
                holeT = fPlanar / Rfield;
            }
            else if (fshape == 2)   // torus: ring of major fRingR, tube radius from the hole; donut hole in the middle
            {
                float fRingR = Rfield * (1.0 + hole) * 0.5;
                float tubeR = max(Rfield * (1.0 - hole) * 0.5, 1e-3);
                fS = length(float2(fPlanar - fRingR, fAxial)) / tubeR;
                holeT = 2.0;        // geometric hole → no extra central gate
            }
            else if (fshape == 3)   // disc: oblate ellipsoid — wide in-plane (Rfield), thin along the axis (Height)
            {
                fS = length(float2(fPlanar / Rfield, fAxial / Hh));   // soft pancake region (rounder than a cylinder)
                holeT = fPlanar / Rfield;
            }
            else                    // sphere: the hole carves the central ball → a shell
            {
                fS = dist / Rfield;
                holeT = fS;
            }
            float core = saturate((1.0 - fS) / max(1.0 - saturate(fo.falloffInner), 1e-4));
            fall = (fS > 1.0) ? 0.0 : pow(core, max(fo.falloffPower, 0.01));
            if (fshape != 2 && hole > 1e-3)
                fall *= smoothstep(hole, hole + max(0.04, (1.0 - hole) * 0.15), holeT);
        }

        float3 a = 0;
        if (t == 0)        a = fo.dir * fo.strength;                                 // wind
        else if (t == 1)   // VORTEX — swirl / inward / orbit + axial column control (fluid port of the particle Vortex).
        {
            // All modes DRIVE the in-plane velocity toward a swirl, so still or purely-rising smoke is spun up —
            // a pure velocity rotation would leave an axial plume untouched. Localized Swirl treats Strength as an
            // angular rate over a DIFFERENTIAL profile: solid-body core spun down to rest at the field rim. A pure
            // solid-body target reads as frozen once the fluid matches it (an axisymmetric volume rotating rigidly
            // shows no relative motion), and it hands rim material full ω·R speed pointed straight out of the field —
            // the "spins up then settles / flings away" failure. The rim spin-down keeps permanent core↔rim shear
            // (spiral arms stay alive) and decelerates material before it coasts past the edge. Infinite Swirl keeps
            // the old fixed target speed to avoid slamming the whole container to Max Speed at the far corners.
            // Grip is a soft wall in a shell straddling the field edge: it damps ONLY the outward radial velocity
            // component, so spin is untouched and outside smoke can still fall in.
            float3 axis   = SafeNorm(fo.dir);
            axis = (dot(axis, axis) > 1e-6) ? axis : float3(0.0, 1.0, 0.0);
            float3 planar = toV - axis * dot(toV, axis);     // radial offset in the swirl plane
            float  planarLen = length(planar);
            float3 fallback = (abs(axis.y) < 0.99)
                ? SafeNorm(cross(axis, float3(0.0, 1.0, 0.0)))
                : SafeNorm(cross(axis, float3(1.0, 0.0, 0.0)));
            float3 outward = (planarLen > 1e-4) ? planar / planarLen : fallback;
            float3 tangent = SafeNorm(cross(axis, outward)); // same handedness as the classic vortex push
            int   vmode = (int)(fo.vortexMode + 0.5);
            float str   = fo.strength;
            float absStr = abs(str);

            if (absStr > 1e-5)
            {
                float spin = (1.0 - exp(-(4.0 + absStr) * _Dt)) * fall;
                float targetTangVel = str;
                if (vmode == 0 && Rfield > 0.0)
                {
                    float rim = 1.0 - smoothstep(0.7, 1.0, saturate(planarLen / Rfield));
                    float tv = str * planarLen * rim;

                    // BLADES — rotating asymmetry (the visible "wheel"). A steady source + smooth swirl settles
                    // into a TIME-INVARIANT pattern: streamlines are circles, so however fast the velocity spins,
                    // the rendered density is a still image once the pattern stabilizes. N lumps phased to
                    // CO-ROTATE with the swirl (phase = N(θ − ω·t)) keep it visibly turning like a propeller.
                    float blades = fo.vortexBlades;
                    if (blades > 0.5 && planarLen > 1e-4)
                    {
                        float3 e2 = cross(axis, fallback);           // fixed in-plane basis (per-force, not per-voxel)
                        float theta = atan2(dot(planar, e2), dot(planar, fallback));
                        float bs, bc;
                        sincos(blades * (theta - str * _Time), bs, bc);
                        tv *= 1.0 + 0.5 * bs;
                        // Rotating radial PADDLE lobes — the part that actually reads as spin. Tangential-speed
                        // modulation alone squeezes material only ALONG its own streamline; diffusion erases it
                        // and the emit→decay steady state re-freezes (verified in a 2D port of this exact kernel:
                        // the ring's density peak never moved without this term). The paddles push material
                        // ACROSS streamlines, phase-locked to the rotation, so the pattern can never become
                        // stationary. Zero-mean around the circle → no net in/outflow; the Grip wall still trims
                        // outward motion at the rim.
                        float radTarget = clamp(0.6 * str * planarLen * rim * bc, -_MaxSpeed, _MaxSpeed);
                        float radVel = dot(v.xyz, outward);
                        v.xyz += outward * ((radTarget - radVel) * spin);
                    }
                    targetTangVel = clamp(tv, -_MaxSpeed, _MaxSpeed);
                }
                float tangVel = dot(v.xyz, tangent);
                v.xyz += tangent * ((targetTangVel - tangVel) * spin);
            }

            float gripRate = max(fo.vortexGrip, 0.0);
            if (gripRate > 1e-5 && planarLen > 1e-4 && Rfield > 1e-3)
            {
                // Deliberately NOT scaled by `fall` — the falloff is ~0 exactly at the rim, which is where escape
                // happens (a fall-gated grip is a no-op and smoke coasts straight out tangentially). The wall band
                // reaches a little past the rim to catch material that already slipped out.
                float xw = planarLen / Rfield;
                float wall = smoothstep(0.7, 1.0, xw) * (1.0 - smoothstep(1.2, 1.5, xw));
                // Bound the wall to the field's axial span too, or a sphere/disc vortex would drag an infinite
                // cylindrical wall through unrelated smoke above and below it.
                float axExtent = (fshape == 1 || fshape == 3) ? max(fo.fieldHeight, 1e-3) : Rfield;
                wall *= 1.0 - smoothstep(1.0, 1.4, abs(dot(toV, axis)) / axExtent);
                float grip = (1.0 - exp(-gripRate * _Dt)) * wall;
                float outVel = max(dot(v.xyz, outward), 0.0);
                v.xyz -= outward * (outVel * grip);
            }

            if (vmode == 1)        // INWARD — suck toward the axis
            {
                float hold = saturate(max(fo.vortexHold, 0.0) * _Dt) * fall;
                float radialVel = dot(v.xyz, outward);
                float targetRadial = -min(planarLen * max(absStr, 1.0), _MaxSpeed);
                v.xyz += outward * ((targetRadial - radialVel) * hold);
            }
            else if (vmode == 2)   // ORBIT — hold at a target radius (clamped inside a localized field) + flatten
            {
                float hold = saturate(max(fo.vortexHold, 0.0) * _Dt) * fall;
                float targetRadius = max(fo.vortexOrbitR, 0.0);
                if (Rfield > 0.0) targetRadius = min(targetRadius, max(Rfield * 0.95, 1e-4));
                float radialVel = dot(v.xyz, outward);
                float targetRadial = clamp(-(planarLen - targetRadius) * max(absStr, 1.0), -_MaxSpeed, _MaxSpeed);
                v.xyz += outward * ((targetRadial - radialVel) * hold);
                float axialDamp = saturate(max(fo.vortexHold, 0.0) * max(absStr, 1.0) * 2.0 * _Dt) * fall;
                v.xyz -= axis * (dot(v.xyz, axis) * axialDamp);
            }

            // Axial column control (all modes): ease the along-axis velocity toward Lift. Axial Damp 0 leaves the
            // drift free (a tall column); higher Damp holds it toward Lift, so Lift 0 flattens the column to a disc.
            float vAxDamp = saturate(fo.vortexAxialDamp);
            if (vAxDamp > 0.0 || abs(fo.vortexLift) > 1e-6)
            {
                float liftVar = saturate(fo.vortexLiftVar);
                // Spatial variation so different columns rise at different rates (the fluid analog of the particle
                // per-particle Lift jitter). BrazeWave is a smooth bounded value field.
                float vortexVarScale = 0.06 / max(_ResolutionScale, 1e-4);
                float lvN = (liftVar > 1e-5) ? BrazeWave(vp.x * vortexVarScale, vp.y * vortexVarScale, vp.z * vortexVarScale, 0.0) * liftVar : 0.0;
                float lift = fo.vortexLift * (1.0 + lvN);
                float axialVel = dot(v.xyz, axis);
                float k = (1.0 - exp(-(2.0 + vAxDamp * 10.0) * _Dt)) * fall;
                v.xyz += axis * ((lift - axialVel) * k);
            }
        }
        else if (t == 2)   a = BrazeCurlNoise(vp * fo.scale, 0.3, _Time * 0.5) * fo.strength; // turbulence
        else if (t == 3)   a = fo.dir * fo.strength;                                 // gravity
        else if (t == 4)   a = normalize(-toV + 1e-5) * fo.strength;                 // attract (repel = -strength)
        else if (t == 5)   // DISC — SOFT volumetric shaping field for a mushroom-cloud fume.
        {
            // Model: a target silhouette (stacked tapered shelves + a domed crown + an OPEN central chimney).
            // The field never builds a wall and never pushes down. It (1) sucks broad fume up through the open
            // chimney and curves it into the crown, (2) settles the fume onto the shelves & spreads it, (3) softly
            // seals the lid/rim one-way, (4) trades natural buoyancy for the guided motion only where it should
            // settle — the chimney keeps rising on its own. Shape knobs carve the target; force knobs move fume.

            // ── disc-local frame ───────────────────────────────────────────────────────────────────────
            float3 axis  = SafeNorm(fo.dir);
            float  axial = dot(toV, axis);                 // height above the disc centre, along the axis
            float3 inPln = toV - axial * axis;
            float  planar = length(inPln);
            float3 outDir = SafeNorm(inPln);               // radial-out in the disc plane
            float3 tang   = cross(axis, outDir);           // +twist tangent

            float R  = max(fo.radiusVox, 1e-3);            // cap radius
            float H  = max(fo.thickness,  1e-3);           // shelf half-height
            float pw = max(fo.power, 0.0);
            int   L  = max((int)(fo.layers + 0.5), 1);
            float spc = max(fo.layerSpacing, 1e-3);
            float halfSpan = (L - 1) * 0.5 * spc;          // stack body extends ±halfSpan around the centre

            float core    = saturate(fo._forcePad.x);      // central chimney opening (fraction of radius)
            float suction = saturate(fo._forcePad.y);      // chimney/crown suction
            float dome    = max(fo.dome, 0.0);             // crown height (× radius)
            float taper   = (L > 1) ? saturate(fo.taper) : 0.0;
            float seal    = saturate(fo.seal);

            // ── target silhouette: body from botZ→top, domed crown above, narrowing with taper ──────────
            float Rtop  = max(R * (1.0 - taper), 1e-3);
            float botZ  = -halfSpan - H;
            float apexZ =  halfSpan + dome * Rtop + H;
            float hFrac = saturate((axial - botZ) / max(apexZ - botZ, 1e-3));   // 0 at base → 1 at crown apex
            float Rsil  = max(R * (1.0 - taper * hFrac), 1e-3);                 // silhouette radius at this height
            float rN    = planar / Rsil;

            // central chimney: open through the lower/mid stack, closing toward the crown so the dome caps it
            float crownProx = smoothstep(0.65, 1.0, hFrac);
            float coreR     = core * Rsil * (1.0 - crownProx);
            float feather   = max(Rsil * 0.08, coreR * 0.4);
            float inChimney = 1.0 - smoothstep(coreR, coreR + feather, planar);  // 1 inside the open core

            // crown spherical-cap surface (on top of the stack) and its outward-tilted normal
            float domeRoot   = sqrt(max(Rtop * Rtop - planar * planar, 0.0));
            float crownSurf  = halfSpan + dome * domeRoot;
            float domeSlope  = (domeRoot > 1e-3) ? dome * planar / domeRoot : dome * Rtop;
            float3 crownN    = SafeNorm(axis + outDir * domeSlope);
            float belowCrown = crownSurf - axial;                               // >0 under the crown, <0 above it

            // Per-voxel nearest shelf plane. Each sheet is a solid BAND of half-height sheetBandHalf; beyond it is
            // the empty inter-disc GAP — so the discs read as distinct tiers (thinner Thickness / wider Spacing = bigger gaps).
            float sheetZ = (L > 1) ? (-halfSpan + clamp(round((axial + halfSpan) / spc), 0.0, (float)(L - 1)) * spc) : 0.0;
            float dz = abs(axial - sheetZ);
            float shelfProx, gapMask;
            if (L > 1)
            {
                float bandHalf = clamp(H, spc * 0.12, spc * 0.42);
                shelfProx = 1.0 - smoothstep(bandHalf, spc * 0.5, dz);   // 1 on a sheet → 0 out in the gap
                gapMask   = smoothstep(bandHalf, spc * 0.5, dz);         // 0 on a sheet → 1 out in the gap
            }
            else { shelfProx = 1.0 - smoothstep(0.0, 1.0, saturate(dz / max(H * 2.0, R * 0.18))); gapMask = 0.0; }
            float heightBand = saturate(1.0 - max(max(axial - (halfSpan + H), botZ - axial), 0.0) / max(R * 0.3, H));

            // Radial profile across a shelf: 0 deep in the rising core → 1 out on the disc. This is what lets the
            // shelf grab fume at the chimney EDGE and shed it outward, while leaving the core free to keep climbing.
            // WIDE transition so the chimney→shelf velocity shear is spread over many voxels (anti box-jitter).
            float onShelf  = smoothstep(coreR * 0.5, coreR + Rsil * 0.45, planar);

            // ── 1) CROWN SUCTION — lift the inner column up the chimney, bending into the crown (never pushes down) ─
            float guideMask = 0.0;
            if (suction > 1e-4 && belowCrown > 0.0 && rN < 1.25)
            {
                float reach      = (apexZ - botZ) + R;
                float heightGate = saturate(1.0 - max(belowCrown - reach, 0.0) / max(R * 0.5, H));
                // Focus the lift on the inner column so the shelves (not the suction) own the annulus → no fighting.
                float innerFocus = lerp(0.25, 1.0, saturate(1.0 - planar / max(coreR + Rsil * 0.5, 1e-3)));
                guideMask = suction * pw * heightGate * saturate(1.25 - rN) * innerFocus;

                // straight up inside the chimney; gather inward when outside it; bend to the crown near the top
                float topBlend = saturate(1.0 - belowCrown / max(R * 0.6 + H, 1e-3));
                float inward   = saturate((planar - coreR) / max(R * 0.4, H)) * (1.0 - topBlend);
                float3 gather  = SafeNorm(axis - outDir * (inward * 0.8));
                float3 guideDir = SafeNorm(lerp(gather, crownN, topBlend));

                // Gentler target so the stem isn't a firehose to the crown — lets the lower discs grab fume first.
                float desired = clamp(R * 0.15 + belowCrown * 0.3, 0.0, _MaxSpeed * 0.35);
                float gv = dot(v.xyz, guideDir);
                if (gv < desired)                                              // accelerate toward the target only
                {
                    // Soft controller: ramp toward the target over several frames so it never overshoots and rings
                    // against advection (overshoot → grid-scale flicker). Cap well below 1.
                    float k = min(1.0 - exp(-7.0 * guideMask * _Dt), 0.4);
                    v.xyz += guideDir * ((desired - gv) * k);
                }
            }

            // ── 2) DISC FILL — tap the rising stem at each disc and fill the ring out to its rim (like a pipe) ──────
            float band = shelfProx * heightBand;            // 1 inside a sheet's band, reaching the AXIS; 0 in the gap
            float shelfMask = saturate(1.0 - rN) * band;    // in-silhouette weight within the band
            if (band > 1e-4)
            {
                // (a) Dwell + deflect: where the rising stem crosses a disc, slow it and redirect that flow OUTWARD —
                // like a jet hitting a plate. Reaches the core so the stem actually feeds the disc; mild + capped so
                // some still climbs to feed the discs above and the crown (lower discs fill first → wide base).
                // Ease outward push up from the axis (outDir is 0 AT the axis → a hard snap there would spike divergence).
                float offAxis = smoothstep(0.0, max(coreR, Rsil * 0.12), planar);
                float vUp = dot(v.xyz, axis);
                if (vUp > 0.0)
                {
                    // Gentle: only mildly slow the stem and redirect a little outward, so the stem→cap neck stays
                    // smooth instead of erupting into an outward umbrella jet that shears against the rising stem.
                    float dwell = min(1.0 - exp(-fo.flatten * pw * band * _Dt), 0.18);
                    v.xyz -= axis * (vUp * dwell);
                    v.xyz += outDir * (vUp * dwell * 0.5 * offAxis);
                }
                // (b) Active fill: push outward from the axis toward the rim (strong near centre, eases at the rim so
                // fume packs the whole ring instead of piling at the edge). This is the "fill the pipe" force.
                float fillRadial = saturate(1.0 - rN);
                v.xyz += outDir * (fo.strength * pw * band * (0.4 + 1.3 * fillRadial) * offAxis * _Dt);
                // (c) Settle / roll / twist / distort — only OUT on the disc (onShelf), so the stem core isn't frozen.
                float kConform = min(1.0 - exp(-fo.flatten * pw * shelfMask * onShelf * _Dt), 0.45);
                v.xyz -= axis * (dot(v.xyz, axis) * kConform);
                float3 rollDir = SafeNorm(outDir * -(axial - sheetZ) + axis * (planar - Rsil * 0.85));
                v.xyz += rollDir * (fo.roll * pw * shelfMask * onShelf * _Dt);
                v.xyz += tang * (fo.swirl * pw * shelfMask * _Dt);             // twist around the axis
                if (fo.distort > 1e-4)
                    v.xyz += BrazeCurlNoise(vp * max(fo.scale, 0.01 / max(_ResolutionScale, 1e-4)), 0.3, _Time * 0.5)
                           * (fo.distort * pw * shelfMask * onShelf * _Dt);
            }

            // ── 2b) SHEET SQUEEZE — evacuate the inter-disc gaps so each shelf reads as a distinct tier ──────────
            float inGap = gapMask * onShelf * heightBand;
            if (inGap > 1e-4)
            {
                // gently pull gap fume onto the nearest sheet plane (bounded so it never overshoots → no jitter)
                float kSq = min(1.0 - exp(-fo.flatten * pw * inGap * _Dt), 0.35);
                v.xyz += axis * (sheetZ - axial) * (kSq * 0.5);
            }

            // ── 3) CROWN SHELL — hug the domed crown surface and roll the cap over (the mushroom rollover) ───────
            float crownBand = 0.0;
            if (dome > 1e-4 && axial > halfSpan - H && planar < Rtop * 1.05)
            {
                crownBand = saturate(1.0 - abs(axial - crownSurf) / max(R * 0.32, H)) * saturate(1.2 - rN);
                if (crownBand > 1e-4)
                {
                    float kHug = min(1.0 - exp(-fo.flatten * pw * crownBand * _Dt), 0.3);   // softer → no stiff cap shell to ram
                    float nv = dot(v.xyz, crownN);
                    v.xyz -= crownN * nv * kHug;                                // fold fume onto the dome (both ways → round)
                    float3 tangOut = SafeNorm(outDir - axis * domeSlope);       // outward-and-down along the dome
                    v.xyz += tangOut * (fo.strength * pw * crownBand * (0.3 + 0.5 * suction) * _Dt);   // rollover spread
                    v.xyz += tang * (fo.swirl * pw * crownBand * _Dt);
                }
            }

            // ── 3b) RIM ROLLOVER RETURN — the crown rollover sends fume sliding DOWN the outside of the cap; catch
            // that falling curtain near/below the rim and curl it back INWARD (toward the chimney) so it recirculates
            // into the cap as a toroidal vortex instead of leaking out below the gizmo. Only acts on downward motion.
            float rollZone = seal * pw * smoothstep(0.78, 1.08, rN)
                           * saturate((halfSpan + H - axial) / max(halfSpan + H - botZ + R * 0.4, H));
            if (rollZone > 1e-4)
            {
                float vDown = dot(v.xyz, axis);                       // < 0 when fume is falling down the outside
                if (vDown < 0.0)
                {
                    float k = min(rollZone, 0.4);
                    v.xyz -= axis * vDown * k;                        // bleed off the fall (no downward push added)
                    v.xyz -= outDir * (-vDown) * (k * 0.8);          // curl it back inward → recirculate, don't leak
                }
            }

            // ── 4) SEAL — soft one-way containment: top lid + outer rim. Never restores fume downward. ─────
            float lidMask = 0.0;
            if (seal > 1e-4 && belowCrown < 0.0 && rN < 1.2)
            {
                float above = -belowCrown;
                lidMask = seal * pw * saturate(1.0 - above / max(R * 0.6, H));
                float nv = dot(v.xyz, crownN);
                if (nv > 0.0) v.xyz -= crownN * nv * min(lidMask, 0.4);         // only the escaping component
            }
            float hStack  = saturate(1.0 - max(max(axial - apexZ, botZ - axial), 0.0) / max(R * 0.3, H));
            float rimMask = seal * pw * smoothstep(0.85, 1.1, rN) * hStack;     // wider rim band → softer wall
            if (rimMask > 1e-4)
            {
                float radialV = dot(v.xyz, outDir);
                if (radialV > 0.0) v.xyz -= outDir * radialV * min(rimMask, 0.5);
                // Gentle restore (not a stiff spring — a hard one rings against advection → grid jitter).
                if (rN > 1.0)
                    v.xyz -= outDir * clamp((planar - Rsil) * 0.5, 0.0, _MaxSpeed * 0.05) * min(rimMask, 0.5);
            }

            // ── 5) HOLD + buoyancy — settle the shaped regions; the rising core keeps its natural lift ───────────
            // Settle (damp + drop buoyancy) on the discs AND in the gaps — so gaps empty onto the sheets. Excludes the rising core.
            float settle = max(max(shelfMask * onShelf, inGap), max(crownBand, max(lidMask, rimMask)));
            if (settle > 1e-4)
            {
                v.xyz *= 1.0 - min(1.0 - exp(-fo.hold * pw * settle * _Dt), 0.3);
                float buoyKill = min(1.0 - exp(-(fo.flatten * 0.02 + seal * 3.0 + fo.hold * 0.1) * settle * _Dt), 0.9);
                v.w *= 1.0 - buoyKill;                                          // trade lift for shaping where it settles
            }
            if (lidMask > 1e-4)                                                // stop the cap raining back down
            {
                float dn = dot(v.xyz, axis);
                if (dn < 0.0) v.xyz -= axis * dn * min(lidMask, 0.5);
            }

            a = 0;   // Disc writes velocity directly above
        }
        else if (t == 6)   // HOLD / CALM: spatial velocity damping → settle a region in place (keeps smoke put).
        {
            v.xyz *= 1.0 - saturate(fo.strength * fall * _Dt);      // 'a' stays 0; this is the whole effect
        }
        else if (t == 7)   // CAULI BILLOWS — broad divergence-free rolling cells inside the field; optional deposit
        {                  // is gated by existing fume. Size is a literal lobe diameter in voxels.
            float3 axis  = SafeNorm(fo.dir);                // CPU packs world-up in grid space for Cauli
            float  axial = dot(toV, axis);
            float3 inPln = toV - axial * axis;
            float  planar = length(inPln);
            float  mode  = fo.billowMode;                  // +1 up, 0 in-place, -1 down (set on the CPU)
            int3   cc    = int3(id);
            float4 fld   = _Fields[id];
            float  activity = saturate(max(fld.x, 0.0) + max(fld.y, 0.0) * 0.45);
            float  sizeVox = max(fo.billowScale, 1.0);      // literal lobe size sent by the CPU
            float  turnover = max(fo.billowSpeed, 0.0);     // literal lobe turnover rate; 0 freezes the force
            float  phase = _Time * turnover * 6.2831853;
            float  cellFreq = 6.2831853 / sizeVox;          // one broad cell per requested voxel size
            float  sizeT = saturate((sizeVox - 8.0) / 56.0);
            float3 refU = cross(axis, float3(0.0, 1.0, 0.0));
            refU = SafeNorm((dot(refU, refU) < 0.01) ? cross(axis, float3(1.0, 0.0, 0.0)) : refU);
            float3 refW = cross(axis, refU);
            float2 planeP = float2(dot(inPln, refU), dot(inPln, refW));
            float2 cellP = planeP * cellFreq;
            float  travelPhase = axial * cellFreq - phase * mode;
            float  columnA = BrazeWave(cellP.x + 3.1, cellP.y - 8.7, 0.0, phase * 0.17) * 0.5 + 0.5;
            float  columnB = BrazeWave(cellP.x * 1.85 - 19.0, cellP.y * 1.85 + 6.2, 11.0, phase * 0.23) * 0.5 + 0.5;
            float  columnMask = saturate(smoothstep(0.32, 0.8, columnA) + smoothstep(0.62, 0.94, columnB) * 0.35);
            float  wave = sin(travelPhase + columnA * 6.2831853 + columnB * 2.2) * 0.5 + 0.5;
            float  pulse = smoothstep(0.12, 0.96, wave);
            float  surfaceEnergy = lerp(1.0, pulse, saturate(abs(mode)));

            // 1) VORTICITY CONFINEMENT — push velocity to AMPLIFY the local vortex (the same operator as the global
            //    Swirl knob, scoped here to the field). _Curl holds last frame's vorticity (Force runs before Curl);
            //    the one-frame lag is harmless. This is what turns smeared smoke edges into rounded, nested lobes.
            //    SIZE: the vorticity gradient is sampled over a STENCIL of `s` voxels — bigger Size widens it so
            //    confinement targets larger-scale vortex cores → bigger lobes (a small stencil only crisps grid-scale
            //    noise, which is why low Size reads as fine churn). `s` is derived from the cell frequency below.
            int s = clamp((int)round(sizeVox * 0.5), 1, 32);
            float ml = length(_Curl[ClampC(cc - int3(s, 0, 0))].xyz), mr = length(_Curl[ClampC(cc + int3(s, 0, 0))].xyz);
            float md = length(_Curl[ClampC(cc - int3(0, s, 0))].xyz), mu = length(_Curl[ClampC(cc + int3(0, s, 0))].xyz);
            float mb = length(_Curl[ClampC(cc - int3(0, 0, s))].xyz), mf = length(_Curl[ClampC(cc + int3(0, 0, s))].xyz);
            float3 grad = float3(mr - ml, mu - md, mf - mb);
            float3 N    = grad / (length(grad) + 1e-5);
            float3 confine = cross(N, _Curl[id].xyz);      // sharpens the local roll; magnitude scales with vorticity

            // 2) SEED — low-frequency curl noise so smooth/laminar fluid gains vorticity for the confinement to grab
            //    (confinement does nothing in a vortex-free region). Scrolls with the mode so lobes climb/sink.
            float3 sp    = float3(cellP, travelPhase);
            float3 broadLocal = BrazeCurlNoise(sp, 0.35, phase);
            float3 smallLocal = BrazeCurlNoise(sp * 2.0 + 17.0, 0.35, phase * 1.37);
            float3 broad = refU * broadLocal.x + refW * (broadLocal.y * 0.45) + axis * broadLocal.z;
            float3 small = refU * smallLocal.x + refW * (smallLocal.y * 0.45) + axis * smallLocal.z;
            float3 churn = (broad + small * lerp(0.35, 0.06, sizeT))
                         * lerp(0.55, 1.35, columnMask)
                         * lerp(0.75, 1.35, surfaceEnergy);
            float  axialNoise = dot(churn, axis);

            // 3) TRANSPORT — a balanced axial roll bias. Up/Down scroll the pattern and bias local lobe faces, but
            //    the force remains near zero-mean across the field so the whole smoke body does not become an elevator.
            float  surfacePulse = columnMask * (pulse - 0.48);
            float3 climb = axis * mode * (axialNoise * 0.25 + surfacePulse)
                          * lerp(0.45, 0.85, sizeT);

            // Broad cell motion owns the visible lobe scale; confinement only helps existing smoke edges roll over.
            float3 bdir = confine * lerp(0.9, 0.12, sizeT)
                        + churn * lerp(0.85, 2.0, sizeT)
                        + climb;

            // Origin emphasis (centre ↔ rim) across the field radius; floored at 0.6 so nothing fully zeros out.
            float originW = 1.0;
            if (fo.radiusVox > 1e-3)
            {
                float rN    = planar / fo.radiusVox;
                float bEdge = smoothstep(0.2, 1.0, rN);
                float bCore = 1.0 - smoothstep(0.0, 0.9, rN);
                originW = lerp(0.6, 1.0, lerp(bCore, bEdge, saturate(fo.billowOrigin)));
            }

            // Vertical striation lines — break the boil into discrete columns (the radial fingers of a mushroom
            // underside). Pattern from the HORIZONTAL position (⊥ axis), held constant along the axis → true vertical
            // columns from any view (not azimuthal spokes that fan out). Finer Size → more, thinner columns.
            float lineMask = 1.0;
            if (fo.billowLines > 1e-3)
            {
                float2 pp   = cellP;
                float2 sway = BrazeCurlNoise(float3(pp * 0.3, axial * cellFreq * 0.12), 0.35, phase * 0.25).xy * 0.5;
                float  n    = BrazeCurlNoise(float3(pp + sway, 11.0), 0.35, 0.0).x * 0.5 + 0.5;
                float  lines = smoothstep(0.5, 0.85, n);
                lineMask = lerp(1.0, lines, saturate(fo.billowLines));
            }

            // Optional deposition: thickens/heats only the same existing fume the force is affecting. This is not a
            // free emitter; empty cells stay empty because the mask is gated by local smoke/heat activity.
            // The mask is cellular, not flat, so added fume lands as defined cauliflower lobes instead of milky fog.
            float smokeDeposit = max(fo._forcePad.x, 0.0);
            float fireDeposit  = max(fo._forcePad.y, 0.0);
            if (smokeDeposit + fireDeposit > 1e-5)
            {
                float lobeCore = smoothstep(0.42, 0.82, columnA);
                float lobeRim = 1.0 - smoothstep(0.08, 0.24, abs(columnA - 0.55));
                float nested = smoothstep(0.5, 0.86, columnB) * lobeCore;
                float smokeCell = saturate((lobeCore * 0.75 + lobeRim * 0.45 + nested * lerp(0.15, 0.45, sizeT))
                                         * lerp(0.8, 1.3, surfaceEnergy));
                float fireCell = smoothstep(0.62, 0.92, columnA) * lerp(0.65, 1.0, columnB) * surfaceEnergy;
                float depositBase = fall * originW * lineMask * saturate(activity * 2.0);
                float smokeMask = depositBase * smokeCell;
                float fireMask = depositBase * fireCell;
                float4 dep = _Fields[id];
                dep.x += (smokeDeposit * smokeMask + fireDeposit * 0.06 * fireMask) * _Dt;
                dep.y += fireDeposit * 4.5 * fireMask * _Dt;
                dep.z += fireDeposit * 2.8 * fireMask * _Dt;
                dep.w += fireDeposit * 1.1 * fireMask * _Dt;
                _Fields[id] = max(dep, 0.0);
            }

            // Clamp the spike (a hot lobe must not blow the CFL limit), then hand it to the shared falloff-scaled add.
            float pl = length(bdir);
            if (pl > 2.5) bdir *= 2.5 / pl;
            a = bdir * (fo.billowStrength * originW * lineMask * activity * turnover);
        }
        else if (t == 8)   // LIFT — raise whatever fluid is in the field UP toward a target rise speed (an updraft).
        {
            // Acts only where fluid actually exists, and drives the VERTICAL velocity toward the target (grid +Y)
            // one-directionally: it lifts slow/sinking smoke up to the target but never brakes smoke already rising
            // faster. Negative Strength flips it into a downdraft (e.g. model the rotor downwash itself).
            float presence = saturate(_Fields[id].x * 4.0);    // gate by local density/smoke
            float dv = fo.strength - v.y;                      // strength = target vertical speed (vox/s), signed
            float push = (fo.strength >= 0.0) ? max(dv, 0.0) : min(dv, 0.0);
            a = float3(0.0, push * max(fo.scale, 0.01) * presence, 0.0);   // scale = Response (1/s); fall scopes the area
        }
        else if (t == 9)   // JET — drive fluid in the field to a target speed ALONG the force's forward axis (aimable).
        {
            // Same one-directional target-velocity model as Lift, but along fo.dir (this transform's forward) instead
            // of grid-up: it ramps fluid up to the target speed along the aim and never brakes fluid already moving
            // faster that way. Negative Strength jets backward along the axis.
            float3 axis = SafeNorm(fo.dir);
            float presence = saturate(_Fields[id].x * 4.0);    // gate by local density/smoke
            float along = dot(v.xyz, axis);                    // current speed along the aim
            float dv = fo.strength - along;                    // strength = target speed along the axis (vox/s), signed
            float push = (fo.strength >= 0.0) ? max(dv, 0.0) : min(dv, 0.0);
            a = axis * (push * max(fo.scale, 0.01) * presence);   // scale = Response (1/s); fall scopes the area
        }
        else if (t == 10)  // SPINNER — solid-body rotation: grip the fume and spin it about the axis like a tyre.
        {
            // Vortex ADDS a constant tangential push → fume keeps accelerating, flings outward, escapes into ever-
            // larger swirls. The Spinner instead DRIVES velocity toward a rigid wheel field (v = ω × r): the rim
            // moves fast, the hub barely turns, gripped fume circles in place. The three knobs are orthogonal —
            // each damps/drives one axis of the local cylindrical frame: Grip→tangential, Contain→radial, Flatten→axial.
            float3 axis   = SafeNorm(fo.dir);
            float  axial  = dot(toV, axis);
            float3 inPln  = toV - axial * axis;                  // radial offset in the wheel plane (voxels)
            float  planar = length(inPln);
            float3 radial = (planar > 1e-4) ? inPln / planar : 0.0;
            float3 tang   = cross(axis, radial);                 // right-hand tangent about the axis
            float  omega  = fo.strength;                         // signed angular rate (rad/s)

            float presence = saturate(_Fields[id].x * 4.0);      // only grip where fume actually is (capture the smoke)
            float vtang = dot(v.xyz, tang);
            float vrad  = dot(v.xyz, radial);
            float vax   = dot(v.xyz, axis);

            a += tang   * ((omega * planar - vtang) * fo._forcePad.x * presence);  // GRIP: lock spin to solid body (no fling-out)
            a += -radial * (vrad * fo._forcePad.y * presence);                     // CONTAIN: damp radial drift → stay in the wheel
            a += -axis  * (vax  * fo.swirl       * presence);                      // FLATTEN: damp axial drift → stay in plane
        }

        // The FORCE FIELD is purely an AREA: its shape + falloff (fall, computed above) scope how strongly this one
        // force acts at each voxel. It adds NO push of its own — the only force here is the type's own acceleration.
        v.xyz += a * fall * _Dt;
    }

    // Emitter buoyancy — temperature-driven lift at FULL strength (raw temp − a small soot drag), matching the
    // proven base. Hot gas rises wherever the heat went; applied pre-projection so the pressure solve rolls it
    // into a natural plume. Coefficient is the emitter's Buoyancy knob (relayed). NOT saturated — that cap was
    // making the lift ~4× too weak.
    // Per-emitter buoyancy: the coefficient rides with each emitter's gas in v.w (blended at Emit, advected in
    // AdvectVel) — emitters do NOT share one global buoyancy, so no cross-talk. Temperature-driven lift; the sign
    // of the coefficient sets rise (+) vs sink (−). No soot-weight term, so cooled smoke just stops rising instead
    // of being slammed down (that old global term was the cause of plumes "falling like gravity" at high buoyancy).
    // CFD adds a DOMAIN-WIDE buoyancy coefficient on top of the per-emitter channel: heat that entered through
    // an inlet patch has no emitter and therefore carries v.w = 0 — without this term, inlet-heated air never
    // rises at all. Fire passes _CfdThermalBuoyancy = 0, keeping the per-emitter path byte-identical.
    float buoy = max(_Fields[id].y, 0.0) * (v.w + _CfdThermalBuoyancy);
    // INSTABILITY: perturb the lift spatially (and slowly in time) so the rising front is lumpy. A non-uniform
    // vertical force has ∂F/∂x ≠ 0, which IS horizontal vorticity → the front rolls up into mushroom caps /
    // cauliflower (Rayleigh–Taylor), the seed a clean symmetric blast otherwise lacks. The multiplier is ZERO-MEAN
    // (mean ≈ 1, since the noise is zero-mean): it only REDISTRIBUTES lift, it does NOT add net vertical force — so
    // instability sharpens the shape without making the blast rise harder. Stays positive for _Instability ≤ 1
    // (|noise| ≲ 0.9), so no clip is needed and the average lift is exactly preserved.
    if (_Instability > 0.0)
    {
        float n = BrazeWave(vp.x * _InstabScale, vp.y * _InstabScale, vp.z * _InstabScale, _Time * 0.6);  // ~[-0.9,0.9], zero-mean
        buoy *= max(0.0, 1.0 + _Instability * n);
    }
    v.y += buoy * _Dt;

    // Emitter drag / settle — QUADRATIC (speed-proportional) drag, like real aerodynamic drag (force ∝ v²).
    // Crucially this hits FAST/wild motion hard but barely touches gentle drift, so it tames a blast's spike
    // WITHOUT making the calm motion inert (a linear v*=exp(-k·dt) decay killed slow and fast alike). Stable:
    // the divisor is always ≥ 1, so velocity only ever shrinks. Runs over the active plume.
    if (_CfdLinearDrag > 0.0)
        v.xyz *= exp(-_CfdLinearDrag * _Dt);   // CFD: literal 1/s damping, independent of grid resolution.
                                               // The quadratic form below acts on VOXEL speed, so the same
                                               // physical airflow drags harder at higher grid resolution.
    else if (_Drag > 0.0)
        v.xyz /= (1.0 + _Drag * length(v.xyz) * _Dt);

    // Velocity limit (CFL guard) — applied after every velocity-modifying stage.
    float sp = length(v.xyz);
    if (sp > _MaxSpeed) v.xyz *= _MaxSpeed / sp;
    _Vel[id] = v;
}

// Voxelize analytical obstacle primitives into the solid mask. Static obstacles (velocity 0).
[numthreads(4, 4, 4)]
void MarkSolids(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_SolidDispatchSize)) return;
    uint3 id = (uint3)_SolidDispatchMin + tid;
    if (Oob(id)) return;
    float3 vp = float3(id) + 0.5;
    float s = 0.0;
    for (int i = 0; i < _ObstacleCount; i++)
    {
        Obstacle o = _Obstacles[i];
        int shape = (int)round(o.shape);
        float3 delta = vp - o.posVox;
        bool inside = false;
        if (shape == 0)
        {
            inside = dot(delta, delta) <= o.radiusVox * o.radiusVox;
        }
        else
        {
            float3 local = QuatRot(float4(-o.rot.xyz, o.rot.w), delta);
            float radius = max(o.radiusVox, 0.0);
            if (shape == 1) // oriented box
            {
                inside = all(abs(local) <= o.halfExtentVox);
            }
            else if (shape == 2) // finite local-Y cylinder
            {
                inside = dot(local.xz, local.xz) <= radius * radius
                      && abs(local.y) <= o.halfExtentVox.y;
            }
            else if (shape == 3) // cone: base at -Y, point at +Y
            {
                float halfHeight = max(o.halfExtentVox.y, 1e-4);
                float radiusAtY = radius * saturate((halfHeight - local.y) / (2.0 * halfHeight));
                inside = abs(local.y) <= halfHeight
                      && dot(local.xz, local.xz) <= radiusAtY * radiusAtY;
            }
            else if (shape == 4) // capsule: local-Y line segment swept by radius
            {
                float lineHalf = max(o.halfExtentVox.y - radius, 0.0);
                float3 nearest = float3(0.0, clamp(local.y, -lineHalf, lineHalf), 0.0);
                float3 d = local - nearest;
                inside = dot(d, d) <= radius * radius;
            }
            else // torus: local-Y axis; radiusVox major, halfExtentVox.x minor/tube radius
            {
                float minor = max(o.halfExtentVox.x, 0.0);
                float2 q = float2(length(local.xz) - radius, local.y);
                inside = dot(q, q) <= minor * minor;
            }
        }
        if (inside) { s = 1.0; break; }
    }
    _Solid[id] = s;
}

// Change-driven CFD boundary merge. The downsampled signed-distance bake is filtered into the solver's existing
// full-resolution solid mask once per boundary edit; pressure kernels then read that resident coverage texture.
[numthreads(4, 4, 4)]
void ApplyCfdSdf(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    float3 uvw = (float3(id) + 0.5) / float3(_Res);
    float sdf = _CfdSignedDistance.SampleLevel(sampler_linear_clamp, uvw, 0.0);
    // Cell-volume coverage: 0 outside, 1 inside, linear across one full-resolution cell. The persistent RHalf
    // solid mask therefore carries enough sub-voxel information for the CFD pressure kernels without retaining
    // or sampling the SDF itself during simulation ticks.
    float coverage = saturate(0.5 - sdf / max(_CfdCellWorldSize, 1e-6));
    _Solid[id] = max(_Solid[id], coverage);
}

[numthreads(4, 4, 4)]
void Divergence(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    if (IS_SOLID(c)) { _Div[id] = 0.0; _Pressure[id] = 0.0; return; }
    // Solid neighbour → zero flux through that face (static obstacle velocity = 0).
    float xr = IS_SOLID(c + int3(1, 0, 0)) ? 0.0 : _Vel[ClampC(c + int3(1, 0, 0))].x;
    float xl = IS_SOLID(c - int3(1, 0, 0)) ? 0.0 : _Vel[ClampC(c - int3(1, 0, 0))].x;
    float yu = IS_SOLID(c + int3(0, 1, 0)) ? 0.0 : _Vel[ClampC(c + int3(0, 1, 0))].y;
    float yd = IS_SOLID(c - int3(0, 1, 0)) ? 0.0 : _Vel[ClampC(c - int3(0, 1, 0))].y;
    float zf = IS_SOLID(c + int3(0, 0, 1)) ? 0.0 : _Vel[ClampC(c + int3(0, 0, 1))].z;
    float zb = IS_SOLID(c - int3(0, 0, 1)) ? 0.0 : _Vel[ClampC(c - int3(0, 0, 1))].z;
    // Emitter gas expansion: combustion releases heat → the gas EXPANDS, pushing outward from each source.
    // Subtracting it from the divergence RHS makes the projected field carry +expansion divergence
    // (∇·v_new = expansion), turning a buoyant plume into a source-local burst.
    float4 fld = _Fields[id];
    float3 vp = float3(id) + 0.5;
    float expansion = 0.0;
    for (int i = 0; i < _EmitterCount; i++)
    {
        Emitter e = _Emitters[i];
        // Gas pressure burst: combustion-driven outward expansion (gated by ignition / hot smoke).
        if (e.gasPressureBurst > 0.0)
            expansion += e.gasPressureBurst * EmitterGasSource(e, vp, fld);
        // Radial motion as a divergence source so it SURVIVES the projection. Outward (+) expands, inward (−)
        // compresses; shaped by the emitter footprint so the push is source-local like the rest of Motion/*.
        if (abs(e.motionRadial) > 1e-5)
            expansion += e.motionRadial * EmitterContribution(e, vp, 1.0) * RADIAL_DIV_GAIN;
    }
    _Div[id] = 0.5 * ((xr - xl) + (yu - yd) + (zf - zb)) - expansion;
    // Do NOT clear pressure here: RBGS is intentionally warm-started across cadence/trickle frames. Pressure is
    // initialized once and cleared when bricks retire, so a newly-active brick still begins from a clean zero.
}

// Reconstruct the domain cell a face-layer thread addresses. tid.xy walks the patch's in-plane cell window,
// tid.z (group z) selects the boundary. The inside test defers to CfdBoundaryContainsCell so face-layer
// dispatches honour the patch SHAPE exactly like the per-neighbour pressure/coverage lookups do.
bool CfdFaceCell(CfdBoundary boundary, uint2 patchThread, out int3 c)
{
    int face = (int)round(boundary.face);
    float2 center = face <= 1 ? boundary.centerVox.yz
                  : face <= 3 ? boundary.centerVox.xz
                              : boundary.centerVox.xy;
    // Window = the ROTATED cross-section's axis-aligned bounding box, so a spun rectangle/slot is fully covered.
    float2 bound = abs(cos(boundary.rotation)) * boundary.halfSizeVox
                 + abs(sin(boundary.rotation)) * boundary.halfSizeVox.yx;
    int2 lo = (int2)ceil(center - bound - 0.5);
    int2 uv = lo + (int2)patchThread;
    if (face <= 1)      c = int3(face == 0 ? 0 : _Res.x - 1, uv.x, uv.y);
    else if (face <= 3) c = int3(uv.x, face == 2 ? 0 : _Res.y - 1, uv.y);
    else                c = int3(uv.x, uv.y, face == 4 ? 0 : _Res.z - 1);
    return !OutsideRes(c) && CfdBoundaryContainsCell(boundary, c);
}

// Face-layer boundary application: one thread per patch-covered cell instead of a full-domain sweep. The former
// 3D kernel launched every active brick to touch a one-voxel face layer — two full-grid passes per tick for a
// 2D condition. Overlapping same-face patches write last-dispatch-wins instead of the old loop order; authoring
// overlapping patches on one face was already unsupported.
[numthreads(8, 8, 1)]
void ApplyCfdBoundariesFace(uint3 tid : SV_DispatchThreadID)
{
    if ((int)tid.z >= _CfdBoundaryCount) return;
    CfdBoundary boundary = _CfdBoundaries[tid.z];
    int3 c;
    if (!CfdFaceCell(boundary, tid.xy, c)) return;
    if (CfdFluidFractionAt(c) <= 1e-3) return;

    uint3 id = (uint3)c;
    float4 velocity = _Vel[id];
    float4 field = _Fields[id];
    if (boundary.mode < 0.5)
    {
        float dyeVariation = 1.0;
        float3 inletFluctuation = float3(0.0, 0.0, 0.0);
        if (_CfdInletTurbulence > 1e-5 || boundary.inletSmokePattern > 2.5)
            inletFluctuation = CfdInletFluctuation(boundary, c, dyeVariation);
        velocity.xyz = boundary.velocityVox + inletFluctuation *
                       (length(boundary.velocityVox) * _CfdInletTurbulence);
        if (boundary.inletTemperature >= 0.0) field.y = boundary.inletTemperature;
        if (boundary.inletSmokeDensity >= 0.0)
            field.x = boundary.inletSmokeDensity * CfdSmokePatternMask(boundary, c, dyeVariation);
    }
    else if (boundary.preventBackflow > 0.5)
    {
        float3 outward = CfdFaceOutward((int)round(boundary.face));
        float outwardSpeed = dot(velocity.xyz, outward);
        if (outwardSpeed < 0.0) velocity.xyz -= outward * outwardSpeed;
    }
    _Vel[id] = velocity;
    _Fields[id] = field;
}

[numthreads(1, 1, 1)]
void ClearCfdFlux(uint3 id : SV_DispatchThreadID)
{
    _CfdFluxTotals[0] = 0;
    _CfdFluxTotals[1] = 0;
}

// Face-layer volume-flow reduction (one thread per patch-covered cell; see ApplyCfdBoundariesFace).
[numthreads(8, 8, 1)]
void MeasureCfdFluxFace(uint3 tid : SV_DispatchThreadID)
{
    if ((int)tid.z >= _CfdBoundaryCount) return;
    CfdBoundary boundary = _CfdBoundaries[tid.z];
    int3 c;
    if (!CfdFaceCell(boundary, tid.xy, c)) return;
    float fluid = CfdFluidFractionAt(c);
    if (fluid <= 1e-3) return;

    float3 velocity = _Vel[(uint3)c].xyz;
    float3 outward = CfdFaceOutward((int)round(boundary.face));
    float signedSpeed = boundary.mode < 0.5 ? dot(velocity, -outward) : dot(velocity, outward);
    float volumeFlow = max(signedSpeed, 0.0) * max(boundary.cellVolumeWorld, 0.0) * fluid;
    int fixedFlow = (int)round(min(volumeFlow, 100000.0) * 4096.0);
    if (fixedFlow > 0) InterlockedAdd(_CfdFluxTotals[boundary.mode < 0.5 ? 0 : 1], fixedFlow);
}

[numthreads(1, 1, 1)]
void ClearCfdSurfaceLoad(uint3 id : SV_DispatchThreadID)
{
    _CfdSurfaceLoad[0] = 0;
    _CfdSurfaceLoad[1] = 0;
    _CfdSurfaceLoad[2] = 0;
    _CfdSurfaceLoad[3] = 0;
}

// Dense reduction over the body's voxel AABB (+margin) instead of a full-domain brick sweep. The window is
// supplied by the SDF bake; the kernel runs only on the diagnostic readback cadence, not every solver tick.
[numthreads(4, 4, 4)]
void MeasureCfdSurfaceLoadWindow(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_CfdLoadSize)) return;
    uint3 id = (uint3)(_CfdLoadMin + int3(tid));
    if (Oob(id)) return;
    int3 c = int3(id);
    float fluid = CfdFluidFractionAt(c);
    if (fluid <= 1e-3) return;

    int3 cl = c - int3(1, 0, 0), cr = c + int3(1, 0, 0);
    int3 cd = c - int3(0, 1, 0), cu = c + int3(0, 1, 0);
    int3 cb = c - int3(0, 0, 1), cf = c + int3(0, 0, 1);
    float fl = CfdFluidFractionAt(cl), fr = CfdFluidFractionAt(cr);
    float fd = CfdFluidFractionAt(cd), fu = CfdFluidFractionAt(cu);
    float fb = CfdFluidFractionAt(cb), ff = CfdFluidFractionAt(cf);

    // The fraction gradient points from this fluid sample into the nearby solid. Pressure acting on the
    // solid follows that direction. Weight cut cells by gradient magnitude so an axis-aligned one-cell face
    // contributes once while fractional SDF coverage transitions remain smooth.
    float3 intoSolid = float3(fl - fr, fd - fu, fb - ff);
    float gradientMagnitude = length(intoSolid);
    if (gradientMagnitude <= 1e-4) return;
    float3 normal = intoSolid / gradientMagnitude;
    float surfaceWeight = saturate(gradientMagnitude);
    float faceArea = dot(abs(normal), max(_CfdCellFaceArea, 0.0));
    float3 relativeLoad = _Pressure[id] * normal * faceArea * surfaceWeight;

    int3 fixedLoad = int3(round(clamp(relativeLoad, -100000.0, 100000.0) * 4096.0));
    InterlockedAdd(_CfdSurfaceLoad[0], fixedLoad.x);
    InterlockedAdd(_CfdSurfaceLoad[1], fixedLoad.y);
    InterlockedAdd(_CfdSurfaceLoad[2], fixedLoad.z);
}

[numthreads(1, 1, 1)]
void ClearCfdTemperaturePeak(uint3 id : SV_DispatchThreadID)
{
    _CfdTemperaturePeak[0] = 0u;
}

// Presentation-only diagnostic over the field selected by C#: the render-conditioned volume for 3D presentation,
// or the raw transported field for an Analysis Slice. It never feeds the simulation. Interior solid cells are
// excluded so a heater authored through an SDF cannot set the scale from a physically inaccessible value.
[numthreads(4, 4, 4)]
void MeasureCfdTemperaturePeak(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    if (_CfdFractionalSolids != 0 && CfdInteriorCoverage(int3(id)) >= 0.999) return;
    uint fixedTemperature = (uint)round(min(max(_Fields[id].y, 0.0), 65535.0) * 4096.0);
    InterlockedMax(_CfdTemperaturePeak[0], fixedTemperature);
}

[numthreads(1, 1, 1)]
void ClearCfdRefPressure(uint3 id : SV_DispatchThreadID)
{
    // Slots 0..2 are this-tick reduction scratch. Slot 3 is the persistent measured-stagnation attenuation
    // and deliberately survives this clear; FinalizeCfdPressureCalibration updates it after both reductions.
    _CfdRefPressure[0] = 0;
    _CfdRefPressure[1] = 0;
    _CfdRefPressure[2] = 0;
}

// Ambient reference for the Cp overlay. Incompressible pressure is defined only up to a constant, and the
// realtime solve's residual error is a DOMAIN-SCALE mode that varies along the tunnel — an inlet-face tap
// cancelled only the uniform part (and sat in the synthetic-turbulence zone, adding its own wobble), so the
// body still cycled. The domain-wide fluid mean instead measures that large-scale mode AT the body's station:
// the mean of a linear mode equals its value at the domain centre. Stride-8 lattice of pure-fluid cells. Scale
// into theoretical Cp units BEFORE the integer reduction so world/grid scale cannot overflow it; ×256 fixed point
// with a ±250 clamp keeps the worst-case 32k-sample sum inside int32. Interior-only coverage means this kernel
// never touches out-of-range cells and must not reference _CfdBoundaries.
[numthreads(4, 4, 4)]
void MeasureCfdRefPressure(uint3 tid : SV_DispatchThreadID)
{
    int3 c = int3(tid) * 8 + 4;
    if (any(c >= _Res)) return;
    if (CfdInteriorCoverage(c) > 0.001) return;   // pure fluid only: cut cells and pinned interiors would bias
    float tapPressure = clamp(_Pressure[(uint3)c] * _CfdPressureVisScale, -250.0, 250.0);
    uint ignored;
    InterlockedAdd(_CfdRefPressure[0], (int)round(tapPressure * 256.0), ignored);
    InterlockedAdd(_CfdRefPressure[1], 1, ignored);
}

// Body Contact dye (smoke pattern 4): continuous surface release replacing inlet injection. Seeds passive dye
// into the fractional surface shell where air moves along the body, like the smoke-wand/surface-oil technique in
// a real tunnel — the boundary layer, separation, and wake visualize themselves while the freestream stays clear.
// Windowed to the body AABB (static bake ∪ animated bodies) and dispatched after Decay, so the seed is intact for
// the render-field build. max() write, not +=: the release rate is frame-rate independent (advection thins the
// shell, the seed tops it back up). Uses CfdInteriorCoverage — no _CfdBoundaries reference, the window is interior.
[numthreads(4, 4, 4)]
void CfdSeedContactDye(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_CfdLoadSize)) return;
    uint3 id = (uint3)(_CfdLoadMin + int3(tid));
    if (Oob(id)) return;
    float coverage = CfdInteriorCoverage(int3(id));
    // Fractional SDF coverage transitions over ~1-2 voxels; this band IS the surface shell. Mostly-solid cut
    // cells are excluded so dye never glows through the body from inside.
    if (coverage < 0.02 || coverage > 0.9) return;
    float speed = length(_Vel[id].xyz);
    // Release scales with local air speed relative to the inlet: attached fast flow and separating shear layers
    // shed dye, stagnation zones stay clear. Half-freestream already reaches full release.
    float weight = (1.0 - coverage) * saturate(speed * _CfdContactDye.y * 2.0);
    if (weight <= 1e-4) return;
    float4 f = _Fields[id];
    f.x = max(f.x, _CfdContactDye.x * weight);
    _Fields[id] = f;
}

[numthreads(4, 4, 4)]
void DivergenceCfd(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    float fluid = CfdFluidFractionAt(c);
    if (fluid <= 1e-3) { _Div[id] = 0.0; _Pressure[id] = 0.0; return; }

    int3 cr = c + int3(1, 0, 0), cl = c - int3(1, 0, 0);
    int3 cu = c + int3(0, 1, 0), cd = c - int3(0, 1, 0);
    int3 cf = c + int3(0, 0, 1), cb = c - int3(0, 0, 1);
    float fl = CfdFluidFractionAt(cl), fr = CfdFluidFractionAt(cr);
    float fd = CfdFluidFractionAt(cd), fu = CfdFluidFractionAt(cu);
    float fb = CfdFluidFractionAt(cb), ff = CfdFluidFractionAt(cf);
    float wl = min(fluid, fl), wr = min(fluid, fr);
    float wd = min(fluid, fd), wu = min(fluid, fu);
    float wb = min(fluid, fb), wf = min(fluid, ff);
    float xr = _Vel[ClampC(cr)].x * wr;
    float xl = _Vel[ClampC(cl)].x * wl;
    float yu = _Vel[ClampC(cu)].y * wu;
    float yd = _Vel[ClampC(cd)].y * wd;
    float zf = _Vel[ClampC(cf)].z * wf;
    float zb = _Vel[ClampC(cb)].z * wb;

    float4 fld = _Fields[id];
    float3 vp = float3(id) + 0.5;
    float expansion = 0.0;
    for (int i = 0; i < _EmitterCount; i++)
    {
        Emitter e = _Emitters[i];
        if (e.gasPressureBurst > 0.0)
            expansion += e.gasPressureBurst * EmitterGasSource(e, vp, fld);
        if (abs(e.motionRadial) > 1e-5)
            expansion += e.motionRadial * EmitterContribution(e, vp, 1.0) * RADIAL_DIV_GAIN;
    }
    _Div[id] = 0.5 * ((xr - xl) + (yu - yd) + (zf - zb)) - expansion * fluid;
}

bool OccOob(uint3 id) { return any(id >= (uint3)_OccRes); }

[numthreads(4, 4, 4)]
void ClearOcc(uint3 id : SV_DispatchThreadID)
{
    if (OccOob(id)) return;
    _Occ[id] = _CfdFullDomainOccupancy != 0 ? OCC_SCALAR_CONTENT : 0.0;
    if (id.x == 0 && id.y == 0 && id.z == 0)
    {
        _ActiveCount[0] = 0;
        _ActiveCount[1] = 0;
        _ActiveCount[2] = 0;
    }
}

// Content test shared by the indirect (live) and dense (static-bake) mark passes. Cull bricks holding only
// invisible residue: density and burn are visible directly; fuel is invisible unless the cell is hot enough
// to ignite, and otherwise decays so slowly that it can pin the whole grid active long after the effect is
// gone. Ignored cells are cleared by the empty-brick advection path.
void MarkOccContent(uint3 id, bool markAdvectionSweep)
{
    float4 f = _Fields[id];
    float firePotential = IgnitionResponse(f.y) * f.z;
    if (f.x > _OccThreshold ||
        f.w > _OccThreshold ||
        firePotential > _OccThreshold * 4.0 ||
        (_CfdThermalOccupancy != 0 && abs(f.y) > _OccThreshold))
    {
        _Occ[id / BRICK_U] = 1.0;   // same-value write, race-free

        // The uniform guard keeps the common low/ordinary-speed path identical to the original mark pass:
        // no velocity texture read and no extra occupancy writes unless the configured tick can cross a brick.
        if (markAdvectionSweep && _AdvectionSweep != 0)
        {
            // A fixed one-brick halo only covers four voxels of TOTAL travel. Advection substeps improve CFL
            // accuracy but reuse the same active list, so a fast parcel could reach the halo edge after substep one
            // and freeze into a 4^3 slab. Mark a sparse chain along its full-tick velocity before dilation. Adjacent
            // marks are at most two bricks apart; the ordinary one-brick 3D dilation below joins their halos.
            float3 travel = _Vel[id].xyz * max(_Dt, 0.0);
            float maxTravel = max(abs(travel.x), max(abs(travel.y), abs(travel.z)));
            if (maxTravel > (float)BRICK_U)
            {
                int sweepSegments = min((int)ceil(maxTravel / ((float)BRICK_U * 2.0)), 32);
                [loop] for (int s = 1; s <= sweepSegments; s++)
                {
                    float t = s / (float)sweepSegments;
                    int3 sweptCell = int3(floor(float3(id) + 0.5 + travel * t));
                    if (all(sweptCell >= 0) && all(sweptCell < _Res))
                        _Occ[(uint3)sweptCell / BRICK_U] = 1.0;
                }
            }
        }
    }
}

// Content scan, INDIRECT over LAST step's active bricks (the args/list are rebuilt by DilateOcc/WriteArgs
// AFTER this runs). Exact: fields are provably 0 outside last step's dilated halo — writers only touch
// marked bricks, and retired bricks are zeroed each step — so scanning the whole grid (~134 MB of reads at
// 256³) found content nowhere else anyway. Emitter footprints are marked by MarkEmitterOcc (per-emitter
// AABB dispatch), not here.
[numthreads(BRICK, BRICK, BRICK)]
void MarkOcc(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    MarkOccContent(id, true);
}

// Dense content scan for paths where content can exist ANYWHERE (an external dense field write —
// BakeStaticVolume). The live Step never needs this.
[numthreads(4, 4, 4)]
void MarkOccDense(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    MarkOccContent(id, false);
}

// Emitter footprint marks: one small dispatch per emitter over its brick-conservative voxel AABB (CPU-computed
// as 1.35·(radius + |halfExtent|) + 1 voxels — a superset of every shape's falloff support at any rotation),
// evaluating the EXACT per-voxel contribution the old dense loop used. Identical marks, without running the
// per-voxel × per-emitter shape math over the entire grid.
int  _MarkEmitterIndex;
int3 _MarkAabbMin;    // voxel-space AABB min (inclusive, pre-clamped on CPU)
int3 _MarkAabbSize;   // voxels per axis
[numthreads(4, 4, 4)]
void MarkEmitterOcc(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_MarkAabbSize)) return;
    int3 c = _MarkAabbMin + int3(tid);
    if (any(c < 0) || any(c >= _Res)) return;
    Emitter e = _Emitters[_MarkEmitterIndex];
    float3 vp = float3(c) + 0.5;
    if (EmitterContribution(e, vp, 1.0) > 0.0)
    {
        // Scalar emitters get the ordinary content mark even for a tiny animated ramp, so sub-cull values can
        // accumulate without popping. Once channels are exactly zero, motion/gas still keeps the solve alive but
        // no longer prevents sub-threshold scalar residue from taking the normal visual retirement path.
        float mark = any(e.channels > 0.0) ? OCC_SCALAR_CONTENT : OCC_MOTION_ONLY;
        uint3 brick = (uint3)c / BRICK_U;
        _Occ[brick] = max(_Occ[brick], mark); // preserves a prior content mark; overlapping writes converge upward
    }
}

// NOTE on the emitter footprint (now MarkEmitterOcc above): emission is injected AFTER advection so fire is
// born at the source instead of at an advected offset — the footprint must be marked pre-DilateOcc so the
// sparse solve visits newly emitting bricks the same frame. The "drive" gate (activate for ANY emitter that
// does something: channels OR motion OR gas — a pure air-mover still needs its bricks solved) moved to the
// CPU, which skips the whole per-emitter dispatch when drive <= 0.

[numthreads(64, 1, 1)]
void MarkPointOcc(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= (uint)_PointCount) return;
    PointSource p = _PointSources[tid.x];
    if (p.channels.x + p.channels.y + p.channels.z <= 0.0) return;
    int3 c = int3(floor(p.posVox));
    if (any(c < 0) || any(c >= _Res)) return;
    _Occ[(uint3)c / BRICK_U] = 1.0;
}

// ── GPU surface-coverage emission ─────────────────────────────────────────────────────────────
// One thread per WELDED vertex: coverage test (reach vs front) + live-skinned position fetch +
// atomic channel splat into the cell accumulator. Also brick-marks _Occ (same-value write, race-
// free) so the sparse solve visits newly covered bricks this frame. Runs between MarkOcc and
// DilateOcc so splatted bricks get the halo + land in the indirect args.
[numthreads(64, 1, 1)]
void SurfSplat(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= (uint)_SurfWeldedCount) return;
    float r = _SurfReach[tid.x];
    if (r > _SurfFront || r > 1e30) return;                    // uncovered (+inf encodes unreached)
    if (_SurfBandMin >= 0.0 && r < _SurfBandMin) return;       // behind the leading edge (front-only)

    int raw = _SurfWeldRep[tid.x];
    float3 lp = asfloat(_SurfVerts.Load3((uint)(raw * _SurfStride + _SurfPosOffset)));
    float3 wp = mul(_SurfLocalToWorld, float4(lp, 1.0)).xyz;
    float3 v  = mul(_WorldToVoxelM, float4(wp, 1.0)).xyz;
    int3 c = int3(floor(v));
    if (any(c < 0) || any(c >= _Res)) return;

    uint cell = (uint)(c.x + c.y * _Res.x + c.z * _Res.x * _Res.y) * 3u;
    uint3 q = (uint3)(max(_SurfChannels, 0.0) * SURF_FP);
    if (q.x > 0u) InterlockedAdd(_SurfAccum[cell + 0u], q.x);
    if (q.y > 0u) InterlockedAdd(_SurfAccum[cell + 1u], q.y);
    if (q.z > 0u) InterlockedAdd(_SurfAccum[cell + 2u], q.z);
    _Occ[(uint3)c / BRICK_U] = 1.0;
}

// Fold the splat accumulator into the fields over the ACTIVE bricks (indirect, like Decay), then
// zero the consumed cells so the accumulator is clean for the next step (splatted bricks are always
// active: SurfSplat marks them before DilateOcc). Mirrors EmitPoints' additive channels-x-dt inject;
// surface sources carry no velocity/buoyancy (statics pass zero on the CPU path too).
void SurfEmitFoldBody(uint3 gid, uint3 gtid)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    uint cell = (id.x + id.y * (uint)_Res.x + id.z * (uint)(_Res.x * _Res.y)) * 3u;
    uint3 q = uint3(_SurfAccum[cell + 0u], _SurfAccum[cell + 1u], _SurfAccum[cell + 2u]);
    if ((q.x | q.y | q.z) == 0u) return;
    _SurfAccum[cell + 0u] = 0u; _SurfAccum[cell + 1u] = 0u; _SurfAccum[cell + 2u] = 0u;
    float4 f = _Fields[id];
    f.xyz += (float3(q) / SURF_FP) * _Dt;
    _Fields[id] = f;
}

[numthreads(BRICK, BRICK, BRICK)]
void SurfEmitFold(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    SurfEmitFoldBody(gid, gtid);
}

// One-time zero after (re)allocation — ComputeBuffer contents are undefined on create. Dispatched as a 2-D
// group grid (index flattened via _SurfClearRow) so the element count can exceed the 65535 group-per-dim cap.
int _SurfClearRow;
[numthreads(64, 1, 1)]
void ClearSurfAccum(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x + tid.y * (uint)_SurfClearRow;
    if (i >= (uint)(_SurfCellCount * 3)) return;
    _SurfAccum[i] = 0u;
}

uint MeshHash(uint key)
{
    key ^= key >> 16;
    key *= 0x7feb352du;
    key ^= key >> 15;
    key *= 0x846ca68bu;
    key ^= key >> 16;
    return key;
}

// Atomically claim/find the unique sparse slot for one voxel. Capacity is at least twice the maximum number of
// submitted samples, keeping probes short while making memory proportional to source complexity, not grid volume.
int MeshHashSlot(int cellKey)
{
    uint start = MeshHash((uint)cellKey) & (uint)_MeshHashMask;
    [loop] for (uint probe = 0u; probe < (uint)_MeshHashCapacity; probe++)
    {
        uint slot = (start + probe) & (uint)_MeshHashMask;
        uint baseIndex = slot * 13u;
        int observed;
        InterlockedCompareExchange(_MeshAccum[baseIndex], -1, cellKey, observed);
        if (observed == -1 || observed == cellKey) return (int)slot;
    }
    return -1;   // defensive only: capacity is provisioned above the maximum possible unique-cell count
}

float3 MeshBirthTarget(int3 c, out float blend)
{
    float3 jitter = _MeshSourceTurbulence > 1e-5
        ? BrazePotential((float3(c) + 0.5) * (0.125 / max(_ResolutionScale, 1e-4))
                         + float3(13.7, 7.1, 19.3), _Time * 1.7) * _MeshSourceTurbulence
        : (float3)0;
    float autoBlend = (dot(_MeshJetVelocity, _MeshJetVelocity) > 1e-8 || _MeshSourceTurbulence > 1e-5)
        ? 8.0 : 0.0;
    float blendRate = max(_MeshSourceVelocityBlend, autoBlend);
    blend = 1.0 - exp(-max(blendRate, 0.0) * _Dt);
    return _MeshJetVelocity + _MeshSourceVelocity + jitter;
}

void MeshHashAccumulate(int3 c, float3 channels, float3 surfaceVel, float3 birthTarget,
                        float birthBlend, float buoyancy)
{
    int cellKey = c.x + c.y * _Res.x + c.z * _Res.x * _Res.y;
    int slot = MeshHashSlot(cellKey);
    if (slot < 0) return;
    uint baseIndex = (uint)slot * 13u;
    int3 chq = (int3)(max(channels, 0.0) * SURF_FP);
    InterlockedAdd(_MeshAccum[baseIndex + 1u], chq.x);
    InterlockedAdd(_MeshAccum[baseIndex + 2u], chq.y);
    InterlockedAdd(_MeshAccum[baseIndex + 3u], chq.z);
    InterlockedAdd(_MeshAccum[baseIndex + 4u], (int)(surfaceVel.x * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 5u], (int)(surfaceVel.y * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 6u], (int)(surfaceVel.z * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 7u], (int)(birthTarget.x * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 8u], (int)(birthTarget.y * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 9u], (int)(birthTarget.z * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 10u], (int)(buoyancy * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 11u], (int)(saturate(birthBlend) * MESH_FP));
    InterlockedAdd(_MeshAccum[baseIndex + 12u], 1);
    _Occ[(uint3)c / BRICK_U] = 1.0;
}

// One thread per LIVE mesh vertex: world pos (already skinned/extracted on the GPU) → voxel; splat this
// emitter's channels + surface/birth velocity + buoyancy into the sparse hash (fixed-point, atomic),
// and refresh the per-vertex prev-pos for the next step's velocity diff. Brick-marked so DilateOcc gives
// splatted cells the halo and puts them in the indirect args (MeshEmitFold consumes after Emit).
[numthreads(64, 1, 1)]
void MeshSplat(uint3 tid : SV_DispatchThreadID)
{
    uint srcIndex = tid.x;
    if (_MeshMaskUsePassIdx != 0)
    {
        uint passCount = _MeshMaskPassCount[0];
        if (tid.x >= passCount) return;
        srcIndex = _MeshMaskPassIdx[tid.x];
        if (srcIndex >= (uint)_MeshVertCount) return;
    }
    else
    {
        if (srcIndex >= (uint)_MeshVertCount) return;
    }
    float maskWeight = 1.0;
    if (_MeshMaskEnable != 0)
    {
        float3 fieldPos = mul(_MeshMaskRestLocalToField, float4(_MeshMaskRestLocal[srcIndex], 1.0)).xyz;
        maskWeight = MaskFieldWeight(fieldPos);
        if (maskWeight <= 1e-3) return;
    }
    float3 srcPos = _MeshVerts[srcIndex];
    float3 wp = (_MeshInputLocal != 0) ? mul(_MeshLocalToWorld, float4(srcPos, 1.0)).xyz : srcPos;
    float3 vw = (_MeshHasPrev != 0) ? (wp - _MeshPrevPos[srcIndex]) * _MeshInvDt : float3(0, 0, 0);
    _MeshPrevPos[srcIndex] = wp;
    float3 nrm = _MeshNormals[srcIndex];
    if (_MeshInputLocal != 0) nrm = normalize(mul((float3x3)_MeshNormalLocalToWorld, nrm));
    if (_MeshNormalSpeed != 0.0) vw += nrm * _MeshNormalSpeed;   // push out along the surface normal

    float3 v = mul(_WorldToVoxelM, float4(wp, 1.0)).xyz;
    int3 c = int3(floor(v));
    if (any(c < 0) || any(c >= _Res)) return;
    float3 surfaceVel = mul((float3x3)_WorldToVoxelM, vw); // world/sec → voxels/sec (linear part)
    surfaceVel += _MeshPushAccel * _Dt;                    // Push remains a per-step surface acceleration.
    float birthBlend;
    float3 birthTarget = MeshBirthTarget(c, birthBlend);

    MeshHashAccumulate(c, _MeshChannels * maskWeight, surfaceVel, birthTarget, birthBlend, _MeshBuoyancy);
}

// One thread per Voronoi fragment. The ordinary mesh-emitter path follows the centroid. Impact emission instead
// uses a rotating surface point, an early heat/fuel ejecta burst, and a softer smoke tail so falling fragments do
// not look like rigid point emitters. Inactive impact cells exit before reading the additional kinematic buffers.
[numthreads(64, 1, 1)]
void FragmentSplat(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= (uint)_FragmentEmitCount || _FragmentEmitCount <= 0 || _FragmentCount <= 0) return;
    // Evenly sample the full stable fragment-id range. This picks an exact persistent percentage without a GPU
    // compaction pass/counter and reduces dispatch work in direct proportion to the authored amount.
    uint srcIndex = min((uint)(((float)tid.x * (float)_FragmentCount) / (float)_FragmentEmitCount),
                        (uint)(_FragmentCount - 1));
    float4 ps = _FragmentPosState[srcIndex];
    if (ps.w < 0.5) return;
    float scale = saturate(_FragmentLife[srcIndex].x);
    if (scale <= 0.001) return;

    float3 fragmentChannels = _MeshChannels;
    float fragmentBuoyancy = _MeshBuoyancy;
    float fragmentVelocityInherit = _FragmentVelocityInherit;
    float3 emissionWorldPosition = ps.xyz;
    float3 fragmentWorldVelocity = _FragmentVelocity[srcIndex].xyz;
    float3 surfaceWorldVelocity = fragmentWorldVelocity * saturate(fragmentVelocityInherit);
    float3 impactBirthWorldVelocity = float3(0.0, 0.0, 0.0);
    float impactBreakup = 0.0;
    float impactVelocityResponse = 0.0;
    if (_FragmentImpactFilter != 0)
    {
        float4 impactFluid = _FragmentImpactFluidState[srcIndex];
        if (impactFluid.w <= 0.0 || all(impactFluid.xyz <= 1e-6)) return;
        uint packedMotion = _FragmentImpactFluidMotion[srcIndex];
        float4 geometry = _FragmentImpactFluidGeometry[srcIndex];
        float4 plumeVelocity = _FragmentImpactFluidVelocity[srcIndex];
        float authoredDuration = max(geometry.w, 1e-4);
        float age = saturate(1.0 - impactFluid.w / authoredDuration);
        float remaining = saturate(1.0 - age);

        // Fire is an impact flash that rapidly gives way to a broader smoke tail. Both approach zero smoothly,
        // removing the old constant-rate source and its hard disappearance at the timer boundary.
        float fireEnvelope = 2.2 * pow(remaining, 2.5);
        float smokeEnvelope = pow(remaining, 1.1) * lerp(0.35, 1.1, saturate(age * 2.5));
        // Heat bridges the flame burst into the smoke tail. Tying heat to fuel's fast envelope created fresh cold
        // soot late in the event: it stopped rising, blanketed the flame, and made the two rendered layers feel
        // merged even though their field channels were still separate.
        float heatEnvelope = max(fireEnvelope, smokeEnvelope * 0.45);
        fragmentChannels = max(impactFluid.xyz, 0.0)
            * float3(smokeEnvelope, heatEnvelope, fireEnvelope);
        fragmentBuoyancy = f16tof32(packedMotion & 0xffffu) * _FragmentImpactBuoyancyScale;
        fragmentVelocityInherit = saturate(f16tof32(packedMotion >> 16));

        float4 rotation = _FragmentRotation[srcIndex];
        float radius = max(_FragmentCentroidRadius[srcIndex].w * scale, 0.0);
        float3 surfaceOffset = QuatRot(rotation, geometry.xyz) * radius;
        emissionWorldPosition += surfaceOffset;
        surfaceWorldVelocity = (fragmentWorldVelocity
            + cross(_FragmentAngularVelocity[srcIndex].xyz, surfaceOffset)) * fragmentVelocityInherit;
        impactBirthWorldVelocity = QuatRot(rotation, plumeVelocity.xyz) * pow(remaining, 2.2);
        impactBreakup = max(plumeVelocity.w, 0.0) * lerp(0.35, 1.0, remaining);
        impactVelocityResponse = lerp(4.0, 18.0, pow(remaining, 1.5));
    }
    if (all(fragmentChannels <= 1e-6)) return;

    float3 v = mul(_WorldToVoxelM, float4(emissionWorldPosition, 1.0)).xyz;
    int3 c = int3(floor(v));
    if (any(c < 0) || any(c >= _Res)) return;

    float3 surfaceVel = mul((float3x3)_WorldToVoxelM, surfaceWorldVelocity) + _MeshPushAccel * _Dt;
    float birthBlend;
    float3 birthTarget = MeshBirthTarget(c, birthBlend);
    if (_FragmentImpactFilter != 0)
    {
        float3 breakupWorld = impactBreakup > 1e-5
            ? BrazePotential((float3(c) + 0.5) * (0.17 / max(_ResolutionScale, 1e-4))
                             + float3(31.7, 11.3, 23.9), _Time * 2.35) * impactBreakup
            : float3(0.0, 0.0, 0.0);
        // Impact motion is a birth target with an exponential response, not a hard velocity overwrite. This lets
        // pressure projection and the surrounding gas bend the plume while still carrying fragment surface motion.
        birthTarget = mul((float3x3)_WorldToVoxelM,
                          surfaceWorldVelocity + impactBirthWorldVelocity + breakupWorld);
        birthBlend = 1.0 - exp(-impactVelocityResponse * _Dt);
        surfaceVel = float3(0.0, 0.0, 0.0);
    }
    MeshHashAccumulate(c, fragmentChannels * scale, surfaceVel, birthTarget, birthBlend, fragmentBuoyancy);
}

[numthreads(1, 1, 1)]
void ClearMeshMaskPass(uint3 tid : SV_DispatchThreadID)
{
    _MeshMaskPassCountRW[0] = 0u;
}

[numthreads(64, 1, 1)]
void MeshMaskGate(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= (uint)_MeshVertCount) return;
    float3 fieldPos = mul(_MeshMaskRestLocalToField, float4(_MeshMaskRestLocal[tid.x], 1.0)).xyz;
    if (MaskFieldWeight(fieldPos) > 1e-3)
    {
        uint slot;
        InterlockedAdd(_MeshMaskPassCountRW[0], 1u, slot);
        _MeshMaskPassIdxRW[slot] = tid.x;
    }
}

[numthreads(1, 1, 1)]
void WriteMeshMaskDispatchArgs(uint3 tid : SV_DispatchThreadID)
{
    uint passCount = _MeshMaskPassCount[0];
    _IndirectArgs[0] = max(1u, min((passCount + 63u) / 64u, 65535u));
    _IndirectArgs[1] = 1u;
    _IndirectArgs[2] = 1u;
}

// Fold occupied sparse-hash slots into the fields: average per covered voxel (arithmetic mean over the sample
// count — spacing-independent, matching the old CPU
// path), inject channels × dt, impose the averaged mesh/source velocity (self-gated: a static mesh with no
// source motion averages to ~zero and leaves the cell velocity alone), and mass-weight this emitter's buoyancy into _Vel.w against the
// existing gas (mirrors EmitPoints). Each occupied slot owns one unique cell, so texture writes are race-free.
int _MeshHashRow;
[numthreads(64, 1, 1)]
void MeshEmitFold(uint3 tid : SV_DispatchThreadID)
{
    uint slot = tid.x + tid.y * (uint)_MeshHashRow;
    if (slot >= (uint)_MeshHashCapacity) return;
    uint baseIndex = slot * 13u;
    int cellKey = _MeshAccum[baseIndex];
    if (cellKey < 0) return;
    int cnt = _MeshAccum[baseIndex + 12u];
    if (cnt <= 0) return;

    int3 chi = int3(_MeshAccum[baseIndex + 1u], _MeshAccum[baseIndex + 2u], _MeshAccum[baseIndex + 3u]);
    int3 si  = int3(_MeshAccum[baseIndex + 4u], _MeshAccum[baseIndex + 5u], _MeshAccum[baseIndex + 6u]);
    int3 bvi = int3(_MeshAccum[baseIndex + 7u], _MeshAccum[baseIndex + 8u], _MeshAccum[baseIndex + 9u]);
    int  bi  = _MeshAccum[baseIndex + 10u];
    int  bli = _MeshAccum[baseIndex + 11u];

    uint flatCell = (uint)cellKey;
    uint plane = (uint)(_Res.x * _Res.y);
    uint z = flatCell / plane;
    uint rem = flatCell - z * plane;
    uint y = rem / (uint)_Res.x;
    uint x = rem - y * (uint)_Res.x;
    uint3 id = uint3(x, y, z);

    float invCnt = 1.0 / (float)cnt;
    float3 ch  = (float3(chi) / SURF_FP) * invCnt;
    float3 surfaceVel = (float3(si) / MESH_FP) * invCnt;
    float3 birthTarget = (float3(bvi) / MESH_FP) * invCnt;
    float  buoy = ((float)bi / MESH_FP) * invCnt;
    float  birthBlend = saturate(((float)bli / MESH_FP) * invCnt);

    float4 f = _Fields[id];
    float oldDens = max(f.x, 0.0);
    f.xyz += ch * _Dt;
    _Fields[id] = f;

    float4 vv = _Vel[id];
    float newGas = max(ch.x + ch.y, 0.0) * _Dt;
    if (dot(surfaceVel, surfaceVel) > 1e-8) vv.xyz = surfaceVel;
    if (dot(birthTarget, birthTarget) > 1e-8 && birthBlend > 1e-5)
    {
        // A source may only steer the gas it just added. Applying birthBlend to the entire existing voxel every
        // step made moving fracture sources repeatedly pin the plume to fragment velocity, erasing buoyant rise on
        // the following frame. Empty cells retain full authored response; established gas is affected in proportion
        // to the new gas mass, matching the analytic emitter's contribution-weighted velocity injection.
        float sourceAuthority = newGas / max(oldDens + newGas, 1e-6);
        vv.xyz = lerp(vv.xyz, surfaceVel + birthTarget, saturate(birthBlend * sourceAuthority));
    }
    // buoyBlend is always 1 for mesh sources.
    if (newGas > 1e-6) vv.w = (oldDens * vv.w + newGas * buoy) / max(oldDens + newGas, 1e-6);
    _Vel[id] = vv;

    // Clear only after all payload-derived writes, keeping UAV reads/resets unambiguously ordered and leaving the
    // slot ready for the next simulation step.
    [unroll] for (uint k = 1u; k < 13u; k++) _MeshAccum[baseIndex + k] = 0;
    _MeshAccum[baseIndex] = -1;
}

// One-time clear after allocation. Empty slots use key -1; payloads start at zero.
int _MeshClearRow;
[numthreads(64, 1, 1)]
void ClearMeshAccum(uint3 tid : SV_DispatchThreadID)
{
    uint i = tid.x + tid.y * (uint)_MeshClearRow;
    if (i >= (uint)(_MeshHashCapacity * 13)) return;
    _MeshAccum[i] = (i % 13u == 0u) ? -1 : 0;
}

// Keep bricks alive while the fine up-res field still holds VISIBLE orphaned material (Persistence): the base
// occupancy is built from _Fields only, so when the base fume decays below the cull threshold its bricks die and
// the sparse fine advect stops visiting them — persistent detail would be chopped out in brick-shaped blocks.
// Bounded: orphans self-decay (τ ≤ ~1.6 s), so these marks always expire. Only the visual detail layer reads the
// bricks this adds — base fields there are empty, so the sim result is unchanged.

// Dilate by one full 3D brick so the plume can advect into neighbours without diagonal/corner holes. Face-only
// dilation was cheaper, but the active set could pop in block-shaped steps around fast turbulent smoke.
[numthreads(4, 4, 4)]
void DilateOcc(uint3 id : SV_DispatchThreadID)
{
    if (OccOob(id)) return;
    int3 c = int3(id);
    if (_Occ[id] > OCC_SCALAR_THRESHOLD)
    {
        // Count the RAW bricks (those with real content) — diagnostics (Raw bricks %).
        InterlockedAdd(_ActiveCount[1], 1u);
    }

    int3 lo = int3(0, 0, 0);
    int3 hi = _OccRes - 1;
    float m = 0.0;
    [unroll] for (int dz = -1; dz <= 1; dz++)
    {
        [unroll] for (int dy = -1; dy <= 1; dy++)
        {
            [unroll] for (int dx = -1; dx <= 1; dx++)
                m = max(m, _Occ[clamp(c + int3(dx, dy, dz), lo, hi)]);
        }
    }
    float wasActive = _OccD[id];   // read LAST step's BINARY halo before overwriting
    bool active = m > OCC_ACTIVE_THRESHOLD;
    bool scalarSupport = m > OCC_SCALAR_THRESHOLD;
    _OccD[id] = active ? 1.0 : 0.0; // public/sim occupancy remains binary for every existing consumer
    uint packedId = id.x + id.y * (uint)_OccRes.x + id.z * (uint)_OccRes.x * (uint)_OccRes.y;
    if (active)
    {
        uint idx;
        InterlockedAdd(_ActiveCount[0], 1u, idx);
        _ActiveBricks[idx] = packedId | (scalarSupport ? ACTIVE_SCALAR_BIT : 0u);
    }
    else if (wasActive > 0.5)
    {
        // Just left the active set — the ONLY bricks that can hold frozen sub-cull residue (everything
        // outside both halos is already 0, inductively). ClearRetiredBricks zeroes exactly these instead
        // of the old dense full-grid ClearInactiveFields sweep.
        uint idx;
        InterlockedAdd(_ActiveCount[2], 1u, idx);
        _RetiredBricks[idx] = packedId;
    }
}

// Zero a base float4 field once at init. Indirect base kernels never visit empty bricks, so (like the
// fine field) unvisited cells must start clean or they'd render/advect undefined memory.
[numthreads(4, 4, 4)]
void ClearField(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    _ClearF4[id] = (float4)0.0;
}

// Zero fields OUTSIDE the dilated active set (BASE_EMPTY). The sparse sim only updates active bricks, so a brick
// that just fell below the occupancy cull FREEZES at its last value — sub-cull residue that never decays. It's
// invisible at a low cull but a raised cull leaves visible frozen "ghosts" that blink as the boundary flickers,
// AND the frozen residue keeps re-marking bricks so the active set (and FPS cost) never tracks the visible smoke.
// This zeros that residue each step. Safe: the plume + its 1-brick halo + emitter footprints are all inside _OccD
// (MarkOcc activates emitter footprints), so rising sub-cull emission and the advecting front are never cleared.
// DENSE FALLBACK ONLY: the per-step path is ClearRetiredBricks below (plume-proportional). This full sweep
// remains for one-shot transitions where dense residue can exist outside the retired set (e.g. after an
// external dense field write like BakeStaticVolume).
[numthreads(4, 4, 4)]
void ClearInactiveFields(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    if (BASE_EMPTY(id))
    {
        _Fields[id] = (float4)0.0;
        _FieldsClearAux[id] = (float4)0.0;
        _Vel[id] = (float4)0.0;
        _VelClearAux[id] = (float4)0.0;
        _Pressure[id] = 0.0;
    }
}

// Per-step residue clear: zero ONLY the bricks that just left the active set (collected by DilateOcc).
// Same end state as the dense sweep — voxels outside both halos are already 0 — at a handful of bricks
// per step instead of ~90% of the grid (~120 MB/frame of redundant zero-writes at 256³).
[numthreads(BRICK, BRICK, BRICK)]
void ClearRetiredBricks(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = _RetiredBricks[gid.x];
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint3 id = brick * BRICK_U + gtid;
    if (Oob(id)) return;
    _Fields[id] = (float4)0.0;
    _FieldsClearAux[id] = (float4)0.0;
    _Vel[id] = (float4)0.0;
    _VelClearAux[id] = (float4)0.0;
    _Pressure[id] = 0.0;
}

float4 LoadRenderSource(int3 c)
{
    return _FieldsIn.Load(int4(clamp(c, int3(0, 0, 0), _Res - 1), 0));
}

float VisibleFieldAmount(float4 f)
{
    float density = max(f.x, 0.0);
    float burn = max(f.w, 0.0);
    float firePotential = IgnitionResponse(f.y) * max(f.z, 0.0);
    // A CFD heat map is intentionally allowed to visualize temperature without also authoring smoke, fuel, or
    // flame. Keep that temperature in the renderer-visible copy while CFD thermal occupancy is active. The
    // uniform guard preserves the ordinary Fire path exactly: temperature alone remains invisible there.
    float thermal = (_CfdThermalOccupancy != 0) ? abs(f.y) : 0.0;
    return max(max(max(density, burn), firePotential), thermal);
}

float VisibleRenderSkipAmount(float4 f)
{
    float smoke = max(f.x, 0.0) * _RenderOccDensityGain;
    float fire = 1.5 * (1.0 - exp(-max(f.w, 0.0) * _RenderOccFireGain));
    float thermal = (_CfdThermalOccupancy != 0) ? abs(f.y) : 0.0;
    // The importance texture is an oracle, not an intensity field. Clamp before the half-float write so extreme
    // user-facing Density Scale values cannot overflow while every downstream consumer still gets [0,1].
    return saturate(max(max(smoke, fire), thermal));
}

float VisibleRenderFireAmount(float4 f)
{
    return saturate(1.5 * (1.0 - exp(-max(f.w, 0.0) * _RenderOccFireGain)));
}

// Cubic B-spline reconstruction of the base fields in 8 hardware-trilinear taps (Sigg/Hadwiger). APPROXIMATING:
// at a texel centre it evaluates to the separable 1/6·2/3·1/6 neighbourhood weighting, which low-passes the voxel
// frequency itself. Interpolating filters (trilinear, the renderer's quintic SmoothVoxelUVW) pass exactly through
// every voxel value and so PRESERVE coarse-grid "cement tiles" — this is the filter that removes them. Shared by
// BuildRenderField (de-voxel bake, once per voxel) and DetailBake (fine-field base), so it must be defined here.
float4 BSplineFields(float3 coord)
{
    float3 size = float3(_Res);
    float3 ts = 1.0 / size;
    float3 c  = coord * size - 0.5;
    float3 ic = floor(c);
    float3 fr = c - ic;
    float3 ifr = 1.0 - fr;
    float3 w0 = (1.0 / 6.0) * ifr * ifr * ifr;
    float3 w1 = (2.0 / 3.0) - 0.5 * fr * fr * (2.0 - fr);
    float3 w2 = (2.0 / 3.0) - 0.5 * ifr * ifr * (2.0 - ifr);
    float3 w3 = (1.0 / 6.0) * fr * fr * fr;
    float3 g0 = w0 + w1;
    float3 g1 = w2 + w3;
    float3 h0 = (ic - 0.5 + w1 / g0) * ts;
    float3 h1 = (ic + 1.5 + w3 / g1) * ts;
    float4 t000 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h0.x, h0.y, h0.z), 0);
    float4 t100 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h1.x, h0.y, h0.z), 0);
    float4 t010 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h0.x, h1.y, h0.z), 0);
    float4 t110 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h1.x, h1.y, h0.z), 0);
    float4 t001 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h0.x, h0.y, h1.z), 0);
    float4 t101 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h1.x, h0.y, h1.z), 0);
    float4 t011 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h0.x, h1.y, h1.z), 0);
    float4 t111 = _FieldsIn.SampleLevel(sampler_linear_clamp, float3(h1.x, h1.y, h1.z), 0);
    float4 x00 = lerp(t100, t000, g0.x);
    float4 x10 = lerp(t110, t010, g0.x);
    float4 x01 = lerp(t101, t001, g0.x);
    float4 x11 = lerp(t111, t011, g0.x);
    float4 y0 = lerp(x10, x00, g0.y);
    float4 y1 = lerp(x11, x01, g0.y);
    return lerp(y1, y0, g0.z);
}

// Flow Speed is a scalar presentation field too. The first correction used the scalar field's cubic B-spline, but
// its centre weight is 2/3: one third of Nyquist-frequency voxel alternation survives and Color Contrast 6 expands
// that residue back into visible tiles. Sample half a voxel to either side on every axis and average the eight
// hardware-trilinear taps. At voxel centres this is the separable 1/4, 1/2, 1/4 binomial kernel, whose Nyquist
// response is exactly zero. It removes only the grid-frequency component while retaining the larger solved wake
// gradients and complete false-colour range. This is paid once per render voxel; solver velocity stays untouched.
float BinomialVelocityMagnitude(float3 coord)
{
    float3 halfTexel = 0.5 / float3(_Res);
    float3 lo = saturate(coord - halfTexel);
    float3 hi = saturate(coord + halfTexel);
    float sum = length(_VelIn.SampleLevel(sampler_linear_clamp, float3(lo.x, lo.y, lo.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(hi.x, lo.y, lo.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(lo.x, hi.y, lo.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(hi.x, hi.y, lo.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(lo.x, lo.y, hi.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(hi.x, lo.y, hi.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(lo.x, hi.y, hi.z), 0).xyz);
    sum += length(_VelIn.SampleLevel(sampler_linear_clamp, float3(hi.x, hi.y, hi.z), 0).xyz);
    return sum * 0.125;
}

// Render-only field conditioning. This runs after Decay but before the sparse clear, so the raymarcher sees a
// smooth visual copy while the solver can still hard-zero inactive bricks for perf/stability. The conditioning
// is the approximating B-spline above (strength = _RenderVisualFilter, the container's Smooth Voxels knob) —
// de-voxeling paid ONCE per voxel so the raymarch stays a single lean tap — and the history tail decays quickly
// enough to hide brick cliffs without feeding the sim.
//
// FUSED OCCUPANCY: one 4³ thread group IS one occupancy brick (BRICK_U == 4, dispatch = ceil(res/4)), so the
// render-importance reduction consumes the just-written visible amounts in groupshared here, deleting the whole
// second full-field read pass (BuildRenderOcc). Its X channel remains the same max-visibility skip oracle.
// NOTE (measured, do not "optimize"): history stays a PING-PONG (_RenderPrev SRV → _RenderOut), even though
// the kernel only reads its own voxel. Writing the render texture in place serializes this dispatch against
// the previous frame's draws still sampling it (the raymarch reads it at render rate, we write at sim rate)
// — tried 2026-07-05, cost ~50 FPS. The spare texture buys frame overlap, not correctness.
groupshared float gsRenderVis[64];
groupshared float gsRenderFire[64];

[numthreads(4, 4, 4)]
void BuildRenderField(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex)
{
    // Group-uniform empty gate: a brick outside the dilated active halo with no visible render history holds
    // only sub-threshold residue the renderer's skip oracle never samples. Write a hard ZERO instead of
    // computing it (the write must stay — the ping-pong means BOTH copies have to converge to zero, or a
    // 2-step-old decay tail would freeze in the spare texture and ghost) and skip the loads + B-spline +
    // history math: ~2/3 of this dense pass's bandwidth, on the empty majority of the grid. Reading
    // _RenderOcc[gid] here is this group's OWN last-step value — it is only rewritten at the end of this
    // same group, so there is no cross-group hazard.
    bool emptyBrick = _OccD[gid] < 0.5 && _RenderOcc[gid].x < 1e-3;
    float vis = 0.0;
    float fireVis = 0.0;
    if (!Oob(id))   // no early return: every lane must reach the group barrier below
    {
        if (emptyBrick)
        {
            _RenderOut[id] = 0.0;
        }
        else
        {
        int3 c = int3(id);
        bool simActive = !BASE_EMPTY(id);
        // Outside the current solve halo, scalar data is retirement residue waiting for the sparse clear below.
        // Never present it as fresh render data for one more frame; a transported visual-history tail is the sole
        // continuity source there. This removes the hard 4^3 current-data blocks at a moving plume's old position.
        float4 center = simActive ? LoadRenderSource(c) : 0.0;
        float4 filtered = center;
        [branch] if (simActive)
        {
            float3 uvw = (float3(c) + 0.5) / float3(_Res);
            filtered = lerp(center, BSplineFields(uvw), saturate(_RenderVisualFilter));
        }
        float4 outv;
        if (_RenderVisualDecay <= 0.0)
            outv = max(filtered, 0.0);
        else
        {
            // Visual history used to decay at the SAME voxel. A fast plume therefore moved on while a stationary
            // copy remained in each retired brick. Backtrace it with the final fluid velocity so the same visual
            // persistence follows the plume; this fixes the ghost without shortening or degrading that history.
            float3 uvw = (float3(c) + 0.5) / float3(_Res);
            float3 historyVelocity = _VelIn.SampleLevel(sampler_linear_clamp, uvw, 0).xyz;
            float3 historyUvw = saturate(uvw - historyVelocity * max(_RenderHistoryDt, 0.0) / float3(_Res));
            float4 history = max(_RenderPrev.SampleLevel(sampler_linear_clamp, historyUvw, 0), 0.0)
                           * saturate(_RenderVisualDecay);
            float current = VisibleFieldAmount(center);
            // Strong current data replaces history; near-zero sub-cull data keeps a short visual tail instead of
            // snapping to a brick face. The response is intentionally steep so fresh fire/smoke stays crisp.
            float response = saturate(current * 48.0);
            outv = lerp(history, max(history, filtered), response);
            outv = max(lerp(outv, filtered, saturate(current * 8.0)), 0.0);
        }
        // CFD does not use the Fire fuel channel. When Flow Speed colouring is selected, reuse render-field B for a
        // normalized, render-conditioned velocity magnitude. Match scalar de-voxel strength so every performance
        // preset sees the same continuous field; this affects presentation only, never simulation velocity.
        if (_CfdRenderSpeedInvReference > 0.0)
        {
            float conditionedSpeed = 0.0;
            [branch] if (simActive)
                conditionedSpeed = BinomialVelocityMagnitude((float3(c) + 0.5) / float3(_Res));
            outv.z = saturate(conditionedSpeed * _CfdRenderSpeedInvReference);
        }
        _RenderOut[id] = outv;
        vis = VisibleRenderSkipAmount(outv);
        fireVis = VisibleRenderFireAmount(outv);
        }
    }

    // Coarse skip oracle for the renderer, built from the conditioned visual field rather than the solver's
    // sparse active bricks: empty-space leaping still costs almost nothing, but the renderer no longer
    // quantizes visible smoke to the sim's brick-clear boundary. OOB lanes contribute 0, matching the old
    // pass's bounds-clamped loop.
    gsRenderVis[gi] = vis;
    gsRenderFire[gi] = fireVis;
    GroupMemoryBarrierWithGroupSync();
    if (gi == 0)
    {
        float m = 0.0;
        float fireMax = 0.0;
        float sum = 0.0;
        float sumSq = 0.0;
        float fireSum = 0.0;
        float fireSumSq = 0.0;
        [unroll] for (uint i = 0; i < 64; i++)
        {
            float v = gsRenderVis[i];
            float f = gsRenderFire[i];
            m = max(m, v);
            fireMax = max(fireMax, f);
            sum += v;
            sumSq += v * v;
            fireSum += f;
            fireSumSq += f * f;
        }
        float mean = sum * (1.0 / 64.0);
        float variance = max(sumSq * (1.0 / 64.0) - mean * mean, 0.0);
        float fireMean = fireSum * (1.0 / 64.0);
        float fireVariance = max(fireSumSq * (1.0 / 64.0) - fireMean * fireMean, 0.0);

        // Alpha is a dimensionless combined variation score. Normalizing here lets the raymarch distinguish a
        // smooth, filled flame brick from a flame front without another texture/channel: smooth fire may stride
        // conservatively, while fire variance or a max-vs-mean spike immediately restores the voxel step.
        float visibilityVariation = variance / max(mean * mean, 0.0004);
        float fireVariation = fireVariance / max(fireMean * fireMean, 0.0004);
        float firePeak = (fireMax - fireMean) / max(fireMax, 0.05);
        float combinedVariation = min(max(visibilityVariation, max(fireVariation, firePeak * firePeak)), 16.0);
        _RenderOcc[gid] = float4(m, fireMax, mean, combinedVariation);
    }
}

// Cache playback scatters the final renderer-ready half texture directly, so its live adaptive-marching importance
// is fully derivable without simulation velocity or another cache channel. One indirect group visits each active/halo
// base brick and performs the same reduction as BuildRenderField. The small occupancy texture is cleared before this
// dispatch, so retired bricks and untouched empty space remain exactly zero.
[numthreads(BRICK, BRICK, BRICK)]
void BuildCacheRenderOcc(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID, uint gi : SV_GroupIndex)
{
    uint packed = ActiveBrickIndex(_ActiveBricks[gid.x]);
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint3 id = brick * BRICK_U + gtid;

    float vis = 0.0;
    float fireVis = 0.0;
    if (!Oob(id))
    {
        float4 f = _Fields[id];
        vis = VisibleRenderSkipAmount(f);
        fireVis = VisibleRenderFireAmount(f);
    }

    gsRenderVis[gi] = vis;
    gsRenderFire[gi] = fireVis;
    GroupMemoryBarrierWithGroupSync();
    if (gi == 0)
    {
        float m = 0.0;
        float fireMax = 0.0;
        float sum = 0.0;
        float sumSq = 0.0;
        float fireSum = 0.0;
        float fireSumSq = 0.0;
        [unroll] for (uint i = 0; i < 64; i++)
        {
            float v = gsRenderVis[i];
            float f = gsRenderFire[i];
            m = max(m, v);
            fireMax = max(fireMax, f);
            sum += v;
            sumSq += v * v;
            fireSum += f;
            fireSumSq += f * f;
        }
        float mean = sum * (1.0 / 64.0);
        float variance = max(sumSq * (1.0 / 64.0) - mean * mean, 0.0);
        float fireMean = fireSum * (1.0 / 64.0);
        float fireVariance = max(fireSumSq * (1.0 / 64.0) - fireMean * fireMean, 0.0);
        float visibilityVariation = variance / max(mean * mean, 0.0004);
        float fireVariation = fireVariance / max(fireMean * fireMean, 0.0004);
        float firePeak = (fireMax - fireMean) / max(fireMax, 0.05);
        float combinedVariation = min(max(visibilityVariation, max(fireVariation, firePeak * firePeak)), 16.0);
        _RenderOcc[brick] = float4(m, fireMax, mean, combinedVariation);
    }
}

// DEBUG visualizer: flatten per-brick occupancy into a CPU-readable buffer (buffer readback avoids the
// platform-specific row/slice padding of 3D-texture readback). bit0 = raw content, bit1 = active (raw or halo).
[numthreads(4, 4, 4)]
void BrickDebug(uint3 id : SV_DispatchThreadID)
{
    if (OccOob(id)) return;
    uint lin = id.x + id.y * (uint)_OccRes.x + id.z * (uint)_OccRes.x * (uint)_OccRes.y;
    uint flags = 0u;
    if (_Occ[id]  > OCC_SCALAR_THRESHOLD) flags |= 1u;
    if (_OccD[id] > 0.5) flags |= 2u;
    _BrickDbg[lin] = flags;
}

// Fire-light source reduction: burn-weighted centroid (in normalized [0,1] grid space) + total fire power.
// The injection shader (BrazeFX/FireLight) reads this buffer directly — no CPU readback, so the cast light
// tracks the live flame with zero latency. Weight = the same bounded fire amount the raymarch emits with
// (1-exp(-burn·BURN_GAIN)), so the light's anchor follows where fire is actually VISIBLE, not raw fuel.
// Positions are normalized (uvw ∈ [0,1]) before weighting → the atomic sums stay well under uint range for
// any grid size, and the centroid divides out the fixed-point scale cleanly. Clear the buffer (CPU SetData)
// before dispatching this each step.
#define FIRE_MOMENT_SCALE 1024.0
#define FIRE_BURN_GAIN 0.4              // matches BrazeRaymarch.shader BURN_GAIN
[numthreads(4, 4, 4)]
void FireMoments(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    float burn = max(_FieldsIn.Load(int4(id, 0)).w, 0.0);
    float amt = 1.0 - exp(-burn * FIRE_BURN_GAIN);
    uint w = (uint)(amt * FIRE_MOMENT_SCALE);
    if (w == 0u) return;
    float3 uvw = (float3(id) + 0.5) / float3(_Res);   // normalized grid position [0,1]
    uint dummy;
    InterlockedAdd(_FireMoments[0], w, dummy);
    InterlockedAdd(_FireMoments[1], (uint)(amt * uvw.x * FIRE_MOMENT_SCALE), dummy);
    InterlockedAdd(_FireMoments[2], (uint)(amt * uvw.y * FIRE_MOMENT_SCALE), dummy);
    InterlockedAdd(_FireMoments[3], (uint)(amt * uvw.z * FIRE_MOMENT_SCALE), dummy);
}

// Cache bake: pack the base field (ARGBHalf) into a flat uint buffer (3 uints/voxel, 6 halfs) so the CPU can
// read it back reliably — Request() on a 3D texture only returns slice 0 on some platforms (Metal). The
// half→float→half round-trip is lossless for the solver field values.
[numthreads(4, 4, 4)]
void CachePackBase(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    float4 f = _FieldsIn.Load(int4(id, 0));      // density.x, temp.y, fuel.z, burn.w
    float4 vel = _CacheVelIn.Load(int4(id, 0));  // velocity xyz (voxels/sec)
    uint lin = id.x + id.y * (uint)_Res.x + id.z * (uint)_Res.x * (uint)_Res.y;
    _CachePack[lin * 3]     = f32tof16(f.x)   | (f32tof16(f.y)   << 16);   // density | temp
    _CachePack[lin * 3 + 1] = f32tof16(f.w)   | (f32tof16(vel.x) << 16);   // burn    | velX
    _CachePack[lin * 3 + 2] = f32tof16(vel.y) | (f32tof16(vel.z) << 16);   // velY    | velZ
}

// Sparse cache bake. Pass 1 counts bricks whose density or burn crosses the authored bake cull. Pass 2 repeats
// the cheap 4^3 group-local test, atomically claims a compact output slot, and writes that brick directly in the
// six-half scalar+detail layout. Production v9 bakes append high-bit-tagged bricks containing the complete native
// Render Detail texture after the base render-field bricks.
// The CPU therefore reads only active data instead of a dense res^3 staging buffer and then
// scanning/copying it a second time. Boundary voxels are explicitly zero-filled to keep partial bricks portable.
groupshared uint _CacheBrickActive;
groupshared uint _CacheBrickSlot;

void CacheSparseActiveTest(uint3 localId, uint3 brickId)
{
    uint local = localId.x + localId.y * BRICK_U + localId.z * BRICK_U * BRICK_U;
    if (local == 0u) _CacheBrickActive = 0u;
    GroupMemoryBarrierWithGroupSync();

    uint3 g = brickId * BRICK_U + localId;
    if (g.x < (uint)_Res.x && g.y < (uint)_Res.y && g.z < (uint)_Res.z)
    {
        if (_CachePackWarpBricks != 0)
        {
            // The live detail texture is neutral-encoded at 0.5 outside authored bricks. Store only bricks that
            // contain a real displacement; the untouched playback texture is initialized to the same neutral value.
            float3 encoded = _CacheWarpIn.Load(int4(g, 0)).xyz;
            if (any(abs(encoded - 0.5) > 1e-6)) InterlockedOr(_CacheBrickActive, 1u);
        }
        else
        {
            float4 f = _FieldsIn.Load(int4(g, 0));
            if (f.x > _CacheCull || f.w > _CacheCull) InterlockedOr(_CacheBrickActive, 1u);
            // Velocity topology can extend beyond visible density/fire. Preserving those boundary bricks keeps an
            // exported VDB `vel` grid and cache-driven particles complete, but the halo of moving AIR around a plume
            // is often larger than the visible smoke itself — lean playback bakes skip it (velocity is then stored
            // only inside scalar-active bricks, which is all Render Detail reconstruction reads).
            if (_CachePackBaseVelocity != 0 && _CacheVelocityBounds != 0)
            {
                float3 v = _CacheWarpIn.Load(int4(g, 0)).xyz;
                if (any(abs(v) > 1e-4)) InterlockedOr(_CacheBrickActive, 1u);
            }
        }
    }
    GroupMemoryBarrierWithGroupSync();
}

[numthreads(4, 4, 4)]
void CacheCountSparse(uint3 localId : SV_GroupThreadID, uint3 brickId : SV_GroupID)
{
    CacheSparseActiveTest(localId, brickId);
    uint local = localId.x + localId.y * BRICK_U + localId.z * BRICK_U * BRICK_U;
    if (local == 0u && _CacheBrickActive != 0u)
    {
        uint ignored;
        InterlockedAdd(_CacheSparseCount[0], 1u, ignored);
    }
}

[numthreads(4, 4, 4)]
void CachePackSparse(uint3 localId : SV_GroupThreadID, uint3 brickId : SV_GroupID)
{
    CacheSparseActiveTest(localId, brickId);
    if (_CacheBrickActive == 0u) return;

    uint local = localId.x + localId.y * BRICK_U + localId.z * BRICK_U * BRICK_U;
    if (local == 0u)
    {
        InterlockedAdd(_CacheSparseCount[0], 1u, _CacheBrickSlot);
        uint slot = _CacheBrickSlot + (uint)_CacheOutputOffset;
        uint index = brickId.x + brickId.y * (uint)_OccRes.x
            + brickId.z * (uint)_OccRes.x * (uint)_OccRes.y;
        _CacheSparseIdx[slot] = index | (_CachePackWarpBricks != 0 ? 0x80000000u : 0u);
    }
    GroupMemoryBarrierWithGroupSync();

    uint3 g = brickId * BRICK_U + localId;
    float4 f = 0.0;
    float3 vel = 0.0;
    if (g.x < (uint)_Res.x && g.y < (uint)_Res.y && g.z < (uint)_Res.z)
    {
        if (_CachePackWarpBricks != 0)
            vel = _CacheWarpIn.Load(int4(g, 0)).xyz; // preserve the live ARGBHalf encode bit-for-bit
        else
        {
            f = _FieldsIn.Load(int4(g, 0));
            // Base-brick vector halfs are otherwise zero padding (Render Detail travels in its own high-bit
            // bricks). A velocity bake stores the raw simulation velocity there — same bytes, no layout change.
            if (_CachePackBaseVelocity != 0) vel = _CacheWarpIn.Load(int4(g, 0)).xyz;
        }
    }

    uint dst = (((_CacheBrickSlot + (uint)_CacheOutputOffset) *
                 (BRICK_U * BRICK_U * BRICK_U)) + local) * 3u;
    _CacheSparseBlocks[dst]     = f32tof16(f.x)   | (f32tof16(f.y)   << 16); // density | temp
    _CacheSparseBlocks[dst + 1] = f32tof16(f.w)   | (f32tof16(vel.x) << 16); // burn    | warpX
    _CacheSparseBlocks[dst + 2] = f32tof16(vel.y) | (f32tof16(vel.z) << 16); // warpY   | warpZ
}

// Cache playback: scatter the sparse active-brick blocks straight into the 3D fields on the GPU. One thread per
// (brick, voxel), flat 1D dispatch. The fields are cleared first (sparse → inactive cells must be 0).
// 2 halfs packed per uint (low/high 16 bits) — i is the half index.
float ReadScatterHalf(StructuredBuffer<uint> buf, uint i) { uint u = buf[i >> 1]; return f16tof32(((i & 1u) == 0u) ? (u & 0xffffu) : (u >> 16)); }

// WarpQuant resident block: half j of the brick whose block starts at uint index `base` (2 halfs/uint).
float ReadBrickHalf(StructuredBuffer<uint> buf, uint base, uint j)
{ uint u = buf[base + (j >> 1)]; return f16tof32(((j & 1u) == 0u) ? (u & 0xffffu) : (u >> 16)); }
// WarpQuant resident block: byte k of the displacement plane that starts at uint index `base` (4 bytes/uint).
uint ReadBrickByte(StructuredBuffer<uint> buf, uint base, uint k)
{ uint u = buf[base + (k >> 2)]; return (u >> ((k & 3u) * 8u)) & 0xFFu; }

void DecodeBrickGrid(uint bidx, int3 grid, out uint bx, out uint by, out uint bz)
{
    uint gxy = (uint)grid.x * (uint)grid.y;
    bz = bidx / gxy;
    uint rem = bidx - bz * gxy;
    by = rem / (uint)grid.x;
    bx = rem - by * (uint)grid.x;
}

void DecodeBrick(uint bidx, out uint bx, out uint by, out uint bz)
{ DecodeBrickGrid(bidx, _BrickGrid, bx, by, bz); }

float4 EncodeScatterWarp(float3 displacement)
{
    // DetailFlow clips carry the raw flow anchor — BakeWarp samples it unencoded, exactly like the live flowField.
    // Single-return select (not an early-out if): the dual-return form makes the Metal cross-compiler flag the
    // implicit return temp as "potentially uninitialized" (false positive, but it warns on every import).
    float3 enc = (_ScatterWarpRaw != 0) ? displacement : saturate(displacement / 0.7 + 0.5);
    return float4(enc, 0.0);
}

[numthreads(64, 1, 1)]
void CacheScatterBase(uint3 tid : SV_DispatchThreadID)
{
    uint bs = (uint)_ScatterBrickSize;
    uint vpb = bs * bs * bs;
    uint linearTid = CacheLinearThread64(tid);
    uint b = linearTid / vpb;
    if (b >= (uint)_ScatterBrickCount) return;
    uint local = linearTid - b * vpb;
    uint lx = local % bs, ly = (local / bs) % bs, lz = local / (bs * bs);
    // The whole cache is resident on the GPU; this frame's bricks start at _ScatterBrickOffset.
    uint gb = (uint)_ScatterBrickOffset + b;
    uint taggedIndex = _ScatterBrickIdx[gb];
    bool warpBrick = _ScatterSplitWarp != 0 && (taggedIndex & 0x80000000u) != 0u;
    uint brickIndex = taggedIndex & 0x7fffffffu;
    uint bx, by, bz;
    DecodeBrickGrid(brickIndex, warpBrick ? _WarpBrickGrid : _BrickGrid, bx, by, bz);
    uint3 g = uint3(bx * bs + lx, by * bs + ly, bz * bs + lz);
    if (local == 0u && _ScatterSplitWarp != 0)
        _CacheWarpActiveBricks[b] = warpBrick ? brickIndex : 0xffffffffu;
    uint3 targetRes = warpBrick ? (uint3)_ScatterWarpRes : (uint3)_Res;
    if (any(g >= targetRes)) return;

    // Block-pool index: the BRICK POSITION is gb (per-frame slot), but the BLOCK BYTES may be shared (dedup).
    uint blk = gb;
    if (_ScatterDedup != 0) blk = _ScatterBlockId[gb];

    // v9 final-look detail blocks carry the live texture's encoded RGB half bits in channels 3..5. Writing those
    // values directly (without decode/re-encode and without base-grid resampling) is the core authenticity guarantee.
    if (warpBrick)
    {
        uint s = (blk * vpb + local) * 6u;
        _ScatterWarp[g] = float4(ReadScatterHalf(_ScatterBase, s + 3u),
                                 ReadScatterHalf(_ScatterBase, s + 4u),
                                 ReadScatterHalf(_ScatterBase, s + 5u), 0.0);
        return;
    }

    if (_ScatterScalarQuant != 0)
    {
        // ScalarQuant block: scalars 8-bit (per-channel scale) + optional warp 8-bit (per-brick scale).
        // Kept readable for older experimental v7 files; the production v7 baker never quantizes scalars.
        uint sBytes = (vpb * 3u + 3u) / 4u;
        uint sj = local * 3u;
        if (_ScatterHasWarp != 0)
        {
            uint vBytes = (vpb * 3u + 3u) / 4u;
            uint uintsPerBrick = sBytes + vBytes + 4u;
            uint bbase = blk * uintsPerBrick;
            uint scaleBase = bbase + sBytes + vBytes;
            float s0 = asfloat(_ScatterBase[scaleBase]);
            float s1 = asfloat(_ScatterBase[scaleBase + 1u]);
            float s2 = asfloat(_ScatterBase[scaleBase + 2u]);
            float vscale = asfloat(_ScatterBase[scaleBase + 3u]);
            float dens = (float)ReadBrickByte(_ScatterBase, bbase, sj)      * (s0 * (1.0 / 255.0));
            float temp = (float)ReadBrickByte(_ScatterBase, bbase, sj + 1u) * (s1 * (1.0 / 255.0));
            float burn = (float)ReadBrickByte(_ScatterBase, bbase, sj + 2u) * (s2 * (1.0 / 255.0));
            uint vbase = bbase + sBytes;
            float k = (1.0 / 127.0) * vscale;
            float vx = ((float)ReadBrickByte(_ScatterBase, vbase, sj)      - 128.0) * k;
            float vy = ((float)ReadBrickByte(_ScatterBase, vbase, sj + 1u) - 128.0) * k;
            float vz = ((float)ReadBrickByte(_ScatterBase, vbase, sj + 2u) - 128.0) * k;
            _Fields[g] = float4(dens, temp, 0.0, burn);
            if (_ScatterHasVelocity != 0)
            {
                if (_ScatterDiscardVelocity == 0) _ScatterVelocity[g] = float4(vx, vy, vz, 0.0);
            }
            else if (_ScatterSplitWarp == 0) _ScatterWarp[g] = EncodeScatterWarp(float3(vx, vy, vz));
        }
        else
        {
            uint uintsPerBrick = sBytes + 3u;
            uint bbase = blk * uintsPerBrick;
            uint scaleBase = bbase + sBytes;
            float s0 = asfloat(_ScatterBase[scaleBase]);
            float s1 = asfloat(_ScatterBase[scaleBase + 1u]);
            float s2 = asfloat(_ScatterBase[scaleBase + 2u]);
            float dens = (float)ReadBrickByte(_ScatterBase, bbase, sj)      * (s0 * (1.0 / 255.0));
            float temp = (float)ReadBrickByte(_ScatterBase, bbase, sj + 1u) * (s1 * (1.0 / 255.0));
            float burn = (float)ReadBrickByte(_ScatterBase, bbase, sj + 2u) * (s2 * (1.0 / 255.0));
            _Fields[g] = float4(dens, temp, 0.0, burn);
        }
        return;
    }

    if (_ScatterHasWarp == 0)
    {
        // Scalars-only block: [scalarUints halfs (density,temp,burn)] per brick. velCur stays cleared (0).
        uint scalarUints = (vpb * 3u + 1u) / 2u;
        uint bbase = blk * scalarUints;
        uint hj = local * 3u;
        _Fields[g] = float4(ReadBrickHalf(_ScatterBase, bbase, hj),
                            ReadBrickHalf(_ScatterBase, bbase, hj + 1u), 0.0,
                            ReadBrickHalf(_ScatterBase, bbase, hj + 2u));   // density, temp, fuel(0), burn
        return;
    }

    if (_ScatterWarpQuant != 0)
    {
        // WarpQuant: [scalar halfs][signed displacement bytes][one per-brick max-abs scale].
        uint scalarUints = (vpb * 3u + 1u) / 2u;
        uint velUints = (vpb * 3u + 3u) / 4u;
        uint uintsPerBrick = scalarUints + velUints + 1u;
        uint bbase = blk * uintsPerBrick;
        uint hj = local * 3u;
        float dens = ReadBrickHalf(_ScatterBase, bbase, hj);
        float temp = ReadBrickHalf(_ScatterBase, bbase, hj + 1u);
        float burn = ReadBrickHalf(_ScatterBase, bbase, hj + 2u);
        uint vbase = bbase + scalarUints;
        float scale = asfloat(_ScatterBase[bbase + scalarUints + velUints]);
        uint bj = local * 3u;
        float k = (1.0 / 127.0) * scale;
        float vx = ((float)ReadBrickByte(_ScatterBase, vbase, bj)      - 128.0) * k;
        float vy = ((float)ReadBrickByte(_ScatterBase, vbase, bj + 1u) - 128.0) * k;
        float vz = ((float)ReadBrickByte(_ScatterBase, vbase, bj + 2u) - 128.0) * k;
        _Fields[g] = float4(dens, temp, 0.0, burn);
        if (_ScatterHasVelocity != 0)
        {
            if (_ScatterDiscardVelocity == 0) _ScatterVelocity[g] = float4(vx, vy, vz, 0.0);
        }
        else if (_ScatterSplitWarp == 0) _ScatterWarp[g] = EncodeScatterWarp(float3(vx, vy, vz));
        return;
    }

    uint s = (blk * vpb + local) * 6;
    _Fields[g]     = float4(ReadScatterHalf(_ScatterBase, s), ReadScatterHalf(_ScatterBase, s + 1), 0.0,
                            ReadScatterHalf(_ScatterBase, s + 2));   // density, temp, fuel(0), burn
    if (_ScatterHasVelocity != 0)
    {
        if (_ScatterDiscardVelocity == 0)
            _ScatterVelocity[g] = float4(ReadScatterHalf(_ScatterBase, s + 3),
                                         ReadScatterHalf(_ScatterBase, s + 4),
                                         ReadScatterHalf(_ScatterBase, s + 5), 0.0);
    }
    else if (_ScatterSplitWarp == 0)
        _ScatterWarp[g] = EncodeScatterWarp(float3(ReadScatterHalf(_ScatterBase, s + 3),
                                                    ReadScatterHalf(_ScatterBase, s + 4),
                                                    ReadScatterHalf(_ScatterBase, s + 5)));
}

// Cache playback sparse clear: reset ONLY the previously-active bricks (fields + optional neutral warp), dispatched indirect
// (one BRICK^3 group per active brick). The cache replaces the field wholesale each frame, so only the cells
// touched last frame need zeroing — this replaces the two dense full-grid ClearField passes. Run BEFORE scatter:
// bricks active again this frame get overwritten by the scatter; bricks no longer active are left at 0.
[numthreads(BRICK, BRICK, BRICK)]
void ClearBricksFV(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    _Fields[id] = (float4)0.0;
    if (_ScatterHasVelocity != 0)
        _ScatterVelocity[id] = (float4)0.0;
    else if (_ScatterHasWarp != 0 && _ScatterSplitWarp == 0)
        _ScatterWarp[id] = _ScatterWarpRaw != 0 ? (float4)0.0 : float4(0.5, 0.5, 0.5, 0.0);
}

// Authoritative VDB velocity is already in the solver's native voxels/second convention. Do not run optical flow
// over the scalar fields and overwrite it. This dense, deterministic finalize derives only the renderer auxiliaries:
// a UVW flow anchor spanning the configured memory window and the same velocity curl used by live fluid detail.
float _CacheVelocityFlowSeconds;
[numthreads(4, 4, 4)]
void CacheVelocityMotion(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    int3 c = int3(id);
    float3 v = _Vel[c].xyz;
    float3 vpx = _Vel[ClampC(c + int3(1, 0, 0))].xyz, vmx = _Vel[ClampC(c - int3(1, 0, 0))].xyz;
    float3 vpy = _Vel[ClampC(c + int3(0, 1, 0))].xyz, vmy = _Vel[ClampC(c - int3(0, 1, 0))].xyz;
    float3 vpz = _Vel[ClampC(c + int3(0, 0, 1))].xyz, vmz = _Vel[ClampC(c - int3(0, 0, 1))].xyz;
    float3 w;
    w.x = (vpy.z - vmy.z) - (vpz.y - vmz.y);
    w.y = (vpz.x - vmz.x) - (vpx.z - vmx.z);
    w.z = (vpx.y - vmx.y) - (vpy.x - vmy.x);
    _Curl[id] = float4(w, 0.0);
    _FlowField[id] = float4(v * _CacheVelocityFlowSeconds / max((float3)_Res, 1.0), 0.0);
}

// Motion-compensated interpolation between two STORED cache frames (playback frame-skip smoothing). The KEY frame
// is warped forward along its velocity by t·dt and the NEXT frame backward by (1−t)·dt, then blended — the same
// C0-continuous scheme the live Frame Skip warp uses, so decimated playback moves instead of stepping. Runs ONCE
// per render frame at BASE resolution into the display field; the raymarch stays one-state-tap (this deliberately
// avoids the old two-volumes-in-the-shader interpolation that doubled per-sample taps). The same 4³ group also
// publishes render-occupancy statistics from the value it just wrote, avoiding a second field read/dispatch and
// ensuring empty-space skipping never observes the previous blended frame. Dense on purpose: cells outside both
// frames' bricks read 0 from both sources and write 0, preserving the sparse-field invariant.
[numthreads(4, 4, 4)]
void CacheMotionBlend(uint3 id : SV_DispatchThreadID, uint3 gid : SV_GroupID, uint gi : SV_GroupIndex)
{
    float4 blended = 0.0;
    if (!Oob(id))   // no early return: every lane must reach the group barrier below
    {
        float t = saturate(_CacheBlendT);
        float3 v = _CacheBlendVel.Load(int4(id, 0)).xyz;   // key frame velocity, voxels/sec
        float3 res = float3(_Res);
        float3 x = float3(id) + 0.5;
        float3 uvwKey  = (x - v * (t * _CacheBlendSeconds)) / res;
        float3 uvwNext = (x + v * ((1.0 - t) * _CacheBlendSeconds)) / res;
        float4 key  = _CacheBlendKey.SampleLevel(sampler_linear_clamp, uvwKey, 0);
        float4 next = _CacheBlendNext.SampleLevel(sampler_linear_clamp, uvwNext, 0);
        blended = lerp(key, next, t);
        _Fields[id] = blended;
    }

    float vis = VisibleRenderSkipAmount(blended);
    float fireVis = VisibleRenderFireAmount(blended);
    gsRenderVis[gi] = vis;
    gsRenderFire[gi] = fireVis;
    GroupMemoryBarrierWithGroupSync();
    if (gi == 0)
    {
        float m = 0.0;
        float fireMax = 0.0;
        float sum = 0.0;
        float sumSq = 0.0;
        float fireSum = 0.0;
        float fireSumSq = 0.0;
        [unroll] for (uint i = 0; i < 64; i++)
        {
            float visibility = gsRenderVis[i];
            float fire = gsRenderFire[i];
            m = max(m, visibility);
            fireMax = max(fireMax, fire);
            sum += visibility;
            sumSq += visibility * visibility;
            fireSum += fire;
            fireSumSq += fire * fire;
        }
        float mean = sum * (1.0 / 64.0);
        float variance = max(sumSq * (1.0 / 64.0) - mean * mean, 0.0);
        float fireMean = fireSum * (1.0 / 64.0);
        float fireVariance = max(fireSumSq * (1.0 / 64.0) - fireMean * fireMean, 0.0);
        float visibilityVariation = variance / max(mean * mean, 0.0004);
        float fireVariation = fireVariance / max(fireMean * fireMean, 0.0004);
        float firePeak = (fireMax - fireMean) / max(fireMax, 0.05);
        float combinedVariation = min(max(visibilityVariation, max(fireVariation, firePeak * firePeak)), 16.0);
        _RenderOcc[gid] = float4(m, fireMax, mean, combinedVariation);
    }
}

// Clear only the native-resolution detail bricks touched by the previous cache frame. One entry exists for every
// prior combined-stream brick; base entries carry a sentinel and return immediately. This keeps scrubbing O(active)
// without a dense 2×/4× texture clear.
[numthreads(BRICK, BRICK, BRICK)]
void ClearCacheWarpBricks(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = _CacheWarpActiveBricks[CacheLinearGroup(gid)];
    if (packed == 0xffffffffu) return;
    uint bx, by, bz;
    DecodeBrickGrid(packed, _WarpBrickGrid, bx, by, bz);
    uint3 id = uint3(bx, by, bz) * BRICK_U + gtid;
    if (any(id >= (uint3)_ScatterWarpRes)) return;
    _ScatterWarp[id] = float4(0.5, 0.5, 0.5, 0.0);
}

// Cache playback occupancy: the cached bricks ARE the occupied set (the baker only stores bricks with content),
// so mark _Occ directly from this frame's scattered brick list — one thread per brick — instead of the dense
// MarkOcc pass that reads every voxel. _BrickGrid is bound to _OccRes, so the decoded brick maps straight to _Occ.
[numthreads(64, 1, 1)]
void MarkOccFromScatter(uint3 tid : SV_DispatchThreadID)
{
    if (tid.x >= (uint)_ScatterBrickCount) return;
    uint gb = (uint)_ScatterBrickOffset + tid.x;
    uint index = _ScatterBrickIdx[gb];
    if (_ScatterSplitWarp != 0 && (index & 0x80000000u) != 0u) return;
    uint bx, by, bz; DecodeBrick(index & 0x7fffffffu, bx, by, bz);
    if (bx >= (uint)_OccRes.x || by >= (uint)_OccRes.y || bz >= (uint)_OccRes.z) return;
    _Occ[uint3(bx, by, bz)] = 1.0;
}

// One thread: publish the active/retired brick counts as DispatchIndirect thread-group args
// ([0..2] active at byte offset 0, [3..5] retired at byte offset 12).
[numthreads(1, 1, 1)]
void WriteArgs(uint3 id : SV_DispatchThreadID)
{
    _IndirectArgs[0] = _ActiveCount[0];   // groups in X = number of active bricks
    _IndirectArgs[1] = 1;
    _IndirectArgs[2] = 1;
    _IndirectArgs[3] = _ActiveCount[2];   // groups in X = number of retired bricks
    _IndirectArgs[4] = 1;
    _IndirectArgs[5] = 1;
}

// Red-Black Gauss-Seidel: in-place pressure update. Each cell's 6 face neighbours are
// the opposite colour, so updating one colour per pass is race-free and converges ~2x
// faster than Jacobi (uses freshly-updated neighbours). Dispatched twice/iter (red, black).
// INDIRECT: one thread-group per active brick (dispatched via _IndirectArgs).
// LANE-PACKED: the old 4×4×4 layout with a parity `return` idled exactly half of every group in the
// solver's most-dispatched kernel. 4×4×2 = 32 threads instead cover ONLY this colour's cells: each (x,y)
// column of a brick holds exactly two cells of a given colour, at z = 2·gtid.z + zBit. Brick origins are
// multiples of 4 (even per axis), so local parity equals global parity. Identical cell set, colour order,
// and arithmetic — just no dead lanes.
[numthreads(4, 4, 2)]
void RBGS(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = ActiveBrickIndex(_ActiveBricks[gid.x]);
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint zBit = ((uint)_RedBlack + gtid.x + gtid.y) & 1u;
    uint3 id = brick * BRICK_U + uint3(gtid.x, gtid.y, gtid.z * 2u + zBit);
    if (Oob(id)) return;
    int3 c = int3(id);
    if (IS_SOLID(c)) { _Pressure[id] = 0.0; return; }   // no pressure inside solids
    float pc = _Pressure[id];
    // Obstacles and closed faces mirror centre pressure (Neumann); open faces read p=0 (Dirichlet).
    float l = PressureAt(c - int3(1, 0, 0), pc);
    float r = PressureAt(c + int3(1, 0, 0), pc);
    float d = PressureAt(c - int3(0, 1, 0), pc);
    float u = PressureAt(c + int3(0, 1, 0), pc);
    float b = PressureAt(c - int3(0, 0, 1), pc);
    float f = PressureAt(c + int3(0, 0, 1), pc);
    _Pressure[id] = (l + r + d + u + b + f - _Div[id]) / 6.0;
}

[numthreads(4, 4, 2)]
void RBGSCfd(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = ActiveBrickIndex(_ActiveBricks[gid.x]);
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint zBit = ((uint)_RedBlack + gtid.x + gtid.y) & 1u;
    uint3 id = brick * BRICK_U + uint3(gtid.x, gtid.y, gtid.z * 2u + zBit);
    if (Oob(id)) return;
    int3 c = int3(id);
    float fluid = CfdFluidFractionAt(c);
    if (fluid <= 1e-3) { _Pressure[id] = 0.0; return; }

    float pc = _Pressure[id];
    int3 cl = c - int3(1, 0, 0), cr = c + int3(1, 0, 0);
    int3 cd = c - int3(0, 1, 0), cu = c + int3(0, 1, 0);
    int3 cb = c - int3(0, 0, 1), cf = c + int3(0, 0, 1);
    float fl = CfdFluidFractionAt(cl), fr = CfdFluidFractionAt(cr);
    float fd = CfdFluidFractionAt(cd), fu = CfdFluidFractionAt(cu);
    float fb = CfdFluidFractionAt(cb), ff = CfdFluidFractionAt(cf);
    float wl = min(fluid, fl), wr = min(fluid, fr);
    float wd = min(fluid, fd), wu = min(fluid, fu);
    float wb = min(fluid, fb), wf = min(fluid, ff);
    float weight = wl + wr + wd + wu + wb + wf;
    float sum = wl * CfdPressureAt(cl, pc, fl) + wr * CfdPressureAt(cr, pc, fr)
              + wd * CfdPressureAt(cd, pc, fd) + wu * CfdPressureAt(cu, pc, fu)
              + wb * CfdPressureAt(cb, pc, fb) + wf * CfdPressureAt(cf, pc, ff);
    _Pressure[id] = weight > 1e-4 ? (sum - _Div[id]) / weight : 0.0;
}

// ── CFD full-domain multigrid V-cycle ────────────────────────────────────────────────────────────────────────
// Red-Black Gauss-Seidel moves pressure information one to two cells per sweep: at wind-tunnel budgets (6-8
// iterations) the inlet condition cannot communicate across a 128-cell domain, so air behaves compressibly —
// it piles up in front of a body instead of deflecting around it. One coarse correction (fine res / 2, where a
// sweep travels twice as far and cells number 1/8th) closes the global component in a handful of cheap coarse
// iterations; the fine smoother then only has local error left. Full-domain CFD only: the coarse grid is dense,
// so sparse Fire domains (whose divergence outside active bricks is stale) never enter this path.

// Fine-level residual of the RBGSCfd equation Σw·(p_n − p_c) = div.
float CfdFineResidual(int3 c)
{
    float result = 0.0;
    float fluid = CfdFluidFractionAt(c);
    if (fluid > 1e-3)
    {
        float pc = _Pressure[(uint3)c];
        int3 cl = c - int3(1, 0, 0), cr = c + int3(1, 0, 0);
        int3 cd = c - int3(0, 1, 0), cu = c + int3(0, 1, 0);
        int3 cb = c - int3(0, 0, 1), cf = c + int3(0, 0, 1);
        float fl = CfdFluidFractionAt(cl), fr = CfdFluidFractionAt(cr);
        float fd = CfdFluidFractionAt(cd), fu = CfdFluidFractionAt(cu);
        float fb = CfdFluidFractionAt(cb), ff = CfdFluidFractionAt(cf);
        float lap = min(fluid, fl) * (CfdPressureAt(cl, pc, fl) - pc)
                  + min(fluid, fr) * (CfdPressureAt(cr, pc, fr) - pc)
                  + min(fluid, fd) * (CfdPressureAt(cd, pc, fd) - pc)
                  + min(fluid, fu) * (CfdPressureAt(cu, pc, fu) - pc)
                  + min(fluid, fb) * (CfdPressureAt(cb, pc, fb) - pc)
                  + min(fluid, ff) * (CfdPressureAt(cf, pc, ff) - pc);
        result = _Div[(uint3)c] - lap;
    }
    return result;
}

// Change-driven and windowed: static topology changes rebuild the full texture, while animated rigid bodies
// update only the coarse cells whose 2x2x2 fine-cell blocks intersect a restored/stamped body footprint.
[numthreads(4, 4, 4)]
void CfdBuildCoarseSolid(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_CoarseDispatchSize)) return;
    uint3 id = (uint3)(_CoarseDispatchMin + int3(tid));
    if (any(id >= (uint3)_CoarseRes)) return;
    float coverage = 0.0;
    if (_NoSolids == 0)
    {
        int3 f = int3(id) * 2;
        [unroll] for (int dz = 0; dz < 2; dz++)
        [unroll] for (int dy = 0; dy < 2; dy++)
        [unroll] for (int dx = 0; dx < 2; dx++)
            coverage += saturate(_Solid[(uint3)ClampC(f + int3(dx, dy, dz))]);
        coverage *= 0.125;
    }
    _CoarseSolid[id] = coverage;
}

// Restrict the fine residual (8-cell average) and zero the coarse error for a cold Gauss-Seidel start.
[numthreads(4, 4, 4)]
void CfdRestrictResidual(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_CoarseRes)) return;
    float residual = 0.0;
    int3 f = int3(id) * 2;
    // [loop], deliberately: unrolling inlined eight copies of the large residual evaluation, which made this
    // the most expensive kernel for the METAL COMPILER (minutes of one-time pipeline build after a shader
    // edit — felt as an editor freeze). Runtime cost is irrelevant here: one small coarse-grid pass per solve.
    [loop] for (int child = 0; child < 8; child++)
    {
        int3 c = f + int3(child & 1, (child >> 1) & 1, (child >> 2) & 1);
        if (!OutsideRes(c)) residual += CfdFineResidual(c);
    }
    _CoarseDiv[id] = residual * 0.125;
    _CoarsePressure[id] = 0.0;
}

static const int3 CfdCoarseOffset[6] =
    { int3(-1, 0, 0), int3(1, 0, 0), int3(0, -1, 0), int3(0, 1, 0), int3(0, 0, -1), int3(0, 0, 1) };
static const int CfdCoarseFaceBit[6] = { 1, 2, 4, 8, 16, 32 };

// Dense red-black smoother for the coarse error equation Σw·(e_n − e_c) = 4·r (h_c = 2·h_f). Boundary
// conditions are the homogeneous versions of the fine ones: open faces and pressure outlets pin e = 0
// (Dirichlet), closed walls and velocity inlets mirror (Neumann). The coarse grid is small enough that the
// half-idle parity lanes cost nothing.
[numthreads(4, 4, 4)]
void CfdCoarseRBGS(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_CoarseRes)) return;
    if (((id.x + id.y + id.z) & 1u) != (uint)_RedBlack) return;
    float fluid = 1.0 - saturate(_CoarseSolid[id]);
    if (fluid <= 1e-3) { _CoarsePressure[id] = 0.0; return; }

    float weight = 0.0;
    float sum = 0.0;
    [unroll] for (int i = 0; i < 6; i++)
    {
        int3 n = int3(id) + CfdCoarseOffset[i];
        if (any(n < 0) || any(n >= _CoarseRes))
        {
            // Dirichlet e=0 contributes only to the weight; Neumann faces drop out of the stencil entirely.
            if ((_CfdCoarseDirichletFaces & CfdCoarseFaceBit[i]) != 0) weight += fluid;
        }
        else
        {
            float neighbourFluid = 1.0 - saturate(_CoarseSolid[(uint3)n]);
            float w = min(fluid, neighbourFluid);
            weight += w;
            sum += w * _CoarsePressure[(uint3)n];
        }
    }
    _CoarsePressure[id] = weight > 1e-4 ? (sum - _CoarseDiv[id] * 4.0) / weight : 0.0;
}

// Trilinearly prolong the coarse error onto the fine pressure. Solid interiors stay pinned at zero.
[numthreads(4, 4, 4)]
void CfdProlongAdd(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    if (CfdFluidFractionAt(int3(id)) <= 1e-3) return;
    float3 uvw = (float3(id) + 0.5) / float3(_Res);
    _Pressure[id] += _CoarsePressureRO.SampleLevel(sampler_linear_clamp, uvw, 0);
}

// Fluid-weighted pressure used by both the stagnation calibration and the displayed field. Keeping the exact
// same spatial operator on both sides of the normalization is important: calibrating raw cell pressure and then
// displaying a filtered surface tap reintroduces a resolution-dependent gain error.
float CfdFilteredPressure(int3 c, out float weight)
{
    uint3 id = (uint3)c;
    float centerWeight = 2.0 * CfdFluidFractionAt(c);
    weight = centerWeight;
    float sum = _Pressure[id] * centerWeight;
    [unroll] for (int i = 0; i < 6; i++)
    {
        int3 n = c + CfdCoarseOffset[i];
        float w = CfdFluidFractionAt(n);
        weight += w;
        sum += _Pressure[(uint3)ClampC(n)] * w;
    }
    return weight > 1e-4 ? sum / weight : 0.0;
}

// True when this cell belongs to the one-cell surface band: its 7-point neighbourhood contains both solid and
// fluid. Restricting the maximum to this band prevents a pressure spike elsewhere in the body's AABB (wake,
// inlet patch, another body, or an under-converged coarse mode) from masquerading as stagnation pressure.
bool CfdInSurfaceBand(int3 c)
{
    float minimumCoverage = CfdInteriorCoverage(c);
    float maximumCoverage = minimumCoverage;
    [unroll] for (int i = 0; i < 6; i++)
    {
        float coverage = CfdInteriorCoverage(ClampC(c + CfdCoarseOffset[i]));
        minimumCoverage = min(minimumCoverage, coverage);
        maximumCoverage = max(maximumCoverage, coverage);
    }
    return maximumCoverage > 0.01 && minimumCoverage < 0.99;
}

// Measure this tick's positive surface-pressure peak after the ambient reference reduction has completed.
// rawCp is normalized by the theoretical projection-space dynamic head; the peak therefore measures only the
// grid/CFL attenuation factor. The display divides by its temporal estimate, making the measured stagnation
// point Cp=+1 while retaining the sign and relative suction distribution everywhere else.
[numthreads(4, 4, 4)]
void MeasureCfdStagnationPressure(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_CfdLoadSize)) return;
    int3 c = _CfdLoadMin + int3(tid);
    if (OutsideRes(c) || !CfdInSurfaceBand(c)) return;

    float filterWeight;
    float filteredPressure = CfdFilteredPressure(c, filterWeight);
    if (filterWeight <= 1e-4) return;
    int referenceCount = _CfdRefPressure[1];
    float reference = referenceCount > 0
        ? ((float)_CfdRefPressure[0] / 256.0) / (float)referenceCount : 0.0;
    float rawCp = filteredPressure * _CfdPressureVisScale - reference;
    int candidate = (int)round(clamp(rawCp, 0.0, 32.0) * 1024.0);
    uint ignored;
    if (candidate > 0) InterlockedMax(_CfdRefPressure[2], candidate, ignored);
}

[numthreads(1, 1, 1)]
void FinalizeCfdPressureCalibration(uint3 id : SV_DispatchThreadID)
{
    int measured = _CfdRefPressure[2];
    int previous = _CfdRefPressure[3];
    // Seed from the theoretical value (attenuation=1) until a real positive surface signal exists. This keeps
    // startup noise neutral instead of magnifying an almost-zero pressure field into a false red hot spot.
    if (previous <= 0) previous = 1024;
    if (measured > 0)
        previous = (int)round(lerp((float)previous, (float)measured,
                                   saturate(_CfdPressureCalibrationBlend)));
    _CfdRefPressure[3] = max(previous, 1);
}

// Visualization-only pressure conditioning over the body window, one cheap pass per tick. Three overlay flicker
// sources die here: ① a fluid-weighted 7-point average cancels the odd-even (checkerboard) pressure mode the
// collocated solve cannot damp (and the coarse multigrid level cannot even see); ② the same weighting
// EXTRAPOLATES pressure across near-surface interior cells (the solver pins them to 0, so a raw surface tap
// trilinearly blended toward zero and jumped whenever a vertex crossed a cell boundary); ③ a temporal EMA
// absorbs per-tick solver transients and the turbulent-inlet phase. The simulation never reads this texture.
[numthreads(4, 4, 4)]
void CfdSmoothPressureVis(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_CfdLoadSize)) return;
    uint3 id = (uint3)(_CfdLoadMin + int3(tid));
    if (Oob(id)) return;
    int3 c = int3(id);
    float weight;
    float filteredPressure = CfdFilteredPressure(c, weight);
    float previous = _PressureVis[id];
    float value = previous;
    if (weight > 1e-4)
    {
        // Store the pressure COEFFICIENT, not raw solver pressure: subtract the domain ambient mean (kills the
        // physically-meaningless global level the incompressible solve is free to drift) and normalize by the
        // dynamic head, so stagnation reads ~+1 and suction goes negative for any body, speed, or grid.
        int referenceCount = _CfdRefPressure[1];
        float reference = referenceCount > 0
            ? ((float)_CfdRefPressure[0] / 256.0) / (float)referenceCount : 0.0;
        float rawCp = filteredPressure * _CfdPressureVisScale - reference;
        // Self-calibrating head: the theoretical 0.5·v²·dt head over-normalizes on realtime grids — CFL
        // diffusion, free-slip smearing and coverage-offset sampling attenuate the stagnation peak, and the
        // attenuation GROWS with speed (the body faded toward neutral as air speed rose). The measured maximum
        // of the near-wall field is the resolved stagnation pressure, so dividing by its smoothed attenuation
        // (slot 3, updated with the overlay's own time constant) pins stagnation at +1 regardless of grid, speed,
        // or mesh. Slot 3 starts at the theoretical factor 1, avoiding false normalization during spin-up.
        float head = (float)_CfdRefPressure[3] / 1024.0;
        value = rawCp / max(head, 1.0 / 1024.0);
    }
    _PressureVis[id] = lerp(previous, value, saturate(_PressureVisBlend));
}

// ── Animated (rigid-motion) CFD bodies ───────────────────────────────────────────────────────────────────────
// A rigid body's SDF never changes in its own space, so it is baked ONCE mesh-local and re-stamped through the
// current transform each tick — two small windowed dispatches per body instead of a re-voxelize + jump flood.

float CfdBodyCoverageAt(float3 vp)
{
    float3 uvw = mul(_CfdBodyVoxelToUvw, float4(vp, 1.0)).xyz;
    float coverage = 0.0;
    if (all(uvw >= 0.0) && all(uvw <= 1.0))
    {
        float sdf = _CfdBodySdf.SampleLevel(sampler_linear_clamp, uvw, 0.0);
        coverage = saturate(0.5 - sdf / max(_CfdCellWorldSize, 1e-6));
    }
    return coverage;
}

// Rebuild the static solid state over the union of a body's previous and current footprints, so coverage the
// body has vacated is cleared while static geometry underneath survives. Analytic obstacles are absent from the
// CFD path, so "static" means exactly the merged domain SDF (or empty space without one).
[numthreads(4, 4, 4)]
void RestoreCfdStaticSolid(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_SolidDispatchSize)) return;
    uint3 id = (uint3)(_SolidDispatchMin + int3(tid));
    if (Oob(id)) return;
    float coverage = 0.0;
    if (_CfdHasStaticSdf != 0)
    {
        float3 uvw = (float3(id) + 0.5) / float3(_Res);
        float sdf = _CfdSignedDistance.SampleLevel(sampler_linear_clamp, uvw, 0.0);
        coverage = saturate(0.5 - sdf / max(_CfdCellWorldSize, 1e-6));
    }
    _Solid[id] = coverage;
}

// Merge one animated body's coverage into the restored solid mask (its current footprint window only).
[numthreads(4, 4, 4)]
void ApplyCfdBodySdf(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_SolidDispatchSize)) return;
    uint3 id = (uint3)(_SolidDispatchMin + int3(tid));
    if (Oob(id)) return;
    float coverage = CfdBodyCoverageAt(float3(id) + 0.5);
    if (coverage > 1e-3) _Solid[id] = max(_Solid[id], coverage);
}

// Post-projection wall-velocity injection: covered cells are pulled toward the body's rigid surface velocity
// v = v_pivot + ω × r, so a spinning propeller PUSHES and swirls air instead of acting as a static blurred
// obstacle. Runs with inlet-style post-projection authority; next tick's advection transports the momentum and
// the projection folds it into a divergence-free field.
[numthreads(4, 4, 4)]
void ApplyCfdBodyMotion(uint3 tid : SV_DispatchThreadID)
{
    if (any(tid >= (uint3)_SolidDispatchSize)) return;
    uint3 id = (uint3)(_SolidDispatchMin + int3(tid));
    if (Oob(id)) return;
    float3 vp = float3(id) + 0.5;
    float coverage = CfdBodyCoverageAt(vp);
    if (coverage <= 1e-3) return;
    float3 wallVelocity = _CfdBodyLinVelVox + cross(_CfdBodyAngVelGrid, vp - _CfdBodyPivotVox);
    float wallSpeed = length(wallVelocity);
    if (wallSpeed > _MaxSpeed) wallVelocity *= _MaxSpeed / wallSpeed;   // blade tips can exceed the CFL guard
    float4 v = _Vel[id];
    v.xyz = lerp(v.xyz, wallVelocity, coverage);
    _Vel[id] = v;
}

[numthreads(4, 4, 4)]
void Project(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    if (IS_SOLID(c)) { _Vel[id] = float4(0, 0, 0, 0); return; }   // static obstacle: no motion inside
    float pc = _Pressure[id];
    float l = PressureAt(c - int3(1, 0, 0), pc);
    float r = PressureAt(c + int3(1, 0, 0), pc);
    float d = PressureAt(c - int3(0, 1, 0), pc);
    float u = PressureAt(c + int3(0, 1, 0), pc);
    float b = PressureAt(c - int3(0, 0, 1), pc);
    float f = PressureAt(c + int3(0, 0, 1), pc);
    float4 v = _Vel[id];
    v.x -= 0.5 * (r - l);
    v.y -= 0.5 * (u - d);
    v.z -= 0.5 * (f - b);
    // No penetration: kill any velocity component pointing into an adjacent solid.
    if (IS_SOLID(c + int3(1, 0, 0)) && v.x > 0.0) v.x = 0.0;
    if (IS_SOLID(c - int3(1, 0, 0)) && v.x < 0.0) v.x = 0.0;
    if (IS_SOLID(c + int3(0, 1, 0)) && v.y > 0.0) v.y = 0.0;
    if (IS_SOLID(c - int3(0, 1, 0)) && v.y < 0.0) v.y = 0.0;
    if (IS_SOLID(c + int3(0, 0, 1)) && v.z > 0.0) v.z = 0.0;
    if (IS_SOLID(c - int3(0, 0, 1)) && v.z < 0.0) v.z = 0.0;
    float3 vp = float3(id) + 0.5;
    // Directional Push (post-projection so it stays crisp): a source-local push along the emitter's forward axis,
    // shaped by the emission footprint. Aim it by ROTATING the emitter. Signed: + forward, − backward. This is the
    // single merged knob that replaced the old pre-projection Forward Force + the combustion-gated gas Axis jet.
    for (int i = 0; i < _EmitterCount; i++)
    {
        Emitter e = _Emitters[i];
        if (abs(e.motionForward) < 1e-5) continue;
        float contrib = EmitterContribution(e, vp, 1.0);
        if (contrib > 1e-5)
            v.xyz += SafeNorm(e.motionDir) * (e.motionForward * contrib * _Dt);
    }

    float sp = length(v.xyz);
    if (sp > _MaxSpeed) v.xyz *= _MaxSpeed / sp;
    _Vel[id] = v;
}

[numthreads(4, 4, 4)]
void ProjectCfd(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    float fluid = CfdFluidFractionAt(c);
    if (fluid <= 1e-3) { _Vel[id] = float4(0, 0, 0, 0); return; }

    float pc = _Pressure[id];
    int3 cl = c - int3(1, 0, 0), cr = c + int3(1, 0, 0);
    int3 cd = c - int3(0, 1, 0), cu = c + int3(0, 1, 0);
    int3 cb = c - int3(0, 0, 1), cf = c + int3(0, 0, 1);
    float fl = CfdFluidFractionAt(cl), fr = CfdFluidFractionAt(cr);
    float fd = CfdFluidFractionAt(cd), fu = CfdFluidFractionAt(cu);
    float fb = CfdFluidFractionAt(cb), ff = CfdFluidFractionAt(cf);
    float wl = min(fluid, fl), wr = min(fluid, fr);
    float wd = min(fluid, fd), wu = min(fluid, fu);
    float wb = min(fluid, fb), wf = min(fluid, ff);
    float l = CfdPressureAt(cl, pc, fl), r = CfdPressureAt(cr, pc, fr);
    float d = CfdPressureAt(cd, pc, fd), u = CfdPressureAt(cu, pc, fu);
    float b = CfdPressureAt(cb, pc, fb), f = CfdPressureAt(cf, pc, ff);
    float4 v = _Vel[id];
    v.x -= 0.5 * (wr * (r - pc) + wl * (pc - l));
    v.y -= 0.5 * (wu * (u - pc) + wd * (pc - d));
    v.z -= 0.5 * (wf * (f - pc) + wb * (pc - b));

    // Coverage rises toward the wall interior. Remove only velocity entering that gradient: a smooth free-slip,
    // no-penetration condition whose normal follows the SDF instead of the six voxel axes.
    float3 intoWall = float3(fl - fr, fd - fu, fb - ff);
    float normalLengthSq = dot(intoWall, intoWall);
    if (normalLengthSq > 1e-8)
    {
        intoWall *= rsqrt(normalLengthSq);
        float entering = dot(v.xyz, intoWall);
        if (entering > 0.0) v.xyz -= entering * intoWall;
    }

    float sp = length(v.xyz);
    if (sp > _MaxSpeed) v.xyz *= _MaxSpeed / sp;
    _Vel[id] = v;
}

[numthreads(4, 4, 4)]
void Decay(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    bool hasScalarSupport;
    if (!BaseVoxel(gid, gtid, id, hasScalarSupport)) return;
    // CFD fractional walls: only fully-covered interiors are scrubbed. The binary >0.5 test used to hard-zero
    // scalars in cut cells the CFD solve treats as up to 50% fluid — a one-voxel halo eating dye at every body
    // surface. Fire keeps the binary convention (its analytic obstacles have no fractional shell).
    if (_CfdFractionalSolids != 0)
    {
        if (CfdInteriorCoverage(int3(id)) >= 0.999) { _Fields[id] = 0.0; return; }
    }
    else if (IS_SOLID(int3(id))) { _Fields[id] = 0.0; return; }   // smoke can't occupy an obstacle
    float4 f = _Fields[id];
    float dens = f.x, temp = f.y, fuel = f.z, burn = f.w;

    float ignition = IgnitionResponse(temp);
    float combust = min(fuel, ignition * fuel * COMBUST_RATE * _Dt);

    // Multiplicative decay (proportional e-fold) then SUBTRACTIVE erosion: the constant per-second subtraction clears
    // thin/diffused haze to zero quickly while dense cores barely notice — smoke fades into wisps, not a uniform blob.
    dens = max(0.0, (dens + combust * COMBUST_DENS) * exp(-DECAY_DENSITY * _SmokeDecayMul * _Dt) - _SmokeErode * _Dt);
    temp = max(0.0, (temp + combust * COMBUST_TEMP) * exp(-DECAY_TEMP * _FireDecayMul * _Dt));
    fuel = max(0.0, (fuel - combust)               * exp(-DECAY_FUEL * _FireDecayMul * _Dt));
    burn = max(0.0, (burn + combust * COMBUST_BURN) * exp(-DECAY_BURN * _FireDecayMul * _Dt));

    // FLOAT16 STALL GUARD — the "static smoke remnants frozen in space" bug. The fields are stored half:
    // once the per-step decay decrement falls below half an ulp of the stored value (~0.05% relative —
    // long Smoke Life × high sim rate, worse with Wisp Fade at 0 since erosion is what usually breaks the
    // tie), the store ROUNDS BACK to the exact same value and the tail freezes at a visible density
    // forever. Guard: whenever the math above says a channel went DOWN, clamp to at least the largest
    // representable half strictly below the old value — one guaranteed step of progress per step, the
    // minimum possible deviation from the intended math. Channels that grew (combustion) or were meant to
    // hold exactly (authored never-die smoke: decay factor == 1) are untouched.
    float4 fld = float4(dens, temp, fuel, burn);
    if (fld.x < f.x) fld.x = min(fld.x, HalfBelow(f.x));
    if (fld.y < f.y) fld.y = min(fld.y, HalfBelow(f.y));
    if (fld.z < f.z) fld.z = min(fld.z, HalfBelow(f.z));
    if (fld.w < f.w) fld.w = min(fld.w, HalfBelow(f.w));

    // Hard floor: snap only the truly negligible asymptotic tail to EXACT zero (pure exp() decay never reaches 0).
    // Uses a tiny FIXED floor (DECAY_FLOOR), NOT _OccThreshold — the cull threshold (0.01) was high enough that a
    // slowly RISING / animated emission got floored to 0 every frame and could never accumulate (it snapped in at a
    // threshold instead of fading in). Fresh bricks can't be activated by sub-cull residue anyway (MarkOcc gates on
    // _OccThreshold), so the original anti-residue behaviour is preserved while ramps now fade in smoothly.
    fld *= step(DECAY_FLOOR, fld);   // per-channel: 0 only below the tiny floor, unchanged above

    // A motion-only emitter must keep its brick in the velocity solve, but it must not pin invisible scalar residue
    // there forever by preventing brick retirement. `hasScalarSupport` is the one-brick-dilated union of visible
    // field content and actively-emitting scalar sources. When false, ordinary sparse retirement would have cleared
    // all four scalar channels; do that here while leaving velocity/pressure alive for the air mover. BuildRenderField
    // still supplies its existing short visual history tail, so this has the same fade quality as a retired brick.
    if (!hasScalarSupport) fld = 0.0;
    _Fields[id] = fld;
}

// ── Render Detail — fine-field addressing (shared by DetailBake) ─────────────────────────────────────────────
// The fine field carries transported density/burn (R/G) at up to 4× base res. FineBaseVp/Uvw map a fine voxel back
// to base sample space (resolution-agnostic). Visual-only: it never writes _Fields / pressure / occupancy / combustion.

// Fine-voxel centre → base-voxel-space position (vp) and base uvw.
float3 FineBaseVp(uint3 fineId)  { return (float3(fineId) + 0.5) * (float3(_Res) / float3(_FineRes)); }
float3 FineBaseUvw(float3 vp)    { return vp / float3(_Res); }

// ── Render Detail transport — real fine field, no procedural value modulation ────────────────────────────────
// (BSplineFields — the 8-tap approximating cubic B-spline shared with the fine field below — is defined above
// BuildRenderField. Here it is the coarse low-frequency reference that the fine history is anchored to.)

float2 FineBaseScalar(float3 uvw)
{
    float4 smooth = BSplineFields(saturate(uvw));
    return max(float2(smooth.x, smooth.w), float2(0.0, 0.0));
}

float FineContent(float2 v)
{
    return max(v.x, v.y);
}

void FineSeedCore(uint3 id)
{
    float3 vp = FineBaseVp(id);
    int3 c = ClampC((int3)floor(vp));
    if (IS_SOLID(c)) { _FineOut[id] = float2(0.0, 0.0); return; }

    float3 uvw = FineBaseUvw(vp);
    _FineOut[id] = FineBaseScalar(uvw);
}

void DetailBakeCore(uint3 id)
{
    float3 vp = FineBaseVp(id);
    int3 c = ClampC((int3)floor(vp));
    if (IS_SOLID(c)) { _FineOut[id] = float2(0.0, 0.0); return; }

    float3 uvw = FineBaseUvw(vp);
    float2 baseNow = FineBaseScalar(uvw);

    float3 vel = _VelIn.SampleLevel(sampler_linear_clamp, uvw, 0).xyz;   // voxels / second
    float3 invBaseRes = 1.0 / max(float3(_Res), float3(1.0, 1.0, 1.0));
    float3 prevUvw = saturate(uvw - vel * (max(_DBSpeed, 0.0) * _Dt) * invBaseRes);

    float2 advected = max(_FineIn.SampleLevel(sampler_linear_clamp, prevUvw, 0).rg, float2(0.0, 0.0));
    float2 basePrevAtSource = FineBaseScalar(prevUvw);

    // Preserve only the transported high-frequency residual. The low band is always the current coarse render field,
    // which prevents the fine layer from becoming a detached cardboard shell while still letting advection stretch
    // real sub-voxel structure over time.
    float persist = saturate(_DBPersist);
    float residualDecay = exp(-lerp(10.0, 2.0, persist) * max(_Dt, 0.0));
    float2 high = (advected - basePrevAtSource) * residualDecay;
    float carryGate = saturate((FineContent(baseNow) + FineContent(basePrevAtSource)) * 64.0);
    high *= carryGate;
    float2 carried = max(baseNow + high, 0.0);

    float anchor = saturate(max(_DBAnchor, 0.0) * max(_Dt, 0.0));
    float2 anchored = lerp(carried, baseNow, anchor);

    // Amount is now honest: 0 = de-voxeled coarse field, 1 = transported fine field. It no longer means "add more
    // value-noise blotches into density/burn".
    float2 outv = lerp(baseNow, anchored, saturate(_DBAmount));
    if (FineContent(baseNow) <= 1e-6 && FineContent(advected) <= 1e-6) outv = float2(0.0, 0.0);
    _FineOut[id] = max(outv, float2(0.0, 0.0));
}

// Up to 4× base resolution — the fine field the renderer crossfades in 1 tap. One group (8³ threads) per active
// brick. A brick is BRICK (=4) base voxels, so its fine block is BRICK*_FineScale per axis: exactly 8³ at 2× (one
// tile), 16³ at 4× (a 2×2×2 sweep of 8³ tiles). _FineScale is even so BRICK*scale is always a multiple of 8.
[numthreads(8, 8, 8)]
void FineSeed(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = ActiveBrickIndex(_ActiveBricks[gid.x]);
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint F = (uint)max(_FineScale, 2);
    uint3 origin = brick * (BRICK_U * F);
    uint tiles = F / 2u;   // 8³ tiles per brick axis: 1 at 2×, 2 at 4×
    [unroll] for (uint tz = 0u; tz < 2u; tz++) { if (tz >= tiles) break;
    [unroll] for (uint ty = 0u; ty < 2u; ty++) { if (ty >= tiles) break;
    [unroll] for (uint tx = 0u; tx < 2u; tx++) { if (tx >= tiles) break;
        uint3 id = origin + uint3(tx, ty, tz) * 8u + gtid;
        if (all(id < (uint3)_FineRes)) FineSeedCore(id);
    }}}
}

[numthreads(8, 8, 8)]
void DetailBake(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = ActiveBrickIndex(_ActiveBricks[gid.x]);
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint F = (uint)max(_FineScale, 2);
    uint3 origin = brick * (BRICK_U * F);
    uint tiles = F / 2u;   // 8³ tiles per brick axis: 1 at 2×, 2 at 4×
    [unroll] for (uint tz = 0u; tz < 2u; tz++) { if (tz >= tiles) break;
    [unroll] for (uint ty = 0u; ty < 2u; ty++) { if (ty >= tiles) break;
    [unroll] for (uint tx = 0u; tx < 2u; tx++) { if (tx >= tiles) break;
        uint3 id = origin + uint3(tx, ty, tz) * 8u + gtid;
        if (all(id < (uint3)_FineRes)) DetailBakeCore(id);
    }}}
}

// ── Legacy flow map (kept for public API/backward compatibility) ─────────────────────────────────────────────
// The live transported Render Detail path no longer samples this. External callers can still step it explicitly.
float _FlowDt;       // this step's velocity weight (dt × flow gain)
float _FlowDecay;    // <1 → bounds the accumulated displacement (sets the advection's memory length)

// INDIRECT over active bricks (was a dense res³ RMW — ~268 MB/step at 256³, ~90% of it churning stale
// velocity residue outside the plume into a flow nothing consumes there: BakeWarp only reads the flow
// where visible content exists, i.e. inside active bricks). Retired bricks are zeroed by ClearRetiredFlow.
[numthreads(BRICK, BRICK, BRICK)]
void AdvectFlow(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    float3 vel = _Vel[id].xyz;                                     // voxels/sec
    float3 disp = (_FlowField[id].xyz + vel * (_FlowDt / float3(_Res))) * _FlowDecay;   // accumulate (in uvw) + decay
    _FlowField[id] = float4(disp, 0.0);
}

// Zero the flow in bricks that just left the active set. Keeps the invariant "flow == 0 outside the active
// set" (true from the alloc clear onward). The old dense pass instead kept decaying residue there by ×decay
// per step — a value nothing reads until the brick reactivates, at which point it is ~0 anyway.
[numthreads(BRICK, BRICK, BRICK)]
void ClearRetiredFlow(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = _RetiredBricks[gid.x];
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint3 id = brick * BRICK_U + gtid;
    if (Oob(id)) return;
    _FlowField[id] = (float4)0.0;
}

// Cache playback (DetailFlow clips): approximate the live vorticity from the scattered flow anchor so
// BakeWarp's Edge/Flow-Coherence/grain-curl modulation keeps working without simulation velocity in the
// file. The flow map is time-integrated velocity (AdvectFlow: +vel·flowDt/res per step, ×decay), whose
// steady state is vel·flowDt/(1−decay) in uvw — so curl(flow·res)·(1−decay)/flowDt ≈ curl(vel), the same
// quantity the live Curl kernel feeds BakeWarp. The gain is set CPU-side from the clip's bake fps.
// Transients lag the steady-state assumption, but the consumer is a saturated visual modulator, not physics.
// INDIRECT over this frame's active bricks — the only voxels BakeWarp reads curl at.
float _FlowCurlGain;
[numthreads(BRICK, BRICK, BRICK)]
void FlowCurl(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint3 id;
    if (!BaseVoxel(gid, gtid, id)) return;
    int3 c = int3(id);
    float3 r = float3(_Res);
    float3 vpx = _FlowField[ClampC(c + int3(1, 0, 0))].xyz * r, vmx = _FlowField[ClampC(c - int3(1, 0, 0))].xyz * r;
    float3 vpy = _FlowField[ClampC(c + int3(0, 1, 0))].xyz * r, vmy = _FlowField[ClampC(c - int3(0, 1, 0))].xyz * r;
    float3 vpz = _FlowField[ClampC(c + int3(0, 0, 1))].xyz * r, vmz = _FlowField[ClampC(c - int3(0, 0, 1))].xyz * r;
    float3 w;
    w.x = (vpy.z - vmy.z) - (vpz.y - vmz.y);
    w.y = (vpz.x - vmz.x) - (vpx.z - vmx.z);
    w.z = (vpx.y - vmx.y) - (vpy.x - vmy.x);
    _Curl[id] = float4(w * _FlowCurlGain, 0.0);
}

// ── Render-detail warp bake ──────────────────────────────────────────────────────────────────────────
// The old Render Detail module was a domain warp over the real render field, not a second density/burn
// field. Bake that warp once per sim tick so the slice shader spends one trilinear lookup to bend the
// existing fire/smoke instead of raymarching a visible high-res scalar voxel layer.
#define WARP_ENCODE 0.35
RWTexture3D<float4> _WarpField;
int3 _WarpRes;
Texture3D<float4> _FieldsLow;
Texture3D<float4> _FlowSrc;
Texture3D<float4> _CurlSrc;
float _DetailBoost;
float _DetailScale;
float _DetailTime;
float _DetailStretch;
float _DetailRough;
float _DetailFine;
float _DetailGrainCurl;
float _DetailContrast;
float _DetailBillow;
float _DetailEdge;
float _DetailCurl;
float _WarpTemporalBlend;

void StoreWarp(uint3 id, float3 encoded)
{
    float blend = saturate(_WarpTemporalBlend);
    [branch] if (blend < 0.999)
        encoded = lerp(_WarpField[id].xyz, encoded, blend);
    _WarpField[id] = float4(encoded, 0.0);
}

float WarpHash(float3 p)
{
    p = frac(p * 0.3183099 + 0.1);
    p *= 17.0;
    return frac(p.x * p.y * p.z * (p.x + p.y + p.z));
}

float WarpVNoise(float3 x)
{
    float3 i = floor(x);
    float3 f = frac(x);
    f = f * f * (3.0 - 2.0 * f);
    return lerp(lerp(lerp(WarpHash(i + float3(0,0,0)), WarpHash(i + float3(1,0,0)), f.x),
                     lerp(WarpHash(i + float3(0,1,0)), WarpHash(i + float3(1,1,0)), f.x), f.y),
                lerp(lerp(WarpHash(i + float3(0,0,1)), WarpHash(i + float3(1,0,1)), f.x),
                     lerp(WarpHash(i + float3(0,1,1)), WarpHash(i + float3(1,1,1)), f.x), f.y), f.z);
}

float WarpBase(float3 p) { return (WarpVNoise(p) - 0.5) * (0.62 * 2.1); }

float WarpGrain(float3 p)
{
    float s = (WarpVNoise(p * 2.03 + 11.7) - 0.5) * 0.31
            + (WarpVNoise(p * 4.07 + 23.1) - 0.5) * (0.16 * _DetailRough);
    return s * 2.1;
}

void BakeWarpCore(uint3 id)
{
    float3 uvw = (float3(id) + 0.5) / float3(_WarpRes);
    // No _OccD test needed: this only runs for warp voxels of ACTIVE bricks (the brick-indirect entry below).
    // Empty space holds the neutral encode from the alloc clear + the retired-brick fill.

    float4 fld = _FieldsLow.SampleLevel(sampler_linear_clamp, uvw, 0);
    float content = max(max(fld.x, fld.y * 0.35), fld.w * 0.5);
    float warpMask = smoothstep(0.002, 0.04, content);
    if (warpMask <= 1e-4)
    {
        StoreWarp(id, float3(0.5, 0.5, 0.5));
        return;
    }

    float3 disp = _FlowSrc.SampleLevel(sampler_linear_clamp, uvw, 0).xyz;
    float3 curlVec = _CurlSrc.SampleLevel(sampler_linear_clamp, uvw, 0).xyz;
    float vort = saturate(length(curlVec) * 0.5 + 0.15);
    float energy = 1.0 + max(0.0, _DetailEdge - 1.0) * vort;
    float3 q = (uvw - disp) * _DetailScale + _DetailTime;

    [branch] if (_DetailStretch > 1e-3)
    {
        float speed = length(disp);
        float3 dir = disp / (speed + 1e-4);
        float stretch = _DetailStretch * saturate(speed * 8.0);
        float along = dot(q, dir);
        q = (q - dir * along) + dir * (along / (1.0 + stretch));
    }

    float3 warp = float3(WarpBase(q), WarpBase(q + 19.3), WarpBase(q + 47.7));

    [branch] if (_DetailFine > 1e-3)
    {
        float3 grain = float3(WarpGrain(q), WarpGrain(q + 19.3), WarpGrain(q + 47.7)) * _DetailFine;
        [branch] if (_DetailGrainCurl > 1e-3)
        {
            float3 gaxis = curlVec / (length(curlVec) + 1e-4);
            grain = lerp(grain, cross(gaxis, grain), _DetailGrainCurl);
        }
        warp += grain;
    }

    [branch] if (_DetailContrast > 1.001)
        warp = sign(warp) * pow(abs(warp), _DetailContrast);

    [branch] if (_DetailBillow > 1e-3)
    {
        float3 bq = (uvw - disp) * (_DetailScale * 0.4) + _DetailTime * 0.5;
        float3 billow = float3(WarpVNoise(bq), WarpVNoise(bq + 7.1), WarpVNoise(bq + 31.7)) - 0.5;
        warp += billow * (2.0 * _DetailBillow);
    }

    [branch] if (_DetailCurl > 1e-3)
    {
        float3 axis = curlVec / (length(curlVec) + 1e-4);
        warp = lerp(warp, cross(axis, warp), _DetailCurl);
    }

    float3 disp2 = warp * (_DetailBoost * energy * 0.05 * warpMask);
    StoreWarp(id, saturate(disp2 / (2.0 * WARP_ENCODE) + 0.5));
}

// One group per ACTIVE brick (was dense over the whole (res·mul)³ warp grid — ~1 GB of writes per step at
// 256³·mul2, ~90% re-writing the neutral encode into empty space). A brick's warp block is BRICK·mul per
// axis: 4 at mul 1 (only the low 4³ lanes work), 8 at mul 2 (one tile), 16 at mul 4 (2×2×2 tile sweep).
int _WarpMul;
[numthreads(8, 8, 8)]
void BakeWarp(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = ActiveBrickIndex(_ActiveBricks[gid.x]);
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint edge = BRICK_U * (uint)max(_WarpMul, 1);
    uint3 origin = brick * edge;
    uint tiles = max((edge + 7u) / 8u, 1u);
    [unroll] for (uint tz = 0u; tz < 2u; tz++) { if (tz >= tiles) break;
    [unroll] for (uint ty = 0u; ty < 2u; ty++) { if (ty >= tiles) break;
    [unroll] for (uint tx = 0u; tx < 2u; tx++) { if (tx >= tiles) break;
        uint3 local = uint3(tx, ty, tz) * 8u + gtid;
        uint3 id = origin + local;
        if (all(local < edge) && all(id < (uint3)_WarpRes))
            BakeWarpCore(id);
    }}}
}

// Neutral-fill the warp block of bricks that just left the active set, so the renderer (whose renderOcc
// tails can extend slightly past _OccD) always samples the identical neutral encode the dense pass wrote.
[numthreads(8, 8, 8)]
void ClearRetiredWarpBricks(uint3 gid : SV_GroupID, uint3 gtid : SV_GroupThreadID)
{
    uint packed = _RetiredBricks[gid.x];
    uint ox = (uint)_OccRes.x, oy = (uint)_OccRes.y;
    uint3 brick = uint3(packed % ox, (packed / ox) % oy, packed / (ox * oy));
    uint edge = BRICK_U * (uint)max(_WarpMul, 1);
    uint3 origin = brick * edge;
    uint tiles = max((edge + 7u) / 8u, 1u);
    [unroll] for (uint tz = 0u; tz < 2u; tz++) { if (tz >= tiles) break;
    [unroll] for (uint ty = 0u; ty < 2u; ty++) { if (ty >= tiles) break;
    [unroll] for (uint tx = 0u; tx < 2u; tx++) { if (tx >= tiles) break;
        uint3 local = uint3(tx, ty, tz) * 8u + gtid;
        uint3 id = origin + local;
        if (all(local < edge) && all(id < (uint3)_WarpRes))
            _WarpField[id] = float4(0.5, 0.5, 0.5, 0.0);
    }}}
}

// Dense one-shot neutral fill at (re)allocation — the indirect bake never visits empty space, so the fresh
// texture must start at the neutral encode everywhere (the dense pass used to rewrite it every frame).
[numthreads(4, 4, 4)]
void ClearWarpNeutral(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_WarpRes)) return;
    _WarpField[id] = float4(0.5, 0.5, 0.5, 0.0);
}

// Single-scatter transmittance toward the key light (three-js-volume `lightKernel`). One thread per active-brick
// voxel (indirect, same set as Decay). Marches the post-decay base density toward the light and writes
// illum = exp(-tau · SHADOW_DENSITY_REF · stepLen · shadowStrength). Smoke density scale does NOT affect the
// shadow (the earlier prototype uses a fixed SHADOW_DENSITY_REF) — only shadowStrength deepens it.
// Light bakes run DENSE over the (coarse) _LightRes grid — lighting is diffuse/low-frequency, so it's cheaper
// and smaller at half res, and the renderer reads it trilinearly. The light MARCH still uses base-res (_Res)
// world-step semantics, so only the STORED resolution drops; shadow geometry is unchanged.
[numthreads(4, 4, 4)]
void Illumination(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_LightRes)) return;
    float3 invN = 1.0 / float3(_Res);                          // base-res world-step (light grid may be coarser)
    float3 startUvw = (float3(id) + 0.5) / float3(_LightRes);  // this light voxel's normalized position

    // Skip light voxels the renderer never samples: outside the DILATED smoke halo (occD) there is no fume to
    // shade, so the whole shadow march is wasted. Write 1 (unshadowed) — the render's occupancy cull means this
    // value is never read, and the ±1 scatter blur stays inside the halo. Quality-neutral, skips the empty box.
    uint3 occId = min((uint3)(startUvw * float3(_OccRes)), (uint3)_OccRes - 1);
    if (_OccD[occId] < 0.5) { _IllumField[id] = 1.0; return; }

    // Direction object→voxel space (normalized object dir scaled by the grid resolution) so it tracks the
    // container transform. Object-space step length keeps the same scale as the raymarch.
    float3 ldir = _LbLightDir * float3(_Res);
    ldir = (dot(ldir, ldir) > 1e-12) ? normalize(ldir) : float3(0.0, 1.0, 0.0);
    float stepObj = _LbLightStepVox * length(ldir * invN);
    float atten = stepObj * SHADOW_DENSITY_REF * _LbShadowDensity;   // ltau → optical depth
    // Per-voxel march-start dither (R3 low-discrepancy hash). A FIXED start phase quantizes the shadow
    // into transmittance shells ~stepVox apart along the light direction — parallel banding stripes on
    // large containers where the world step is big. Dithering the start de-correlates neighbouring light
    // voxels; the scatter blur + the renderer's trilinear/quintic then read the shells as smooth.
    float jphase = frac(dot(float3(id), float3(0.7548776662, 0.5698402910, 0.3667458606)));
    float ltau = 0.0;
    [loop]
    for (int j = 1; j <= _LbLightSteps; j++)
    {
        float3 sp = startUvw + ldir * (_LbLightStepVox * ((float)j - jphase)) * invN;
        // Quality-neutral early-outs: once the light ray leaves the box there is no more smoke to cast shadow,
        // and once optical depth is deep the voxel is already black — remaining steps can't change the result.
        if (any(sp < 0.0) || any(sp > 1.0)) break;
        ltau += LbDensity(sp);   // remapped/bounded density — consistent with the camera's opacity
        if (ltau * atten > 6.0) break;   // transmittance < 0.0025 → fully shadowed
    }
    _IllumField[id] = exp(-ltau * atten);
}

// Multiple scattering — seed: radiance starts at the single-scatter transmittance (reference scatterSeed).
[numthreads(4, 4, 4)]
void ScatterSeed(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_LightRes)) return;
    // Outside the smoke halo there is no scattering medium → 0 radiance (NOT the illum=1 the shadow skip wrote),
    // so the diffusion blur can't bleed false light into the fringe. Matches the Illumination occD skip.
    uint3 occId = min((uint3)(((float3(id) + 0.5) / float3(_LightRes)) * float3(_OccRes)), (uint3)_OccRes - 1);
    _ScatterField[id] = (_OccD[occId] < 0.5) ? 0.0 : _IllumField[id];
}

// Fire-as-a-light — seed: the radiance field starts at the local fire EMISSION (burn channel), so the
// subsequent diffusion blur spreads that light into the surrounding smoke with density absorption — giving
// the warm, occluded, distance-falloff under-lighting of smoke ABOVE/AROUND the flames. (_ScatterField is
// bound to the fireLight target here; the same ScatterBlur passes then diffuse it.)
[numthreads(4, 4, 4)]
void FireLightSeed(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_LightRes)) return;
    float4 f = _FieldsIn.SampleLevel(sampler_linear_clamp, (float3(id) + 0.5) / float3(_LightRes), 0);
    // Emission seed = burn (combustion emission signal), lightly gated by ignition temperature so cool
    // leftover burn doesn't glow. Bounded so a hot core doesn't blow the diffusion out of range.
    float ignite = IgnitionResponse(f.y);
    _ScatterField[id] = saturate(max(f.w, 0.0)) * (0.4 + 0.6 * ignite);
}

// Multiple scattering — diffuse: 7-tap box blur of the radiance with mild density absorption, so scattered
// light fills shadowed cores with a soft glow (reference blurField, ping-pong src→dst). Two passes land the
// result back in _ScatterField.
[numthreads(4, 4, 4)]
void ScatterBlur(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_LightRes)) return;
    // Far-empty voxels (outside the halo) carry no radiance and are never rendered — hold them at 0 so the blur
    // neither wastes work spreading nothing nor bleeds into the fringe. In-halo empties (near smoke) still diffuse.
    uint3 occId = min((uint3)(((float3(id) + 0.5) / float3(_LightRes)) * float3(_OccRes)), (uint3)_OccRes - 1);
    if (_OccD[occId] < 0.5) { _ScatterField[id] = 0.0; return; }
    int3 c = int3(id);
    int3 hi = (int3)_LightRes - 1;                          // clamp neighbours to the light grid (not _Res)
    float s0 = _ScatterSrc.Load(int4(c, 0));
    float sum =
        _ScatterSrc.Load(int4(clamp(c + int3(1, 0, 0), int3(0, 0, 0), hi), 0)) + _ScatterSrc.Load(int4(clamp(c - int3(1, 0, 0), int3(0, 0, 0), hi), 0)) +
        _ScatterSrc.Load(int4(clamp(c + int3(0, 1, 0), int3(0, 0, 0), hi), 0)) + _ScatterSrc.Load(int4(clamp(c - int3(0, 1, 0), int3(0, 0, 0), hi), 0)) +
        _ScatterSrc.Load(int4(clamp(c + int3(0, 0, 1), int3(0, 0, 0), hi), 0)) + _ScatterSrc.Load(int4(clamp(c - int3(0, 0, 1), int3(0, 0, 0), hi), 0));
    float avg = (s0 + sum) / 7.0;
    float dens = LbDensity((float3(id) + 0.5) / float3(_LightRes));   // remapped/bounded — radiance penetrates
    float atten = saturate(1.0 - dens * SCATTER_ABSORB);
    _ScatterField[id] = max(0.0, avg * atten);
}

// Pack the three baked scalar light fields into one RGBA volume (r=illum, g=scatter, b=fire-light) so the
// renderer reads all three lighting terms in a SINGLE texture tap per step instead of three.
[numthreads(4, 4, 4)]
void PackLight(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_LightRes)) return;
    _LightPacked[id] = float4(_PackIllum[id], _PackScatter[id], _PackFireLight[id], 0.0);
}

// Zero a scalar field once at init (illum/scatter) — sparse dispatch never visits empty bricks, so unvisited
// cells must start clean (mirrors ClearField for the base float4 fields).
[numthreads(4, 4, 4)]
void ClearScalar(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    _ClearScalar[id] = 0.0;
}

// RG clear for the fine up-res field (density in R, burn in G). Dispatched over the fine resolution.
[numthreads(4, 4, 4)]
void ClearScalar2(uint3 id : SV_DispatchThreadID)
{
    if (Oob(id)) return;
    _ClearScalar2[id] = float2(0.0, 0.0);
}

[numthreads(4, 4, 4)]
void ClearLightScalar(uint3 id : SV_DispatchThreadID)
{
    if (any(id >= (uint3)_LightRes)) return;
    _ClearLightScalar[id] = 0.0;
}
