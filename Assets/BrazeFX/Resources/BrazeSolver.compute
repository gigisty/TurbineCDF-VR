int3  _Res;
int3  _LightRes;       // light-bake grid resolution (≤ _Res): lighting is diffuse/low-freq, so it bakes coarse
float _Dt;
float _Time;
float _MaxSpeed;
float _ResolutionScale;  // current grid / authored physics-reference grid (world-space look preservation)
float _VelDissipation;
float _SmokeDecayMul;  // 1/SmokeLife (seconds) — with DECAY_DENSITY=1, smoke e-folds in exactly SmokeLife seconds
float _FireDecayMul;   // 1/FireLife  (seconds) — flame (burn) e-folds in FireLife s; heat ×1.5, fuel ×3 (see DECAY_*)
float _SmokeErode;     // SUBTRACTIVE density erosion (per second). Trims thin/diffused haze faster than dense cores,
                       // so smoke fades by breaking into wisps instead of dimming as a uniform "wool" blob.
float _Drag;           // emitter drag → whole-plume velocity settle (1/sec). Bleeds momentum back toward rest.
// Container-wide DYNAMICS (global fluid forces) — the proven "magic" layer, applied everywhere there's smoke.
float _ConfineScale;   // vorticity confinement (the container Swirl knob) — amplifies the fluid's own vortices
float _Turbulence;     // global curl-noise strength (fine octave)
float _TurbScale;      // global curl-noise spatial frequency (fine octave)
float _AmbientLife;    // anti-stasis: gentle LARGE-scale slow curl drift so smoke never freezes into a static "wool" blob
float _BillowStrength; // global large-scale curl-noise → big rolling billows (independent of the fine octave)
float _BillowScale;    // global large-scale curl-noise frequency (LOWER = bigger rolls)
float _Instability;        // baroclinic buoyancy perturbation strength — spatially lumps the lift (Rayleigh–Taylor seed)
float _InstabScale;        // instability noise frequency (LOWER = bigger mushroom lobes)
float _InterfaceTurb;      // edge turbulence strength — curl noise gated by the density gradient (cauliflower florets)
float _InterfaceTurbScale; // edge turbulence frequency (HIGHER = finer florets)
float _CfdInletTurbulence;      // RMS fraction of mean inlet speed
float _CfdTurbulenceLengthVox;  // dominant synthetic-inlet eddy size in voxels
float _CfdTurbulenceFrequency;  // temporal turnover frequency in cycles/second
float _CfdRenderSpeedInvReference; // >0 packs normalized solved speed into the CFD render field's unused B channel
float2 _CfdContactDye;          // Body Contact dye: x = release concentration (0 disables), y = 1/inlet speed (vox)
// Render Detail — fine field resolution (base res × fineScale ∈ {1,2,4}); FineSeed/DetailBake write at this res.
int3  _FineRes;
int   _FineScale;    // up-res factor (2 or 4): base-brick → BRICK*_FineScale fine cube per active brick

// ── Render Detail transport (FineSeed + DetailBake) ──────────────────────────────────────────────────────────
// Render-only fine density/burn field. It is seeded from the current coarse render field, transported by the coarse
// velocity at fine resolution, then low-frequency anchored back to the current coarse field so it does not drift.
// These legacy knobs remain serialized; the current transport path only uses Amount, Speed, and Persistence.
float _DBWarpFreq;   // legacy serialized detail-noise knob; unused by transported fine field
float _DBScaleWt;    // legacy serialized detail-noise knob; unused by transported fine field
float _DBFlow;       // legacy serialized detail-noise knob; unused by transported fine field
float _DBSpeed;      // velocity multiplier for fine-field backtrace
float _DBMotion;     // legacy serialized detail-noise knob; unused by transported fine field
float _DBPersist;    // residual persistence for transported fine detail
float _DBSharp;      // legacy serialized detail-noise knob; unused by transported fine field
float _DBQuality;    // legacy serialized detail-noise knob; unused by transported fine field
float _DBVirtualMul; // legacy serialized detail-noise knob; unused by transported fine field
float _DBTime;       // legacy serialized detail-noise knob; unused by transported fine field
float _DBAmount;     // Amount — folded into the bake so the raymarch samples the FINAL field (no per-sample crossfade)
float _DBAnchor;     // low-frequency correction rate back to the current coarse field (per second)
float _DBCrisp;      // legacy serialized detail-noise knob; unused by transported fine field
float _DBGrainFreqFine;    // grain octave freq for Grain Size MIN (fine, high freq)
float _DBGrainFreqCoarse;  // grain octave freq for Grain Size MAX (coarse, low freq)
float _OccThreshold;   // brick occupancy cull: field-sum below this = invisible trace, skip the solve there
int _CfdThermalOccupancy; // opt-in: temperature alone carries airflow/thermal state in a CFD domain
int _CfdFullDomainOccupancy; // a CFD domain may opt into a global solve (patch-driven or standing airflow policy)
int _CfdFractionalSolids;    // 1 = CFD fractional coverage is resident in _Solid: transport/decay/emission/vorticity
                             // switch to the fractional convention instead of Fire's binary >0.5 test
float _CfdThermalBuoyancy;   // CFD domain-wide buoyancy per heat unit (grid units). Unlike the per-emitter _Vel.w
                             // path this also lifts heat that entered through an inlet patch (no emitter attached).
float _CfdLinearDrag;        // CFD linear air damping (1/s) — resolution-independent, matches the authored tooltip.
                             // 0 for Fire, which keeps its quadratic vox-space emitter drag.
int   _AdvectionSweep; // live occupancy only: configured travel can exceed the ordinary one-brick halo
int   _ClosedFaces;    // pressure boundaries: 1/-X, 2/+X, 4/-Y, 8/+Y, 16/-Z, 32/+Z

// Combustion / decay (adapted from the publisher-owned three-js-volume prototype; per-second).
static const float COMBUST_RATE   = 1.65;
static const float COMBUST_DENS   = 0.1;
static const float COMBUST_TEMP   = 1.15;
static const float COMBUST_BURN   = 7.5;
// Decay constants are now CALIBRATED so the Life knobs read in LITERAL SECONDS (e-fold time). With
// _SmokeDecayMul = 1/SmokeLife and _FireDecayMul = 1/FireLife, the per-channel e-fold time is Life/DECAY_X:
//   density (smoke) → SmokeLife s exactly (anchor)
//   burn   (flame)  → FireLife  s exactly (anchor — this is the visible fire)
//   temp   (heat)   → 1.5 × FireLife  (heat outlives the flame so the plume keeps rising as it transitions to smoke)
//   fuel            → 3   × FireLife  (leftover fuel lingers a little, feeding tail flames; mostly consumed by combustion)
static const float DECAY_DENSITY  = 1.0;     // smoke e-fold = SmokeLife seconds
static const float DECAY_TEMP     = 0.6667;  // heat e-fold  = 1.5 × FireLife seconds
static const float DECAY_FUEL     = 0.3333;  // fuel e-fold  = 3.0 × FireLife seconds
static const float DECAY_BURN     = 1.0;     // flame e-fold = FireLife seconds
static const float IGNITE_HI      = 0.55;
// Hard-zero floor for the Decay pass — kills only the truly negligible, forever-asymptoting tail. DECOUPLED from
// the brick-cull threshold (_OccThreshold): coupling them snapped slowly-RISING emission to 0 every frame, so
// ramped/animated channels couldn't fade in (they popped at a threshold). This is far below any cull setting, so
// accumulation is smooth; visibility/perf is still governed by the brick cull in MarkOcc.
static const float DECAY_FLOOR    = 1e-4;
// Maps an emitter's motionRadial knob → divergence expansion. Radial push is injected as a divergence source
// (not a raw velocity) so the pressure projection can't cancel it — a raw radial velocity is almost entirely
// removed by the incompressibility solve. 120 (knob max) × this ≈ a strong outward burst.
static const float RADIAL_DIV_GAIN = 0.1;

float IgnitionResponse(float temp)
{
    // No dead-zone: output-strength ramps scale temperature and fuel, so a 0.12->0.55 smoothstep made fire-only
    // sources look dismissed until the middle of the ramp. Quadratic response keeps a soft cold toe without a pop.
    float t = saturate(max(temp, 0.0) / max(IGNITE_HI, 1e-5));
    return t * t;
}

float GasCombustionSource(float4 fld)
{
    float ignition = IgnitionResponse(fld.y);
    return ignition * max(fld.z, 0.0);
}

struct Emitter
{
    float3 posVox;        float radiusVox;
    float3 channels;      float shape;          // channels = density,temp,fuel; shape: 0 sphere, 1 box, 2 cylinder, 3 cone, 4 capsule, 5 torus
    float3 halfExtentVox; float motionBuoyancy;   // per-emitter buoyancy (signed: + rise, − sink)
    float3 motionDir;     float motionForward;   // Push direction + magnitude
    float motionRadial;   float gasPressureBurst; float gasSourceSpread; float gasSourceSharpness;
    float4 rot;                                  // emitter orientation in grid space (quaternion; identity = axis-aligned)
    float3 motionJet;     float sourceTurbulence; // inflow JET velocity (grid voxels/sec) + source-local jitter magnitude
    float3 sourceVelocity; float sourceVelocityBlend; // Pyro-style local-axis source velocity (grid voxels/sec) + exponential blend
    float3 sourceSwirlAxis; float sourceSwirlSpeed; // tangential target axis + signed speed at the source rim (grid voxels/sec)
    float sourceDyePattern; float sourceDyeStreakCount; float sourceDyeStreakWidth; float sourceDyePad;
};

struct ForceField
{
    float3 posVox;  float type;        // 0 wind, 1 vortex, 2 turbulence, 3 gravity, 4 attract, 5 disc, 6 hold, 7 cauli-billows, 8 lift, 9 jet, 10 spinner, 11 spline-vortex
    float3 dir;     float strength;    // disc Spread; vortex/spinner angular rate where applicable
    float  radiusVox; float thickness; float scale; float swirl;   // disc: half-height (Thickness) + swirl; spinner: swirl = Flatten rate (1/s)
    float  flatten;   float distort;   float roll;  float hold;     // disc: flatten + distort + roll + hold
    float  dome;      float power;     float seal;  float layers;   // disc: dome curve + master Power + top Seal + stack count
    float  layerSpacing; float taper; float2 _forcePad;             // disc: x core/y suction; cauli: x smoke deposit/y fire deposit; spinner: x Grip rate/y Containment rate (1/s)
    float  falloffInner; float falloffPower; float billowLines; float billowMode;   // falloff core/curve (generic field); cauli: striation amount + motion mode (+1 up / 0 in-place / -1 down)
    float  shape; float hole; float fieldHeight; float _shapePad;              // 0 sphere / 1 cylinder / 2 torus / 3 disc + central hole frac + cylinder/disc half-height (vox)
    float  billowStrength; float billowOrigin; float billowScale; float billowSpeed;   // Cauli Billows: raw strength / center↔rim emphasis / lobe size in voxels / turnover rate
    float  vortexMode; float vortexHold; float vortexOrbitR; float vortexLift;          // Vortex: 0 swirl/1 inward/2 orbit + hold response + orbit radius (vox) + axial lift (vox/s)
    float  vortexAxialDamp; float vortexLiftVar; float vortexGrip; float vortexBlades;  // Vortex: axial damp/lift variation (0..1) + grip rate (1/s) + blade count
};

struct Obstacle
{
    float3 posVox;        float radiusVox;
    float3 halfExtentVox; float shape;          // 0 sphere, 1 box, 2 cylinder, 3 cone, 4 capsule, 5 torus
    float4 rot;                                 // primitive orientation; local +Y is the axial direction
};

struct CfdBoundary
{
    float3 centerVox; float face;             // 0/-X, 1/+X, 2/-Y, 3/+Y, 4/-Z, 5/+Z
    float3 velocityVox; float mode;            // 0 velocity inlet, 1 pressure outlet
    float2 halfSizeVox; float gaugePressure; float inletTemperature;
    float cellVolumeWorld; float preventBackflow; float inletSmokeDensity; float inletSmokePattern;
    float shape; float ringInner; float rotation; float _boundaryPad;   // shape: 0 rect, 1 ellipse, 2 ring, 3 slot; rotation on the face (radians)
};

// Rotate v by quaternion q.
float3 QuatRot(float4 q, float3 v) { return v + 2.0 * cross(q.xyz, cross(q.xyz, v) + q.w * v); }

StructuredBuffer<Emitter>    _Emitters;
StructuredBuffer<ForceField> _Forces;
StructuredBuffer<float4>     _SplineVortexSamples;   // voxel xyz + lathed profile radius
StructuredBuffer<Obstacle>   _Obstacles;
StructuredBuffer<CfdBoundary> _CfdBoundaries;
RWStructuredBuffer<int> _CfdFluxTotals;       // [0] inlet, [1] outlet, volume m^3/s × 4096
RWStructuredBuffer<int> _CfdSurfaceLoad;      // xyz relative pressure load × 4096; w reserved
float3 _CfdCellFaceArea;                      // world-space yz/xz/xy cell-face areas
RWStructuredBuffer<uint> _CfdTemperaturePeak; // maximum presented fluid temperature above ambient × 4096
RWStructuredBuffer<int> _CfdRefPressure;      // [0] ambient pre-scaled sum ×256, [1] count, [2] surface max Cp ×1024, [3] smoothed attenuation ×1024
float _CfdPressureVisScale;                   // 1 / projection-space dynamic head → theoretical pre-scaled Cp
float _CfdPressureCalibrationBlend;           // temporal blend for measured attenuation (never forced to 1 on vis seed)
int _CfdBoundaryCount;

// Point-set emission (e.g. a surface-coverage mask). One DEDUPED cell per entry (CPU-side), so each thread
// writes a distinct cell — no atomics needed on the RWTexture3D fields.
// 16-byte aligned members. vel = grid-space (voxels/sec) source velocity; velBlend = how strongly the cell
// velocity is pulled toward it (0 = none). Used so smoke/fire emitted from MOVING sources (disintegrator clumps)
// inherits their motion instead of being born dead.
// buoyBlend = authority to set this cell's per-source buoyancy in _Vel.w (0 = leave .w untouched, e.g. static
// surface masks / disintegrator clumps); buoyancy = the coefficient itself (signed lift, like an emitter's Buoyancy).
struct PointSource { float3 posVox; float buoyBlend; float3 channels; float buoyancy; float3 vel; float velBlend; };
StructuredBuffer<PointSource> _PointSources;

// ── GPU surface-coverage emission (no CPU round-trip) ────────────────────────────────────────────
// A surface effect's covered vertices are tested + splatted into a per-cell accumulator entirely on
// the GPU: the vertex buffer is the LIVE (GPU-skinned) one, so emission tracks animation at full
// rate with zero CPU vertex work. Channels are accumulated in 24.10 fixed point (3 uints per cell)
// so overlapping effects with different channels sum correctly under atomics.
ByteAddressBuffer _SurfVerts;              // raw vertex buffer (skinned output or static mesh)
StructuredBuffer<int> _SurfWeldRep;        // welded id -> representative raw vertex index
StructuredBuffer<float> _SurfReach;        // welded id -> geodesic reach (+inf = uncovered)
RWStructuredBuffer<uint> _SurfAccum;       // cells*3 fixed-point channel sums (x,y,z interleaved)
int      _SurfWeldedCount;
int      _SurfStride;                      // vertex buffer stride in bytes
int      _SurfPosOffset;                   // position attribute byte offset within the stride
float    _SurfFront;                       // coverage front: covered when reach <= front
float    _SurfBandMin;                     // emit-front-only lower bound; < 0 = emit whole covered area
float3   _SurfChannels;                    // density/temperature/fuel per covered vertex
float4x4 _SurfLocalToWorld;                // renderer-local -> world (matches the skinned buffer's space)
float4x4 _WorldToVoxelM;                   // world -> fractional voxel coords
int      _SurfCellCount;                   // res.x*y*z (ClearSurfAccum bound)
#define SURF_FP 1024.0                     // fixed-point scale for channel accumulation

// ── GPU mesh-emitter fluid emission ──────────────────────────────────────────────────────────────
// Same idea as SurfSplat, plus VELOCITY + per-source BUOYANCY (the surface path carries neither). One
// thread per LIVE mesh vertex (BrazeDeformSource's world-space output — GPU-skinned, no readback): splat
// this emitter's channels + surface/birth velocity + buoyancy into a sparse per-cell hash, then MeshEmitFold
// averages per covered voxel and injects into the fields (parity with the removed CPU point path). This
// replaces the per-step CPU vertex walk + Dictionary dedup and avoids a resolution³ accumulator at large grids.
StructuredBuffer<float3> _MeshVerts;       // world-space vertex positions (BrazeDeformSource.Positions)
StructuredBuffer<float3> _MeshNormals;     // world-space unit normals (BrazeDeformSource.Normals) — normal-speed push
StructuredBuffer<float3> _MeshMaskRestLocal;// mesh-local rest positions for optional Surface Mask gating
RWStructuredBuffer<float3> _MeshPrevPos;   // per-vertex previous world position (velocity diff; owner: the emitter)
// 13 ints/slot: [cellKey, Σchannels.xyz, ΣsurfaceVel.xyz, ΣbirthTarget.xyz, Σbuoy, ΣbirthBlend, count]
RWStructuredBuffer<int> _MeshAccum;
int      _MeshVertCount;
int      _MeshMaskEnable;
float4x4 _MeshMaskRestLocalToField;
int      _MeshMaskUsePassIdx;
StructuredBuffer<uint> _MeshMaskPassIdx;
StructuredBuffer<uint> _MeshMaskPassCount;
RWStructuredBuffer<uint> _MeshMaskPassIdxRW;
RWStructuredBuffer<uint> _MeshMaskPassCountRW;
int      _MeshInputLocal;
float4x4 _MeshLocalToWorld;
float4x4 _MeshNormalLocalToWorld;
int      _MeshHasPrev;                     // 0 on first splat / realloc → zero velocity (no spike)
float3   _MeshChannels;                    // density/temperature/fuel × emissionScale (uniform per emitter)
float    _MeshBuoyancy;                    // per-emitter lift coefficient
float    _MeshNormalSpeed;                 // world m/s pushed out along the surface normal (0 = none)
float3   _MeshJetVelocity;                 // grid-space forward Jet target (voxels/sec)
float3   _MeshSourceVelocity;              // grid-space authored source-velocity target (voxels/sec)
float    _MeshSourceVelocityBlend;         // exponential target blend rate (1/sec)
float    _MeshSourceTurbulence;            // grid-space source jitter speed (voxels/sec)
float3   _MeshPushAccel;                   // grid-space Push acceleration (voxels/sec^2)
float    _MeshInvDt;                       // 1 / sim dt for the velocity diff
int      _MeshHashCapacity;                // power-of-two slot count
int      _MeshHashMask;                    // capacity - 1
// Velocity can include 300 m/s Jet converted to voxel units; 64 keeps dense masked cells away from int overflow
// while still preserving sub-voxel/sec precision after the per-cell average.
#define MESH_FP 64.0                       // fixed-point scale for velocity/buoyancy accumulation

// Voronoi fracture's live GPU simulation buffers. Position/state is world xyz + anchored/free in w; life.x is
// the current 0..1 fragment scale. FragmentSplat reads these directly, so fracture emission has no CPU snapshot.
StructuredBuffer<float4> _FragmentPosState;
StructuredBuffer<float4> _FragmentRotation;
StructuredBuffer<float4> _FragmentVelocity;
StructuredBuffer<float4> _FragmentAngularVelocity;
StructuredBuffer<float4> _FragmentLife;
StructuredBuffer<float4> _FragmentCentroidRadius;
StructuredBuffer<float4> _FragmentImpactFluidState;
StructuredBuffer<uint> _FragmentImpactFluidMotion;
StructuredBuffer<float4> _FragmentImpactFluidGeometry;
StructuredBuffer<float4> _FragmentImpactFluidVelocity;
int      _FragmentCount;
int      _FragmentEmitCount;
float    _FragmentVelocityInherit;
int      _FragmentImpactFilter;
float    _FragmentImpactBuoyancyScale;
int _PointCount;

int _EmitterCount;
int _ForceCount;
int _SplineVortexSampleCount;
int _SplineVortexForceStart;
int _SplineVortexForceCount;
